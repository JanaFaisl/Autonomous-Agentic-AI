# Secrets — never commit. The API key lives here locally; on Streamlit Cloud it
# is supplied through the app's Secrets panel instead.
.env
.env.*
!.env.example

# Virtual environment. Rebuilt from requirements.txt on every machine:
#   python3 -m venv venv && ./venv/bin/pip install -r requirements.txt
# It is ~760 MB of platform-specific binaries with absolute paths baked in,
# so it is neither portable nor useful to anyone else.
venv/
env/
ENV/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Evaluation scratch: node_modules and build output, regenerated by
# sbr_harness on every run. evaluation/runs/ is deliberately NOT ignored —
# those artifacts are the paper's raw data and belong in the repository.
evaluation/builds/

# Local database created at runtime
app.db

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Streamlit local config (may contain secrets)
.streamlit/secrets.toml
