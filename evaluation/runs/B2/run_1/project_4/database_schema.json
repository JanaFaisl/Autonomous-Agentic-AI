        {
          "name": "is_verified",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "false",
          "notes": "Email verification status"
        }
      ],
      "indexes": [
        "email",
        "university"
      ],
      "relationships": []
    },
    {
