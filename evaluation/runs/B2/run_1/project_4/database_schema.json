  ],
  "assumptions": [
    "University email verification is required for registration",
    "File uploads are stored in AWS S3 with URLs in database",
    "Group admins have additional permissions to manage members",
    "Rating scale is 1-5 stars",
    "One user can rate each note only once (enforced at application level or via unique constraint on note_id, user_id)",
    "Soft delete not implemented; hard deletes assumed",
    "All timestamps use UTC timezone",
    "group_members serves as a junction table for the many-to-many relationship between users and study_groups",
    "The created_by field in study_groups indicates the group creator who becomes the initial admin",
    "Role field in group_members distinguishes between admin and regular member privileges"
  ]
}