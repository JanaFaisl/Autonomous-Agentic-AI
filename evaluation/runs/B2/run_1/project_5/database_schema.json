  ],
  "assumptions": [
    "Single store location assumed; multi-location support can be added later",
    "Barcode scanner integration via standard USB or Bluetooth devices",
    "Real-time updates implemented using WebSocket connections",
    "User authentication required for all operations",
    "Price changes do not affect historical transaction records",
    "Inventory adjustments require manager or owner role permissions",
    "Alerts are generated automatically when inventory falls below minimum threshold",
    "Transaction history is maintained indefinitely for audit purposes",
    "Monetary values stored as bigint in cents to avoid floating point precision issues",
    "Each product has exactly one inventory record (one-to-one relationship)",
    "Transaction types are limited to: sale, restock, adjustment, return",
    "Alert types are limited to: low_stock, out_of_stock",
    "User roles are limited to: Store Owner, Store Manager, Store Clerk",
    "All timestamps use server timezone and are stored in UTC",
    "Soft deletes are not implemented; records are permanently deleted",
    "Barcode and SKU must be unique across all products"
  ]
}