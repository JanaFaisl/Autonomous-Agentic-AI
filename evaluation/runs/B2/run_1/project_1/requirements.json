{
  "project_name": "Flower Delivery App",
  "features": [
    {
      "id": "F1",
      "name": "Flower Catalog Browsing",
      "description": "Customers can browse available flowers with images, descriptions, and prices.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can browse flower categories so that I can find the type of flowers I want.",
        "As a customer, I can view detailed flower information so that I can make an informed purchase decision."
      ],
      "acceptance_criteria": [
        "Given I am on the catalog page, When I select a category, Then I see all flowers in that category.",
        "Given I click on a flower, When the detail page loads, Then I see image, price, description, and availability."
      ]
    },
    {
      "id": "F2",
      "name": "Shopping Cart Management",
      "description": "Customers can add flowers to cart, modify quantities, and review before checkout.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can add flowers to my cart so that I can purchase multiple items together.",
        "As a customer, I can modify cart quantities so that I can adjust my order before checkout."
      ],
      "acceptance_criteria": [
        "Given I am viewing a flower, When I click add to cart, Then the item appears in my cart with correct quantity.",
        "Given I have items in cart, When I change quantity or remove items, Then the cart total updates immediately."
      ]
    },
    {
      "id": "F3",
      "name": "Order Placement and Checkout",
      "description": "Customers can complete purchases with delivery details and payment information.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can enter delivery address and date so that flowers are delivered to the right location.",
        "As a customer, I can complete payment securely so that I can finalize my flower order."
      ],
      "acceptance_criteria": [
        "Given I am at checkout, When I enter valid delivery details, Then I can proceed to payment.",
        "Given I submit payment, When transaction succeeds, Then I receive order confirmation with tracking number."
      ]
    },
    {
      "id": "F4",
      "name": "Order Tracking",
      "description": "Customers can track their order status from preparation to delivery.",
      "priority": "Medium",
      "user_stories": [
        "As a customer, I can view my order status so that I know when to expect delivery.",
        "As a customer, I can receive notifications so that I am updated on my order progress."
      ],
      "acceptance_criteria": [
        "Given I have placed an order, When I check order status, Then I see current stage and estimated delivery time.",
        "Given my order status changes, When an update occurs, Then I receive an email or SMS notification."
      ]
    },
    {
      "id": "F5",
      "name": "Inventory Management",
      "description": "Admin can manage flower inventory, update stock levels, and add new products.",
      "priority": "Medium",
      "user_stories": [
        "As an admin, I can add new flowers to catalog so that customers have more options.",
        "As an admin, I can update stock quantities so that inventory reflects current availability."
      ],
      "acceptance_criteria": [
        "Given I am logged in as admin, When I add a new flower with details, Then it appears in the catalog.",
        "Given I update stock quantity, When I save changes, Then the availability is reflected on the customer site."
      ]
    }
  ],
