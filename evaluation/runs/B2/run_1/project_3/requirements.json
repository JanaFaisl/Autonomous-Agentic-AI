{
  "project_name": "Hospital Appointment Booking System",
  "features": [
    {
      "id": "F1",
      "name": "Patient Registration",
      "description": "Patients can create and manage their accounts with personal and medical information.",
      "priority": "High",
      "user_stories": [
        "As a patient, I can register an account so that I can book appointments with doctors.",
        "As a patient, I can update my profile information so that my records remain current."
      ],
      "acceptance_criteria": [
        "Given a new patient, When they complete the registration form, Then an account is created and confirmation email is sent.",
        "Given a registered patient, When they update their profile, Then changes are saved and reflected immediately."
      ]
    },
    {
      "id": "F2",
      "name": "Appointment Scheduling",
      "description": "Patients can view available time slots and book appointments with doctors.",
      "priority": "High",
      "user_stories": [
        "As a patient, I can view available doctor schedules so that I can choose a convenient appointment time.",
        "As a patient, I can book an appointment so that I can secure a visit with my chosen doctor."
      ],
      "acceptance_criteria": [
        "Given available time slots, When a patient selects a slot, Then the appointment is booked and confirmation is displayed.",
        "Given a booked appointment, When the booking is complete, Then the patient receives a confirmation notification."
      ]
    },
    {
      "id": "F3",
      "name": "Doctor Schedule Management",
      "description": "Doctors can set their availability and manage their appointment schedules.",
      "priority": "High",
      "user_stories": [
        "As a doctor, I can set my available time slots so that patients can book appointments during my working hours.",
        "As a doctor, I can view my scheduled appointments so that I can prepare for patient visits."
      ],
      "acceptance_criteria": [
        "Given a doctor's calendar, When they set availability, Then time slots are visible to patients for booking.",
        "Given scheduled appointments, When a doctor views their calendar, Then all appointments are displayed with patient details."
      ]
    },
    {
      "id": "F4",
      "name": "Appointment Notifications",
      "description": "System sends automated reminders and notifications for upcoming appointments.",
      "priority": "Medium",
      "user_stories": [
        "As a patient, I can receive appointment reminders so that I don't miss my scheduled visit.",
        "As a doctor, I can receive notifications of new bookings so that I stay informed of my schedule."
      ],
      "acceptance_criteria": [
        "Given an upcoming appointment, When it is 24 hours away, Then a reminder notification is sent to the patient.",
        "Given a new booking, When a patient schedules an appointment, Then the doctor receives an immediate notification."
      ]
    },
    {
      "id": "F5",
      "name": "Appointment Cancellation and Rescheduling",
      "description": "Patients and doctors can cancel or reschedule appointments as needed.",
      "priority": "Medium",
      "user_stories": [
        "As a patient, I can cancel my appointment so that the time slot becomes available for others.",
        "As a patient, I can reschedule my appointment so that I can choose a more convenient time."
      ],
      "acceptance_criteria": [
        "Given a booked appointment, When a patient cancels it, Then the slot is freed and cancellation notice is sent.",
        "Given an existing appointment, When a patient reschedules, Then the new time is confirmed and old slot is released."
      ]
    }
  ],
  "technical_requirements": {
    "platform": [
      "Web",
      "Mobile"
    ],
    "technologies": [
