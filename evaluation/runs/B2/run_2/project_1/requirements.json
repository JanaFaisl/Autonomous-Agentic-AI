{
  "project_name": "Flower Delivery App",
  "features": [
    {
      "id": "F1",
      "name": "Flower Catalog Browsing",
      "description": "Customers can browse available flowers with images, descriptions, and prices.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can browse flower categories so that I can find the type of flowers I want.",
        "As a customer, I can view detailed flower information so that I can make informed purchase decisions."
      ],
      "acceptance_criteria": [
        "Given I am on the catalog page, When I select a category, Then I see all flowers in that category.",
        "Given I click on a flower, When the detail page loads, Then I see image, price, description, and availability."
      ]
    },
    {
      "id": "F2",
      "name": "Shopping Cart Management",
      "description": "Customers can add flowers to cart, modify quantities, and proceed to checkout.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can add flowers to my cart so that I can purchase multiple items together.",
        "As a customer, I can update cart quantities so that I can adjust my order before checkout."
      ],
      "acceptance_criteria": [
        "Given I am viewing a flower, When I click add to cart, Then the item appears in my cart with correct details.",
        "Given I have items in cart, When I change quantity, Then the cart total updates immediately."
      ]
    },
    {
      "id": "F3",
      "name": "Order Placement and Payment",
      "description": "Customers can complete checkout with delivery details and payment processing.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can enter delivery address so that flowers are sent to the correct location.",
        "As a customer, I can pay securely online so that I can complete my flower order."
      ],
      "acceptance_criteria": [
        "Given I am at checkout, When I enter valid delivery details, Then I can proceed to payment.",
        "Given I submit payment, When transaction succeeds, Then I receive order confirmation with tracking number."
      ]
    },
    {
      "id": "F4",
      "name": "Order Tracking",
      "description": "Customers can track their order status from preparation to delivery.",
      "priority": "Medium",
      "user_stories": [
        "As a customer, I can view my order status so that I know when to expect delivery.",
        "As a customer, I can receive notifications so that I am updated on delivery progress."
      ],
      "acceptance_criteria": [
        "Given I have placed an order, When I check order status, Then I see current stage and estimated delivery time.",
        "Given my order status changes, When update occurs, Then I receive email or SMS notification."
      ]
    },
    {
      "id": "F5",
      "name": "Admin Inventory Management",
      "description": "Administrators can manage flower inventory, pricing, and availability.",
      "priority": "Medium",
      "user_stories": [
        "As an admin, I can add new flowers to catalog so that customers have more options.",
        "As an admin, I can update stock levels so that inventory reflects current availability."
      ],
      "acceptance_criteria": [
        "Given I am logged in as admin, When I add a flower with details, Then it appears in customer catalog.",
        "Given I update stock quantity, When I save changes, Then availability updates for customers immediately."
      ]
    }
  ],
  "technical_requirements": {
    "platform": [
      "Web",
      "Mobile"
    ],
    "technologies": [
      "React",
      "Node.js",
      "Express",
      "Stripe API",
      "AWS S3"
    ],
    "database": "PostgreSQL"
  },
  "user_roles": [
    "Customer",
    "Admin",
    "Delivery Driver"
