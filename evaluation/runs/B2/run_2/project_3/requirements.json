{
  "project_name": "Hospital Appointment Booking System",
  "features": [
    {
      "id": "F1",
      "name": "Patient Registration",
      "description": "Allow patients to create and manage their accounts in the system.",
      "priority": "High",
      "user_stories": [
        "As a patient, I can register with my personal details so that I can book appointments.",
        "As a patient, I can update my profile information so that my records remain current."
      ],
      "acceptance_criteria": [
        "Given a new patient, When they submit registration form with valid data, Then account is created successfully.",
        "Given a registered patient, When they update profile, Then changes are saved and confirmation is displayed."
      ]
    },
    {
      "id": "F2",
      "name": "Appointment Booking",
      "description": "Enable patients to schedule appointments with available doctors.",
      "priority": "High",
      "user_stories": [
        "As a patient, I can view available doctor slots so that I can book a convenient appointment.",
        "As a patient, I can select a doctor and time slot so that I can schedule my visit."
      ],
      "acceptance_criteria": [
        "Given available slots, When patient selects a slot, Then appointment is confirmed and notification sent.",
        "Given a booked slot, When another patient tries to book it, Then system shows slot unavailable."
      ]
    },
    {
      "id": "F3",
      "name": "Doctor Schedule Management",
      "description": "Allow doctors to manage their availability and view scheduled appointments.",
      "priority": "High",
      "user_stories": [
        "As a doctor, I can set my available time slots so that patients can book appointments.",
        "As a doctor, I can view my scheduled appointments so that I can prepare for patient visits."
      ],
      "acceptance_criteria": [
        "Given a doctor login, When they set availability, Then slots are visible to patients for booking.",
        "Given scheduled appointments, When doctor views calendar, Then all appointments are displayed with patient details."
      ]
    },
    {
      "id": "F4",
      "name": "Appointment Cancellation and Rescheduling",
      "description": "Allow patients and doctors to cancel or reschedule appointments.",
      "priority": "Medium",
      "user_stories": [
        "As a patient, I can cancel my appointment so that the slot becomes available for others.",
        "As a patient, I can reschedule my appointment so that I can choose a more convenient time."
      ],
      "acceptance_criteria": [
        "Given a booked appointment, When patient cancels, Then slot is freed and confirmation email sent.",
        "Given an existing appointment, When patient reschedules, Then new slot is booked and old slot freed."
      ]
    },
    {
      "id": "F5",
      "name": "Notifications and Reminders",
      "description": "Send automated notifications and reminders to patients and doctors.",
      "priority": "Medium",
      "user_stories": [
        "As a patient, I can receive appointment reminders so that I don't miss my scheduled visit.",
        "As a doctor, I can receive notifications of new bookings so that I stay informed of my schedule."
      ],
      "acceptance_criteria": [
        "Given an appointment 24 hours away, When reminder time arrives, Then email and SMS sent to patient.",
        "Given a new booking, When appointment is confirmed, Then doctor receives notification immediately."
      ]
    }
  ],
  "technical_requirements": {
    "platform": [
      "Web",
      "Mobile"
    ],
    "technologies": [
      "React",
      "Node.js",
      "Express",
      "TypeScript",
      "REST API"
    ],
    "database": "PostgreSQL"
  },
