    {
      "name": "availability_slots",
      "purpose": "Store doctor availability time slots for appointments",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "doctor_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to doctors table"
        },
        {
          "name": "slot_date",
          "type": "date",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Date of availability"
        },
        {
          "name": "start_time",
          "type": "time",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Slot start time"
        },
        {
          "name": "end_time",
          "type": "time",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Slot end time"
        },
        {
          "name": "is_available",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "true",
          "notes": "Whether slot is available for booking"
        }
      ],
      "indexes": [
        "doctor_id",
        "slot_date",
        "is_available"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "doctors",
          "fk": "doctor_id",
          "ref": "id",
          "notes": "Each slot belongs to one doctor"
        }
      ]
    },
    {
      "name": "appointments",
      "purpose": "Store appointment bookings between patients and doctors",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "patient_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to patients table"
        },
        {
          "name": "doctor_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to doctors table"
        },
        {
          "name": "slot_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Foreign key to availability_slots table"
        },
        {
          "name": "appointment_date",
          "type": "date",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Date of appointment"
        },
        {
          "name": "start_time",
          "type": "time",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Appointment start time"
        },
        {
          "name": "end_time",
          "type": "time",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Appointment end time"
        },
        {
          "name": "status",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "scheduled",
          "notes": "Status: scheduled, completed, cancelled, rescheduled"
        },
        {
          "name": "reason",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Reason for appointment"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Booking creation timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Last update timestamp"
        }
      ],
      "indexes": [
        "patient_id",
        "doctor_id",
        "appointment_date",
        "status"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "patients",
          "fk": "patient_id",
          "ref": "id",
          "notes": "Each appointment belongs to one patient"
        },
        {
          "type": "many-to-one",
          "to_table": "doctors",
          "fk": "doctor_id",
          "ref": "id",
          "notes": "Each appointment belongs to one doctor"
        },
        {
          "type": "one-to-one",
          "to_table": "availability_slots",
          "fk": "slot_id",
          "ref": "id",
          "notes": "Each appointment uses one availability slot"
        }
      ]
    },
    {
      "name": "notifications",
      "purpose": "Store notification and reminder records sent to users",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users table"
        },
        {
          "name": "appointment_id",
          "type": "uuid",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Foreign key to appointments table if applicable"
        },
        {
          "name": "type",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Type: reminder, confirmation, cancellation"
        },
        {
          "name": "channel",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Channel: email, sms, push"
        },
        {
          "name": "message",
          "type": "text",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Notification message content"
        },
        {
          "name": "sent_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "When notification was sent"
        },
        {
          "name": "status",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "sent",
          "notes": "Status: sent, failed, pending"
        }
      ],
      "indexes": [
        "user_id",
        "appointment_id",
        "sent_at"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Each notification belongs to one user"
        },
        {
          "type": "many-to-one",
          "to_table": "appointments",
          "fk": "appointment_id",
          "ref": "id",
          "notes": "Notification may relate to an appointment"
        }
      ]
    }
  ],
  "assumptions": [
    "Each appointment slot is 30 minutes by default",
    "Patients can only book one appointment per day with the same doctor",
    "Reminders are sent 24 hours before appointment time",
    "Cancelled appointments free up the slot immediately for rebooking",
    "Doctors can set recurring availability patterns weekly",
    "System supports email and SMS notifications",
    "All timestamps are stored in UTC",
    "Password hashing uses bcrypt algorithm"
  ]
}