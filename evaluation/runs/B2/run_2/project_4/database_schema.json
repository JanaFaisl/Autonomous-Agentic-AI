{
  "tables": [
    {
      "name": "users",
      "purpose": "Store student user account information",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "University email address"
        },
        {
          "name": "password_hash",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Hashed password"
        },
        {
          "name": "full_name",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Student full name"
        },
        {
          "name": "university",
          "type": "varchar(255)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "University name"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Account creation timestamp"
        },
        {
          "name": "is_verified",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "false",
          "notes": "Email verification status"
        }
      ],
      "indexes": [
        "email",
        "university"
      ],
      "relationships": []
    },
    {
      "name": "study_notes",
      "purpose": "Store uploaded study notes and their metadata",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users"
        },
        {
          "name": "title",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Note title"
        },
        {
          "name": "subject",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Subject category"
        },
        {
          "name": "description",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Note description"
        },
        {
          "name": "file_url",
          "type": "varchar(500)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "S3 file URL"
        },
        {
          "name": "file_type",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "File extension type"
        },
        {
          "name": "upload_date",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
