  ],
  "assumptions": [
    "University email verification is required for registration",
    "File uploads are stored in AWS S3 with URL references in database",
    "Real-time chat uses Socket.io for WebSocket connections",
    "Rating system uses 1-5 scale with optional text reviews",
    "Group admins have additional permissions for member management",
    "Maximum group size is configurable per group with default of 50",
    "Users can be members of multiple groups simultaneously",
    "Notes can be filtered by subject, rating, and upload date",
    "Each user can rate a note only once (enforced at application level or via unique constraint on note_id + user_id)",
    "Group messages are stored indefinitely for history purposes",
    "The average_rating in study_notes is calculated and updated when ratings are added or modified",
    "All tables use UUID as primary key for better scalability and security",
    "Timestamps use CURRENT_TIMESTAMP for automatic tracking of creation times",
    "Snake_case naming convention is used throughout the schema",
    "Foreign key constraints ensure referential integrity between related tables"
  ]
}