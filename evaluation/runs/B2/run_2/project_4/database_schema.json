        {
          "name": "average_rating",
          "type": "decimal(3,2)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Average rating score"
        }
      ],
      "indexes": [
        "user_id",
        "subject",
        "upload_date"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Notes belong to a user"
        }
      ]
    },
