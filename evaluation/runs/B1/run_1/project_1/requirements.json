{
  "project_name": "Flower Delivery App",
  "features": [
    {
      "id": "F1",
      "name": "Flower Catalog Browsing",
      "description": "Customers can browse available flowers with images, descriptions, and prices.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can browse flower categories so that I can find the perfect arrangement for my needs.",
        "As a customer, I can view detailed flower information so that I can make an informed purchase decision."
      ],
      "acceptance_criteria": [
        "Given I am on the homepage, When I click on a category, Then I see all flowers in that category with images and prices.",
        "Given I am viewing a flower, When I click on it, Then I see detailed description, price, and availability."
      ]
    },
    {
      "id": "F2",
      "name": "Shopping Cart Management",
      "description": "Customers can add flowers to cart, modify quantities, and proceed to checkout.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can add flowers to my cart so that I can purchase multiple items at once.",
        "As a customer, I can modify cart quantities so that I can adjust my order before checkout."
      ],
      "acceptance_criteria": [
        "Given I am viewing a flower, When I click add to cart, Then the item appears in my cart with correct quantity and price.",
        "Given I have items in cart, When I change quantity or remove items, Then the cart total updates immediately."
      ]
    },
    {
      "id": "F3",
      "name": "Order Placement and Checkout",
      "description": "Customers can complete purchases with delivery details and payment information.",
      "priority": "High",
      "user_stories": [
        "As a customer, I can enter delivery address and date so that flowers are delivered to the right place at the right time.",
        "As a customer, I can pay securely online so that I can complete my flower order."
      ],
      "acceptance_criteria": [
        "Given I am at checkout, When I enter valid delivery details and payment, Then my order is confirmed with order number.",
        "Given I complete payment, When the transaction succeeds, Then I receive an email confirmation with delivery details."
      ]
    },
    {
      "id": "F4",
      "name": "Order Tracking",
      "description": "Customers can view order status and track delivery progress in real-time.",
      "priority": "Medium",
      "user_stories": [
        "As a customer, I can view my order history so that I can track past and current orders.",
        "As a customer, I can see delivery status so that I know when my flowers will arrive."
      ],
      "acceptance_criteria": [
        "Given I am logged in, When I access my orders page, Then I see all orders with status and delivery dates.",
        "Given I have an active order, When I check order details, Then I see current status and estimated delivery time."
      ]
    },
    {
      "id": "F5",
      "name": "Admin Inventory Management",
      "description": "Administrators can manage flower inventory, pricing, and availability.",
      "priority": "Medium",
      "user_stories": [
        "As an admin, I can add new flowers to the catalog so that customers have more options to choose from.",
        "As an admin, I can update stock levels so that customers only see available flowers."
      ],
      "acceptance_criteria": [
        "Given I am logged in as admin, When I add a new flower with details, Then it appears in the customer catalog immediately.",
        "Given I am managing inventory, When I update stock to zero, Then the flower shows as out of stock to customers."
      ]
    }
  ],
  "technical_requirements": {
    "platform": [
      "Web",
      "Mobile"
    ],
    "technologies": [
      "React",
      "Node.js",
      "Express",
      "Stripe API",
      "Google Maps API"
    ],
    "database": "PostgreSQL"
  },
  "user_roles": [
    "Customer",
    "Administrator",
    "Delivery Driver"
  ],
