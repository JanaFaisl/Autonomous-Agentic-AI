{
  "tables": [
    {
      "name": "users",
      "purpose": "Store user account information for customers, admins, and delivery drivers",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "User email for login"
        },
        {
          "name": "password_hash",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Hashed password"
        },
        {
          "name": "role",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "Customer",
          "notes": "User role: Customer, Administrator, or Delivery Driver"
        },
        {
          "name": "first_name",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User first name"
        },
        {
          "name": "last_name",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User last name"
        },
        {
          "name": "phone",
          "type": "varchar(20)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Contact phone number"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Account creation timestamp"
        }
      ],
      "indexes": [
        "email",
        "role"
      ],
      "relationships": []
    },
    {
      "name": "flowers",
      "purpose": "Store flower product information including details, pricing, and availability",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "name",
          "type": "varchar(200)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Flower arrangement name"
        },
        {
          "name": "description",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Detailed description"
        },
        {
          "name": "category",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Flower category (e.g., Roses, Tulips, Mixed)"
        },
        {
          "name": "price",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Price in dollars"
        },
        {
          "name": "stock_quantity",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "0",
          "notes": "Available inventory count"
        },
        {
          "name": "image_url",
          "type": "varchar(500)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "URL to flower image"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "true",
          "notes": "Whether flower is available for purchase"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Record creation timestamp"
        }
      ],
      "indexes": [
        "category",
        "is_active"
      ],
      "relationships": []
    },
    {
      "name": "orders",
      "purpose": "Store customer order information including delivery details and status",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users table"
        },
        {
          "name": "order_number",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Unique order identifier"
        },
        {
          "name": "status",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "Pending",
          "notes": "Order status: Pending, Processing, Out for Delivery, Delivered, Cancelled"
        },
        {
          "name": "total_amount",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Total order amount"
        },
        {
          "name": "delivery_address",
          "type": "text",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Full delivery address"
        },
        {
          "name": "delivery_date",
          "type": "date",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Requested delivery date"
        },
        {
          "name": "delivery_time_slot",
          "type": "varchar(50)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Preferred delivery time window"
        },
        {
          "name": "special_instructions",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Customer delivery instructions"
        },
        {
          "name": "payment_status",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "Pending",
          "notes": "Payment status: Pending, Completed, Failed, Refunded"
        },
        {
          "name": "payment_method",
          "type": "varchar(50)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Payment method used"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Order creation timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Last update timestamp"
        }
      ],
      "indexes": [
        "user_id",
        "status",
        "order_number",
        "delivery_date"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Each order belongs to one user"
        }
      ]
    },
    {
      "name": "order_items",
      "purpose": "Store individual flower items within each order",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "order_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to orders table"
        },
        {
          "name": "flower_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to flowers table"
        },
        {
          "name": "quantity",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "1",
          "notes": "Number of items ordered"
        },
        {
          "name": "unit_price",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Price per unit at time of order"
        },
        {
          "name": "subtotal",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Quantity multiplied by unit price"
        }
      ],
      "indexes": [
        "order_id",
        "flower_id"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "orders",
          "fk": "order_id",
          "ref": "id",
          "notes": "Each order item belongs to one order"
        },
        {
          "type": "many-to-one",
          "to_table": "flowers",
          "fk": "flower_id",
          "ref": "id",
          "notes": "Each order item references one flower product"
        }
      ]
    },
    {
      "name": "delivery_assignments",
      "purpose": "Track which delivery driver is assigned to which order",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "order_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Foreign key to orders table"
        },
        {
          "name": "driver_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users table (driver role)"
        },
        {
          "name": "assigned_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "When driver was assigned"
        },
        {
          "name": "picked_up_at",
          "type": "timestamp",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "When driver picked up the order"
        },
        {
          "name": "delivered_at",
          "type": "timestamp",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "When order was delivered"
        }
      ],
      "indexes": [
        "order_id",
        "driver_id"
      ],
      "relationships": [
        {
          "type": "one-to-one",
          "to_table": "orders",
          "fk": "order_id",
          "ref": "id",
          "notes": "Each delivery assignment is for one order"
        },
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "driver_id",
          "ref": "id",
          "notes": "Each assignment is to one delivery driver"
        }
      ]
    }
  ],
  "assumptions": [
    "Users must register and login to place orders",
    "Payment processing is handled via third-party integration (e.g., Stripe)",
    "Delivery addresses are stored as text; geocoding handled by application layer",
    "Stock quantities are decremented when orders are placed",
    "Order status transitions: Pending -> Processing -> Out for Delivery -> Delivered",
    "Delivery drivers are users with role 'Delivery Driver'",
    "Each order can only be assigned to one driver at a time",
    "Prices are stored in USD with 2 decimal places",
    "All tables use UUID as primary key for better scalability and security",
    "Timestamps use CURRENT_TIMESTAMP default for automatic tracking",
    "Shopping cart functionality is handled at application layer; no separate cart table needed",
    "Email confirmations and notifications are handled by application layer",
    "Order numbers are generated by application logic to ensure uniqueness",
    "Soft deletes are not implemented; is_active flag on flowers handles product availability"
  ]
}