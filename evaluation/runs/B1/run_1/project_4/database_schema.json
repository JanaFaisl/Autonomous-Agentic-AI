          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "University email address"
        },
        {
          "name": "password_hash",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Hashed password"
        },
        {
          "name": "full_name",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
