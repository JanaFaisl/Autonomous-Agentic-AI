{
  "tables": [
    {
      "name": "users",
      "purpose": "Store user accounts and authentication information",
      "columns": [
        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "username",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Unique username for login"
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "User email address"
        },
        {
          "name": "password_hash",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Hashed password"
        },
        {
          "name": "role",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "Store Clerk",
          "notes": "User role: Store Owner, Store Manager, or Store Clerk"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Account creation timestamp"
        }
      ],
      "indexes": [
        "idx_users_email",
        "idx_users_username"
      ],
      "relationships": []
    },
    {
      "name": "products",
      "purpose": "Store product information including barcodes and pricing",
      "columns": [
        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "sku",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Stock keeping unit"
        },
        {
          "name": "barcode",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Product barcode for scanning"
        },
        {
          "name": "name",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Product name"
        },
        {
          "name": "description",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Product description"
        },
        {
          "name": "price",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Product selling price"
        },
        {
          "name": "cost",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Product cost price"
        },
        {
          "name": "low_stock_threshold",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "10",
          "notes": "Minimum quantity before low stock alert"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Product creation timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Last update timestamp"
        }
      ],
      "indexes": [
        "idx_products_barcode",
        "idx_products_sku"
      ],
      "relationships": []
    },
    {
      "name": "inventory",
      "purpose": "Track current stock levels for each product",
      "columns": [
        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "product_id",
          "type": "bigint",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Foreign key to products table"
        },
        {
          "name": "quantity",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "0",
          "notes": "Current stock quantity"
        },
        {
          "name": "last_updated",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Last inventory update timestamp"
        },
        {
          "name": "updated_by",
          "type": "bigint",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "User who last updated inventory"
        }
      ],
      "indexes": [
        "idx_inventory_product_id"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "products",
          "fk": "product_id",
          "ref": "id",
          "notes": "Each inventory record belongs to one product"
        },
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "updated_by",
          "ref": "id",
          "notes": "Track which user updated inventory"
        }
      ]
    },
    {
      "name": "inventory_transactions",
      "purpose": "Log all inventory changes for audit trail",
      "columns": [
        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "product_id",
          "type": "bigint",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to products table"
        },
        {
          "name": "transaction_type",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Type: sale, restock, adjustment, return"
        },
        {
          "name": "quantity_change",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Positive for additions, negative for reductions"
        },
        {
          "name": "previous_quantity",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Quantity before transaction"
        },
        {
          "name": "new_quantity",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Quantity after transaction"
        },
        {
          "name": "user_id",
          "type": "bigint",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User who performed the transaction"
        },
        {
          "name": "notes",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Optional transaction notes"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Transaction timestamp"
        }
      ],
      "indexes": [
        "idx_transactions_product_id",
        "idx_transactions_created_at"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "products",
          "fk": "product_id",
          "ref": "id",
          "notes": "Each transaction relates to one product"
        },
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Track which user performed the transaction"
        }
      ]
    },
    {
      "name": "sales",
      "purpose": "Record sales transactions",
      "columns": [
        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "sale_date",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Date and time of sale"
        },
        {
          "name": "total_amount",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Total sale amount"
        },
        {
          "name": "user_id",
          "type": "bigint",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User who processed the sale"
        },
        {
          "name": "payment_method",
          "type": "varchar(50)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Payment method used"
        }
      ],
      "indexes": [
        "idx_sales_date",
        "idx_sales_user_id"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Track which user processed the sale"
        }
      ]
    },
    {
      "name": "sale_items",
      "purpose": "Store individual items in each sale transaction",
      "columns": [
        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "sale_id",
          "type": "bigint",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to sales table"
        },
        {
          "name": "product_id",
          "type": "bigint",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to products table"
        },
        {
          "name": "quantity",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Quantity sold"
        },
        {
          "name": "unit_price",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Price per unit at time of sale"
        },
        {
          "name": "subtotal",
          "type": "decimal(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Line item total (quantity * unit_price)"
        }
      ],
      "indexes": [
        "idx_sale_items_sale_id",
        "idx_sale_items_product_id"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "sales",
          "fk": "sale_id",
          "ref": "id",
          "notes": "Each sale item belongs to one sale"
        },
        {
          "type": "many-to-one",
          "to_table": "products",
          "fk": "product_id",
          "ref": "id",
          "notes": "Each sale item references one product"
        }
      ]
    },
    {
      "name": "alerts",
      "purpose": "Store low stock and other system alerts",
      "columns": [
        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "product_id",
          "type": "bigint",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to products table"
        },
        {
          "name": "alert_type",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Type of alert: low_stock, out_of_stock"
        },
        {
          "name": "message",
          "type": "text",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Alert message"
        },
        {
          "name": "is_read",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "false",
          "notes": "Whether alert has been acknowledged"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Alert creation timestamp"
        }
      ],
      "indexes": [
        "idx_alerts_product_id",
        "idx_alerts_is_read"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "products",
          "fk": "product_id",
          "ref": "id",
          "notes": "Each alert relates to one product"
        }
      ]
    }
  ],
  "assumptions": [
    "Single store location per deployment",
    "Real-time updates use WebSocket connections",
    "Barcode scanning uses standard UPC/EAN formats",
    "User authentication uses JWT tokens",
    "All monetary values stored in store's base currency",
    "Inventory transactions are immutable for audit purposes",
    "Low stock alerts generated automatically via database triggers",
    "Sales reports calculated from sales and sale_items tables",
    "All primary keys use bigint for scalability",
    "Timestamps use server timezone or UTC",
    "Soft deletes not implemented; records are permanent",
    "One inventory record per product (1:1 relationship)",
    "Sale items link to products for historical price tracking"
  ]
}