{
  "project_name": "Hospital Appointment Booking System",
  "features": [
    {
      "id": "F1",
      "name": "Patient Registration",
      "description": "Allow patients to create and manage their accounts in the system.",
      "priority": "High",
      "user_stories": [
        "As a patient, I can register with my personal details so that I can book appointments.",
        "As a patient, I can update my profile information so that my records remain current."
      ],
      "acceptance_criteria": [
        "Given a new patient, When they submit registration form with valid data, Then account is created successfully.",
        "Given a registered patient, When they update profile, Then changes are saved and confirmation is displayed."
      ]
    },
    {
      "id": "F2",
      "name": "Appointment Scheduling",
      "description": "Enable patients to book appointments with available doctors.",
      "priority": "High",
      "user_stories": [
        "As a patient, I can view available time slots for doctors so that I can schedule an appointment.",
        "As a patient, I can select a doctor and time slot so that I can confirm my appointment."
      ],
      "acceptance_criteria": [
        "Given available doctors, When patient searches by specialty, Then matching doctors with slots are displayed.",
        "Given a selected time slot, When patient confirms booking, Then appointment is created and confirmation sent."
      ]
    },
    {
      "id": "F3",
      "name": "Doctor Schedule Management",
      "description": "Allow doctors to manage their availability and view scheduled appointments.",
      "priority": "High",
      "user_stories": [
        "As a doctor, I can set my available time slots so that patients can book appointments.",
        "As a doctor, I can view my scheduled appointments so that I can prepare for patient visits."
      ],
      "acceptance_criteria": [
        "Given a doctor login, When they set availability, Then time slots are updated in the system.",
        "Given scheduled appointments, When doctor views calendar, Then all appointments are displayed with patient details."
      ]
    },
    {
      "id": "F4",
      "name": "Appointment Notifications",
      "description": "Send automated reminders to patients and doctors about upcoming appointments.",
      "priority": "Medium",
      "user_stories": [
        "As a patient, I can receive appointment reminders so that I don't miss my scheduled visit.",
        "As a doctor, I can receive notifications of new bookings so that I stay informed."
      ],
      "acceptance_criteria": [
        "Given an appointment 24 hours away, When reminder time arrives, Then email notification is sent to patient.",
        "Given a new booking, When appointment is confirmed, Then doctor receives instant notification."
      ]
    },
    {
      "id": "F5",
      "name": "Appointment Cancellation",
      "description": "Allow patients and doctors to cancel appointments with proper notification.",
      "priority": "Medium",
      "user_stories": [
        "As a patient, I can cancel my appointment so that the time slot becomes available for others.",
        "As a doctor, I can cancel appointments in emergencies so that patients are notified promptly."
      ],
      "acceptance_criteria": [
        "Given a booked appointment, When patient cancels, Then slot is freed and doctor is notified.",
        "Given a doctor cancellation, When appointment is cancelled, Then patient receives notification immediately."
      ]
    }
  ],
  "technical_requirements": {
    "platform": [
      "Web",
      "Mobile"
    ],
    "technologies": [
      "React",
      "Node.js",
      "Express",
      "TypeScript",
      "REST API"
    ],
    "database": "PostgreSQL"
  },
  "user_roles": [
    "Patient",
    "Doctor",
    "Administrator"
