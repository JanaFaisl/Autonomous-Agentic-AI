{
  "tables": [
    {
      "name": "users",
      "purpose": "Store user account information",
      "columns": [
        {
          "name": "id",
          "type": "int",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "username",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Unique username"
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "User email address"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Account creation timestamp"
        }
      ],
      "indexes": [
        "email",
        "username"
      ],
      "relationships": []
    },
    {
      "name": "tasks",
      "purpose": "Store task information for users",
      "columns": [
        {
          "name": "id",
          "type": "int",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "user_id",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users table"
        },
        {
          "name": "title",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Task title"
        },
        {
          "name": "description",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Task description"
        },
        {
          "name": "is_completed",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "false",
          "notes": "Task completion status"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Task creation timestamp"
        },
        {
          "name": "completed_at",
          "type": "timestamp",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Task completion timestamp"
        }
      ],
      "indexes": [
        "user_id",
        "is_completed"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Each task belongs to one user"
        }
      ]
    }
  ],
  "assumptions": [
    "Users must be authenticated to access tasks",
    "Soft delete not implemented - tasks are permanently deleted",
    "Tasks are sorted by creation date by default",
    "No task priority or due date fields in initial version",
    "PostgreSQL database will be used as specified in technical requirements",
    "Auto-incrementing integer IDs are used for primary keys",
    "Cascade delete behavior should be configured at database level for user deletion"
  ]
}