  ],
  "assumptions": [
    "University email verification is required for registration",
    "File storage uses AWS S3 for scalability",
    "Study groups have optional member limits",
    "Rating system uses 1-5 scale",
    "Group admins have special permissions for announcements",
    "All timestamps use UTC timezone",
    "Each user can be a member of multiple study groups (many-to-many relationship via group_members junction table)",
    "Each user can review multiple notes and each note can have multiple reviews",
    "Group messages support both regular messages and announcements distinguished by is_announcement flag",
    "Download count is tracked at the note level for analytics",
    "User roles (Student, Group Admin, Platform Administrator) are managed through application logic rather than a separate roles table"
  ]
}