    },
    {
      "name": "note_reviews",
      "purpose": "Store ratings and reviews for study notes",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "note_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to notes"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users"
        },
        {
          "name": "rating",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
