        },
        {
          "name": "user_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users"
        },
        {
          "name": "joined_at",
          "type": "timestamp",
