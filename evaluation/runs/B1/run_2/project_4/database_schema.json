        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "group_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
