          "notes": "Links members to groups"
        },
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Links users to groups"
        }
      ]
    },
    {
      "name": "group_messages",
