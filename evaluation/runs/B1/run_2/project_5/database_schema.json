{
  "tables": [
    {
      "name": "users",
      "purpose": "Store user account information and role assignments",
      "columns": [
        {
          "name": "id",
          "type": "int",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "username",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Unique username"
        },
        {
          "name": "email",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "User email address"
        },
        {
          "name": "password_hash",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Hashed password"
        },
        {
          "name": "role",
          "type": "varchar(30)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "Store Clerk",
          "notes": "User role: Store Manager, Store Clerk, Store Owner, Administrator"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "true",
          "notes": "Account active status"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Account creation timestamp"
        },
        {
          "name": "last_login",
          "type": "timestamp",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Last login timestamp"
        }
      ],
      "indexes": [
        "username",
        "email",
        "role"
      ],
      "relationships": []
    },
