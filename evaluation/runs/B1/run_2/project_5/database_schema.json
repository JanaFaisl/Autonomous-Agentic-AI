        },
        {
          "name": "name",
          "type": "varchar(200)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Product name"
        },
        {
          "name": "description",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
