        },
        {
          "name": "price",
          "type": "numeric(10,2)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Current selling price"
        },
        {
          "name": "cost",
          "type": "numeric(10,2)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Cost price from supplier"
        },
        {
          "name": "supplier_id",
          "type": "int",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
