  ],
  "assumptions": [
    "Single store location per deployment",
    "Real-time updates use WebSocket connections",
    "Barcode format supports standard retail barcodes (UPC, EAN)",
    "User authentication required for all operations",
    "Alerts sent via in-app notifications and email",
    "Reports generated on-demand with date range filters",
    "Mobile app supports camera-based barcode scanning",
    "Database handles concurrent transactions with proper locking",
    "All tables use integer primary keys with auto-increment",
    "Timestamps are stored in UTC timezone",
    "Soft deletes are not implemented; records are permanently deleted",
    "Product barcodes are unique across the entire system",
    "Each product has exactly one inventory record (one-to-one relationship)",
    "Transaction types are limited to: sale, restock, adjustment, return",
    "User roles are stored as strings and validated at application level",
    "Price and cost fields use numeric type with 2 decimal precision for currency",
    "Indexes are created on foreign keys and frequently queried columns for performance"
  ]
}