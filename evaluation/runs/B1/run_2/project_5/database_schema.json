    {
      "name": "inventory",
      "purpose": "Track current stock levels and thresholds for each product",
      "columns": [
        {
          "name": "id",
          "type": "int",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "product_id",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Foreign key to products table"
        },
        {
          "name": "quantity",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "0",
          "notes": "Current stock quantity"
        },
        {
          "name": "low_stock_threshold",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "10",
          "notes": "Minimum quantity before alert"
        },
        {
          "name": "last_restocked",
          "type": "timestamp",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Last restock date"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Record last update timestamp"
        }
      ],
      "indexes": [
        "product_id",
        "quantity"
      ],
      "relationships": [
        {
          "type": "one-to-one",
          "to_table": "products",
          "fk": "product_id",
          "ref": "id",
          "notes": "Each product has one inventory record"
        }
      ]
    },
    {
      "name": "transactions",
      "purpose": "Record all inventory transactions including sales, restocks, and adjustments",
      "columns": [
        {
          "name": "id",
          "type": "int",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Primary key"
        },
        {
          "name": "product_id",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to products table"
        },
        {
          "name": "user_id",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users table"
        },
        {
          "name": "transaction_type",
          "type": "varchar(20)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Type: sale, restock, adjustment, return"
        },
        {
          "name": "quantity",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Quantity changed (positive or negative)"
        },
        {
          "name": "unit_price",
          "type": "numeric(10,2)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Price per unit at transaction time"
        },
        {
          "name": "total_amount",
          "type": "numeric(10,2)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Total transaction amount"
        },
        {
          "name": "notes",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Additional transaction notes"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Transaction timestamp"
        }
      ],
      "indexes": [
        "product_id",
        "user_id",
        "transaction_type",
        "created_at"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "products",
          "fk": "product_id",
          "ref": "id",
          "notes": "Each transaction relates to one product"
        },
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Each transaction is performed by one user"
        }
      ]
    },
    {
