{
  "project_name": "Hospital Appointment Booking System",
  "features": [
    {
      "id": "F1",
      "name": "Patient Registration",
      "description": "Allow patients to create and manage their accounts in the system.",
      "priority": "High",
      "user_stories": [
        "As a patient, I can register with my personal details so that I can book appointments.",
        "As a patient, I can update my profile information so that my records remain current."
      ],
      "acceptance_criteria": [
        "Given a new patient, When they submit valid registration details, Then an account is created and confirmation is sent.",
        "Given a registered patient, When they update their profile, Then changes are saved and reflected immediately."
      ]
    },
    {
      "id": "F2",
      "name": "Appointment Scheduling",
      "description": "Enable patients to book appointments with available doctors.",
      "priority": "High",
      "user_stories": [
        "As a patient, I can view available time slots for doctors so that I can schedule an appointment.",
        "As a patient, I can select a doctor and time slot so that I can confirm my appointment."
      ],
      "acceptance_criteria": [
        "Given available doctors, When a patient searches by specialty or date, Then matching time slots are displayed.",
        "Given a selected time slot, When a patient confirms booking, Then the appointment is reserved and confirmation is sent."
      ]
    },
    {
      "id": "F3",
      "name": "Doctor Availability Management",
      "description": "Allow doctors to set and update their available time slots.",
      "priority": "High",
      "user_stories": [
        "As a doctor, I can set my available hours so that patients can book appointments during those times.",
        "As a doctor, I can block time slots so that I can manage my schedule effectively."
      ],
      "acceptance_criteria": [
        "Given a doctor login, When they set availability, Then time slots are created and visible to patients.",
        "Given existing availability, When a doctor blocks a slot, Then it becomes unavailable for booking."
      ]
    },
    {
      "id": "F4",
      "name": "Appointment Management",
      "description": "Allow patients and doctors to view, reschedule, or cancel appointments.",
      "priority": "Medium",
      "user_stories": [
        "As a patient, I can view my upcoming appointments so that I can track my scheduled visits.",
        "As a patient, I can cancel or reschedule an appointment so that I can adjust to my changing schedule."
      ],
      "acceptance_criteria": [
        "Given a logged-in patient, When they access their dashboard, Then all upcoming appointments are displayed.",
        "Given an existing appointment, When a patient cancels it, Then the slot becomes available and notification is sent."
      ]
    },
    {
      "id": "F5",
      "name": "Notification System",
      "description": "Send automated reminders and confirmations to patients and doctors.",
      "priority": "Medium",
      "user_stories": [
        "As a patient, I can receive appointment reminders so that I don't miss my scheduled visits.",
        "As a doctor, I can receive notifications about new bookings so that I stay informed of my schedule."
      ],
      "acceptance_criteria": [
        "Given a confirmed appointment, When it is 24 hours before the time, Then a reminder is sent to the patient.",
        "Given a new booking, When a patient confirms an appointment, Then the doctor receives an immediate notification."
      ]
    }
  ],
  "technical_requirements": {
    "platform": [
      "Web",
      "Mobile"
    ],
    "technologies": [
