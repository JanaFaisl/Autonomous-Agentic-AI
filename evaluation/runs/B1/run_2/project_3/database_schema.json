{
  "tables": [
    {
      "name": "users",
      "purpose": "Store all system users including patients, doctors, and administrators",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "User email for login"
        },
        {
          "name": "password_hash",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Hashed password"
        },
        {
          "name": "role",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User role: patient, doctor, administrator"
        },
        {
          "name": "first_name",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User first name"
        },
        {
          "name": "last_name",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User last name"
        },
        {
          "name": "phone",
          "type": "varchar(20)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Contact phone number"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Account creation timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Last update timestamp"
        }
      ],
      "indexes": [
        "email",
        "role"
      ],
      "relationships": []
    },
    {
      "name": "patients",
      "purpose": "Store patient-specific information",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Foreign key to users table"
        },
        {
          "name": "date_of_birth",
          "type": "date",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Patient date of birth"
        },
        {
          "name": "address",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Patient address"
        },
        {
          "name": "medical_history",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Patient medical history notes"
        }
      ],
      "indexes": [
        "user_id"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Each patient is linked to one user account"
        }
      ]
    },
    {
      "name": "doctors",
      "purpose": "Store doctor-specific information",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Foreign key to users table"
        },
        {
          "name": "specialty",
          "type": "varchar(100)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Doctor medical specialty"
        },
        {
          "name": "license_number",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Medical license number"
        },
        {
          "name": "department",
          "type": "varchar(100)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Hospital department"
        }
      ],
      "indexes": [
        "user_id",
        "specialty"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Each doctor is linked to one user account"
        }
      ]
    },
    {
      "name": "appointments",
      "purpose": "Store appointment bookings between patients and doctors",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "patient_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to patients table"
        },
        {
          "name": "doctor_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to doctors table"
        },
        {
          "name": "appointment_date",
          "type": "date",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Date of appointment"
        },
        {
          "name": "appointment_time",
          "type": "time",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Time of appointment"
        },
        {
          "name": "status",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "scheduled",
          "notes": "Status: scheduled, completed, cancelled, no-show"
        },
        {
          "name": "reason",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Reason for visit"
        },
        {
          "name": "notes",
          "type": "text",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Additional notes"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Booking creation timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Last update timestamp"
        }
      ],
      "indexes": [
        "patient_id",
        "doctor_id",
        "appointment_date",
        "status"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "patients",
          "fk": "patient_id",
          "ref": "id",
          "notes": "Each appointment belongs to one patient"
        },
        {
          "type": "many-to-one",
          "to_table": "doctors",
          "fk": "doctor_id",
          "ref": "id",
          "notes": "Each appointment is with one doctor"
        }
      ]
    },
    {
      "name": "availability",
      "purpose": "Store doctor availability time slots",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "doctor_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to doctors table"
        },
        {
          "name": "day_of_week",
          "type": "int",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Day of week: 0=Sunday, 6=Saturday"
        },
        {
          "name": "start_time",
          "type": "time",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Start time of availability"
        },
        {
          "name": "end_time",
          "type": "time",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "End time of availability"
        },
        {
          "name": "is_available",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "true",
          "notes": "Whether the slot is available"
        }
      ],
      "indexes": [
        "doctor_id",
        "day_of_week"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "doctors",
          "fk": "doctor_id",
          "ref": "id",
          "notes": "Each availability slot belongs to one doctor"
        }
      ]
    },
    {
      "name": "notifications",
      "purpose": "Store notification records sent to users",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Foreign key to users table"
        },
        {
          "name": "appointment_id",
          "type": "uuid",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Foreign key to appointments table"
        },
        {
          "name": "type",
          "type": "varchar(50)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Notification type: reminder, confirmation, cancellation"
        },
        {
          "name": "message",
          "type": "text",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Notification message content"
        },
        {
          "name": "sent_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "When notification was sent"
        },
        {
          "name": "is_read",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "false",
          "notes": "Whether notification has been read"
        }
      ],
      "indexes": [
        "user_id",
        "appointment_id",
        "sent_at"
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to_table": "users",
          "fk": "user_id",
          "ref": "id",
          "notes": "Each notification is sent to one user"
        },
        {
          "type": "many-to-one",
          "to_table": "appointments",
          "fk": "appointment_id",
          "ref": "id",
          "notes": "Notification may be related to an appointment"
        }
      ]
    }
  ],
  "assumptions": [
    "Each appointment slot is 30 minutes by default",
    "Doctors can set recurring weekly availability patterns",
    "Patients can only book appointments with available doctors",
    "Email and SMS notifications will be sent for reminders",
    "Administrators have full access to manage users and appointments",
    "Appointment cancellations must be made at least 24 hours in advance",
    "The system supports multiple time zones based on hospital location"
  ]
}