  ],
  "assumptions": [
    "All primary keys use UUID type for better distribution and security",
    "User roles are stored as varchar to allow flexibility (patient, doctor, administrator)",
    "Timestamps are used for all date/time fields to include timezone information",
    "Consultation fees are stored in cents (integer) to avoid floating-point precision issues",
    "Doctor availability is defined as recurring weekly schedules with day_of_week (0-6)",
    "Appointment slots are calculated based on doctor_availability slot_duration_minutes",
    "Appointment status includes: scheduled, confirmed, cancelled, completed, no_show",
    "Notification channels include: email, sms, push for multi-channel delivery",
    "Notification types include: confirmation, reminder, cancellation, reschedule, new_booking",
    "Soft delete is not implemented; cancelled appointments retain status='cancelled'",
    "Medical history and allergies are stored as text fields for flexibility",
    "Phone numbers are stored as varchar to accommodate international formats",
    "Email confirmations are handled by the notification system",
    "24-hour reminder notifications are triggered by scheduled jobs querying appointments",
    "Doctor-patient relationship is established through appointments only",
    "Junction table doctor_specialties allows doctors to have multiple specialties",
    "Indexes are added on foreign keys and frequently queried columns for performance",
    "All tables include created_at and updated_at timestamps for audit trails",
    "Unique constraints on email ensure no duplicate accounts",
    "is_active flags allow soft disabling of users and availability schedules"
  ]
}