  ],
  "assumptions": [
    "Prices are stored in cents (bigint) to avoid floating point precision issues",
    "User roles are stored as strings with values: store_owner, store_manager, store_clerk",
    "Barcode is unique per product and used for scanning functionality",
    "Low stock threshold is configurable per product with default value of 10",
    "Inventory transactions log all changes for complete audit trail",
    "Sales are broken into sales (header) and sale_items (line items) for detailed reporting",
    "Alerts are generated automatically when inventory falls below threshold",
    "User_alerts junction table allows multiple users to receive the same alert",
    "Real-time synchronization will be handled at application layer using WebSocket",
    "Timestamps use database CURRENT_TIMESTAMP for consistency",
    "All IDs use UUID for distributed system compatibility",
    "Soft deletes are not implemented; actual deletion is assumed",
    "Product categories and suppliers are optional (nullable foreign keys)",
    "Sale items capture unit price at time of sale for historical accuracy"
  ]
}