{
  "tables": [
    {
      "name": "users",
      "purpose": "Stores student user accounts and authentication information",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": true,
          "default": "gen_random_uuid()",
          "notes": "Primary key"
        },
        {
          "name": "email",
          "type": "varchar",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "University email address"
        },
        {
          "name": "password_hash",
          "type": "varchar",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Hashed password for authentication"
        },
        {
          "name": "first_name",
          "type": "varchar",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User first name"
        },
        {
          "name": "last_name",
          "type": "varchar",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "User last name"
        },
        {
          "name": "university",
          "type": "varchar",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "University name"
        },
        {
          "name": "is_verified",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "false",
          "notes": "Email verification status"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "true",
          "notes": "Account active status"
        },
        {
          "name": "role",
          "type": "varchar",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "Student",
          "notes": "User role: Student, Group Admin, Platform Administrator"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Account creation timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "CURRENT_TIMESTAMP",
          "notes": "Last update timestamp"
        }
      ],
      "indexes": [
        "email",
        "university",
        "is_verified"
      ],
      "relationships": []
    },
