  ],
  "assumptions": [
    "Users must verify their university email before full platform access",
    "Each study note file is stored in AWS S3 and referenced by URL",
    "Rating system uses integer scale from 1 to 5",
    "Average rating is stored as string to handle decimal precision",
    "Study groups can be open (anyone can join) or closed (admin approval required)",
    "Group admin is automatically added as a member upon group creation",
    "Users can be members of multiple study groups",
    "Notes can be shared in multiple study groups",
    "Download tracking is maintained for analytics and user activity history",
    "Each user can only rate a note once (enforced by unique constraint on user_id + note_id)",
    "Platform Administrator role has elevated privileges for moderation",
    "Tags are stored as JSON array for flexible categorization",
    "File types are validated on upload (handled at application layer)",
    "Soft delete pattern can be implemented using is_active flags where present",
    "Timestamps use server timezone (UTC recommended)"
  ]
}