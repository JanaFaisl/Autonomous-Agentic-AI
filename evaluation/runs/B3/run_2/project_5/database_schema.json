  ],
  "assumptions": [
    "Single store location - inventory table does not include location_id (can be extended for multi-location)",
    "Barcode is unique per product and required for scanning functionality",
    "Transactions represent completed sales that immediately decrease inventory",
    "Low stock alerts are automatically generated when inventory quantity falls below minimum_threshold",
    "User roles are stored as varchar enum values: store_owner, store_manager, store_clerk",
    "All monetary values use decimal(10,2) for precision",
    "UUIDs are used as primary keys for better distribution and security",
    "Soft deletes are handled via is_active flags rather than hard deletes",
    "Real-time synchronization will be handled at application layer using WebSocket",
    "Sales reports will be generated from transaction and transaction_items tables via queries",
    "Inventory adjustments table provides audit trail for manual stock changes",
    "Alert severity levels help prioritize notifications: low, medium, high, critical",
    "Many-to-many relationship between alerts and users allows multiple users to receive same alert",
    "Transaction status supports: completed, cancelled, refunded for business logic",
    "Timestamps use CURRENT_TIMESTAMP for automatic tracking of creation and updates"
  ]
}