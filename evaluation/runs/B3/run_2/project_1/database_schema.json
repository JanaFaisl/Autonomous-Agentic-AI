  "assumptions": [
    "Users table contains all user types (customer, admin, delivery_driver) differentiated by role column",
    "Each user can have multiple addresses but only one is marked as default",
    "Each user has one active shopping cart at a time",
    "Flower prices are stored at time of cart addition and order placement to preserve historical pricing",
    "Order numbers are unique tracking identifiers generated for customer reference",
    "Order status values: pending, confirmed, preparing, out_for_delivery, delivered, cancelled",
    "Payment status values: pending, completed, failed, refunded",
    "Delivery status values: pending, assigned, picked_up, in_transit, delivered, failed",
    "Notification types: email, sms, push (using SendGrid for email)",
    "Images are stored in AWS S3 and only URLs are stored in database",
    "Stock quantity of 0 automatically sets is_available to false",
    "Reviews can only be submitted by customers who have purchased the flower",
    "Tax and delivery fees are calculated at checkout and stored with order",
    "Order status history provides audit trail for tracking feature",
    "One delivery record per order for driver assignment and tracking",
    "Stripe payment intent ID is stored for payment reconciliation and refunds",
    "Timestamps use UTC timezone",
    "Numeric types use precision of 10 digits with 2 decimal places for currency"
  ]
