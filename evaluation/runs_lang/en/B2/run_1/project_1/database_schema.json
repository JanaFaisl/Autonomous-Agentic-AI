{
  "tables": [
    {
      "name": "users",
      "purpose": "All system accounts (customers, couriers, admins) with authentication data and role.",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "unique": false,
          "default": "gen_random_uuid()",
          "notes": null
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": true,
          "default": null,
          "notes": "Stored lowercase; used for login."
        },
        {
          "name": "password_hash",
          "type": "varchar(255)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "bcrypt hash only, never plain text."
        },
        {
          "name": "full_name",
          "type": "varchar(150)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": null,
          "notes": "Encrypt at rest."
        },
        {
          "name": "phone",
          "type": "varchar(30)",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Encrypt at rest."
        },
        {
          "name": "role",
          "type": "varchar(20)",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "'customer'",
          "notes": "One of: customer, courier, admin."
        },
        {
          "name": "is_active",
          "type": "boolean",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "true",
          "notes": "Couriers can be deactivated without deleting history."
        },
        {
          "name": "deletion_requested_at",
          "type": "timestamp",
          "pk": false,
          "nullable": true,
          "unique": false,
          "default": null,
          "notes": "Set when the user requests account deletion; personal data purged within 30 days."
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "now()",
          "notes": null
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "pk": false,
          "nullable": false,
          "unique": false,
          "default": "now()",
          "notes": null
        }
      ],
      "indexes": [
        "email",
        "role",
        "deletion_requested_at"
      ],
      "relationships": []
    },
