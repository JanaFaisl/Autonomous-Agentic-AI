{
  "app_documentation": "\u0646\u0638\u0627\u0645 \u062d\u062c\u0632 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0641\u064a \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u0649 \u0647\u0648 \u062a\u0637\u0628\u064a\u0642 \u0648\u064a\u0628 \u0628\u0648\u0627\u062c\u0647\u0629 \u0639\u0631\u0628\u064a\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 (RTL) \u064a\u0645\u0643\u0651\u0646 \u0627\u0644\u0645\u0631\u0636\u0649 \u0645\u0646 \u062d\u062c\u0632 \u0645\u0648\u0627\u0639\u064a\u062f\u0647\u0645 \u0645\u0639 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0648\u0625\u0644\u063a\u0627\u0626\u0647\u0627 \u0628\u0623\u0646\u0641\u0633\u0647\u0645 \u062f\u0648\u0646 \u0627\u0644\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u0649 \u0623\u0648 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0647\u0627. \u064a\u0647\u062f\u0641 \u0627\u0644\u0646\u0638\u0627\u0645 \u0625\u0644\u0649 \u062a\u0646\u0638\u064a\u0645 \u062a\u062f\u0641\u0642 \u0627\u0644\u0645\u0631\u0636\u0649 \u0641\u064a \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a\u060c \u0648\u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u0646\u0627\u062a\u062c\u0629 \u0639\u0646 \u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u064a\u062f\u0648\u064a\u060c \u0648\u0645\u0646\u0639 \u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u0645\u0632\u062f\u0648\u062c \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0646\u0641\u0633\u0647\u060c \u0648\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0645\u0631\u0636\u0649 \u0645\u0646 \u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u062d\u062c\u0632 \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 3 \u062f\u0642\u0627\u0626\u0642 \u0639\u0628\u0631 \u0645\u0633\u0627\u0631 \u0648\u0627\u0636\u062d: \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0637\u0628\u064a\u0628\u060c \u062b\u0645 \u062c\u062f\u0648\u0644 \u0627\u0644\u0637\u0628\u064a\u0628\u060c \u062b\u0645 \u0627\u0644\u062a\u0623\u0643\u064a\u062f\u060c \u062b\u0645 \u0639\u0631\u0636 \u0631\u0642\u0645 \u0627\u0644\u062a\u0623\u0643\u064a\u062f.\n\n\u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u0646\u0638\u0627\u0645 \u062e\u0645\u0633 \u0645\u064a\u0632\u0627\u062a \u0631\u0626\u064a\u0633\u064a\u0629: \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u0631\u0636\u0649 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0648\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 (F1)\u060c \u0648\u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u062d\u0633\u0628 \u0627\u0644\u0627\u0633\u0645 \u0623\u0648 \u0627\u0644\u062a\u062e\u0635\u0635 \u0645\u0639 \u0639\u0631\u0636 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0641\u0642\u0637 \u062f\u0648\u0646 \u0627\u0644\u0645\u062d\u062c\u0648\u0632\u0629 (F2)\u060c \u0648\u062d\u062c\u0632 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0648\u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0648\u0625\u0644\u063a\u0627\u0626\u0647\u0627 \u0645\u0639 \u0645\u0646\u0639 \u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u0645\u0632\u062f\u0648\u062c \u0648\u0627\u0642\u062a\u0631\u0627\u062d \u0623\u0648\u0642\u0627\u062a \u0628\u062f\u064a\u0644\u0629 \u0648\u0625\u0635\u062f\u0627\u0631 \u0631\u0642\u0645 \u062a\u0623\u0643\u064a\u062f (F3)\u060c \u0648\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0646\u0635\u064a\u0629 \u0628\u0645\u0627 \u0641\u064a\u0647\u0627 \u062a\u0630\u0643\u064a\u0631 \u0642\u0628\u0644 24 \u0633\u0627\u0639\u0629 \u0648\u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u0625\u0644\u063a\u0627\u0621 \u0645\u0639 \u062e\u064a\u0627\u0631 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062d\u062c\u0632 (F4)\u060c \u0648\u0625\u062f\u0627\u0631\u0629 \u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062f\u0648\u0627\u0645 \u0648\u0639\u0631\u0636 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u0645\u062d\u062c\u0648\u0632\u0629 \u0645\u0631\u062a\u0628\u0629 \u0632\u0645\u0646\u064a\u0627\u064b (F5). \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0627\u0644\u0639\u0627\u0644\u064a\u0629 \u0644\u0644\u0645\u064a\u0632\u0627\u062a F1 \u0648F2 \u0648F3\u060c \u0648\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0629 \u0644\u0644\u0645\u064a\u0632\u062a\u064a\u0646 F4 \u0648F5.\n\n\u064a\u062e\u062f\u0645 \u0627\u0644\u0646\u0638\u0627\u0645 \u0623\u0631\u0628\u0639\u0629 \u0623\u062f\u0648\u0627\u0631: \u0627\u0644\u0645\u0631\u064a\u0636 \u0627\u0644\u0630\u064a \u064a\u0628\u062d\u062b \u0648\u064a\u062d\u062c\u0632 \u0648\u064a\u062f\u064a\u0631 \u0645\u0648\u0627\u0639\u064a\u062f\u0647 \u0648\u0628\u064a\u0627\u0646\u0627\u062a\u0647\u060c \u0648\u0627\u0644\u0637\u0628\u064a\u0628 \u0627\u0644\u0630\u064a \u064a\u062d\u062f\u062f \u0623\u0648\u0642\u0627\u062a \u062a\u0648\u0641\u0631\u0647\u060c \u0648\u0645\u0648\u0638\u0641 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0627\u0644\u0630\u064a \u064a\u0639\u0631\u0636 \u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u064a\u0646\u0638\u0645 \u062a\u062f\u0641\u0642 \u0627\u0644\u0645\u0631\u0636\u0649\u060c \u0648\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645. \u0648\u062a\u0642\u0648\u0645 \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0639\u0644\u0649 React \u0644\u0644\u0648\u0627\u062c\u0647\u0629\u060c \u0648Node.js \u0645\u0639 REST API \u0644\u0644\u062e\u0627\u062f\u0645\u060c \u0648PostgreSQL \u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0648\u0645\u0635\u0627\u062f\u0642\u0629 JWT\u060c \u0648\u062e\u062f\u0645\u0629 SMTP \u0648\u0628\u0648\u0627\u0628\u0629 \u0631\u0633\u0627\u0626\u0644 \u0646\u0635\u064a\u0629 \u0644\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a. \u0648\u064a\u0645\u0646\u0639 \u062a\u0643\u0631\u0627\u0631 \u0627\u0644\u062d\u062c\u0632 \u0642\u064a\u062f \u0641\u0631\u064a\u062f \u0639\u0644\u0649 (doctor_id, slot_date, start_time) \u0641\u064a \u062c\u062f\u0648\u0644 time_slots \u0648\u0641\u0647\u0631\u0633 \u0641\u0631\u064a\u062f \u062c\u0632\u0626\u064a \u0639\u0644\u0649 appointments.time_slot_id \u0644\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u0645\u0624\u0643\u062f\u0629.\n\n\u064a\u0644\u062a\u0632\u0645 \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u063a\u064a\u0631 \u0648\u0638\u064a\u0641\u064a\u0629 \u0648\u0627\u0636\u062d\u0629: \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0639\u0646\u062f 200 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062a\u0632\u0627\u0645\u0646\u060c \u0648\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0646\u0642\u0644 \u0628\u0640 TLS 1.2 \u0623\u0648 \u0623\u062d\u062f\u062b \u0648\u062a\u062e\u0632\u064a\u0646 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0645\u062c\u0632\u0651\u0623\u0629 \u0648\u0645\u0634\u0641\u0631\u0629 \u0641\u064a password_hash\u060c \u0648\u062a\u0648\u0627\u0641\u0631 \u0644\u0627 \u064a\u0642\u0644 \u0639\u0646 99.5% \u0634\u0647\u0631\u064a\u0627\u064b\u060c \u0648\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0628\u062d\u064a\u062b \u0644\u0627 \u062a\u064f\u0639\u0631\u0636 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0625\u0644\u0627 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u0635\u0631\u062d \u0644\u0647\u0645 \u062d\u0633\u0628 \u0627\u0644\u062f\u0648\u0631\u060c \u0645\u0639 \u0633\u062c\u0644 \u062a\u062f\u0642\u064a\u0642 \u0641\u064a audit_logs. \u0648\u064a\u0642\u0648\u0645 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0639\u0644\u0649 \u0646\u0647\u062c \u0627\u0644\u062c\u0648\u0627\u0644 \u0623\u0648\u0644\u0627\u064b \u0645\u0639 \u0634\u0631\u064a\u0637 \u062a\u0646\u0642\u0644 \u0633\u0641\u0644\u064a (\u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0645\u0648\u0627\u0639\u064a\u062f\u064a\u060c \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a\u060c \u062d\u0633\u0627\u0628\u064a)\u060c \u0648\u062e\u0637\u0648\u0637 Cairo \u0648Tajawal\u060c \u0648\u062a\u0628\u0627\u064a\u0646 \u0623\u0644\u0648\u0627\u0646 \u0644\u0627 \u064a\u0642\u0644 \u0639\u0646 4.5:1\u060c \u0648\u0623\u0647\u062f\u0627\u0641 \u0644\u0645\u0633 \u0644\u0627 \u062a\u0642\u0644 \u0639\u0646 44px. \u0648\u062a\u0646\u0642\u0633\u0645 \u062e\u0637\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0625\u0644\u0649 14 \u0645\u0647\u0645\u0629 (T1 \u0625\u0644\u0649 T14) \u062a\u0628\u062f\u0623 \u0628\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u062e\u0627\u062f\u0645 \u0648\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u062a\u0646\u062a\u0647\u064a \u0628\u0627\u062e\u062a\u0628\u0627\u0631 \u0634\u0627\u0645\u0644 \u0644\u0644\u0623\u062f\u0627\u0621 \u0648\u0627\u0644\u0623\u0645\u0627\u0646 \u0648\u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629\u060c \u0645\u0639 \u062a\u0623\u062c\u064a\u0644 \u0645\u0647\u0627\u0645 \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0627\u0644\u0645\u0646\u062e\u0641\u0636\u0629 (F4 \u0648F5) \u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0623\u0648\u0644.",
