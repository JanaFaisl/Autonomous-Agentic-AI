  "glossary": {
    "\u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u0645\u0632\u062f\u0648\u062c": "\u062d\u062c\u0632 \u0645\u0631\u064a\u0636\u064a\u0646 \u0623\u0648 \u0623\u0643\u062b\u0631 \u0644\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0632\u0645\u0646\u064a\u0629 \u0646\u0641\u0633\u0647\u0627 \u0645\u0639 \u0627\u0644\u0637\u0628\u064a\u0628 \u0646\u0641\u0633\u0647\u060c \u0648\u064a\u0645\u0646\u0639\u0647 \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u0642\u064a\u062f \u0641\u0631\u064a\u062f \u0639\u0644\u0649 (doctor_id, slot_date, start_time) \u0641\u064a time_slots \u0648\u0641\u0647\u0631\u0633 \u0641\u0631\u064a\u062f \u062c\u0632\u0626\u064a \u0639\u0644\u0649 appointments.time_slot_id \u0644\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u0645\u0624\u0643\u062f\u0629.",
    "\u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0632\u0645\u0646\u064a\u0629": "\u0648\u062d\u062f\u0629 \u0632\u0645\u0646\u064a\u0629 \u0641\u0639\u0644\u064a\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062d\u062c\u0632 \u0644\u0637\u0628\u064a\u0628 \u0641\u064a \u062a\u0627\u0631\u064a\u062e \u0645\u062d\u062f\u062f\u060c \u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a time_slots \u0628\u062d\u0627\u0644\u0629 available \u0623\u0648 booked \u0623\u0648 blocked\u060c \u0648\u0644\u0627 \u062a\u064f\u0639\u0631\u0636 \u0644\u0644\u0645\u0631\u0636\u0649 \u0625\u0644\u0627 \u0627\u0644\u0641\u062a\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629.",
    "\u0631\u0642\u0645 \u0627\u0644\u062a\u0623\u0643\u064a\u062f": "\u0631\u0642\u0645 \u0641\u0631\u064a\u062f \u064a\u064f\u0635\u062f\u0631\u0647 \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u0639\u062f \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062d\u062c\u0632 \u0645\u062b\u0644 APT-48215\u060c \u0648\u064a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a appointments.confirmation_number \u0648\u064a\u064f\u0639\u0631\u0636 \u0644\u0644\u0645\u0631\u064a\u0636 \u0643\u0625\u062b\u0628\u0627\u062a \u0644\u0644\u0645\u0648\u0639\u062f.",
    "\u062c\u062f\u0648\u0644 \u0627\u0644\u062f\u0648\u0627\u0645": "\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062f\u0648\u0627\u0645 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a\u0629 \u0627\u0644\u0645\u062a\u0643\u0631\u0631\u0629 \u0644\u0644\u0637\u0628\u064a\u0628 \u0641\u064a doctor_schedules\u060c \u0648\u064a\u062d\u062f\u062f\u0647\u0627 \u0627\u0644\u0637\u0628\u064a\u0628 \u0623\u0648 \u0645\u0648\u0638\u0641 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644\u060c \u0648\u062a\u064f\u0648\u0644\u064e\u0651\u062f \u0645\u0646\u0647\u0627 \u0627\u0644\u0641\u062a\u0631\u0627\u062a \u0627\u0644\u0632\u0645\u0646\u064a\u0629 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062d\u062c\u0632.",
    "JWT": "\u0631\u0645\u0632 \u0645\u0635\u0627\u062f\u0642\u0629 \u0645\u0645\u064a\u0632 \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u0625\u062b\u0628\u0627\u062a \u0647\u0648\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0633\u062c\u0651\u0644 \u0628\u0639\u062f \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u062a\u0637\u0628\u064a\u0642 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u062f\u0648\u0631 \u0639\u0644\u0649 \u0637\u0644\u0628\u0627\u062a REST API.",
    "\u0627\u0644\u062a\u0630\u0643\u064a\u0631": "\u0625\u0634\u0639\u0627\u0631 \u064a\u0631\u0633\u0644\u0647 \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0623\u0648 \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0646\u0635\u064a\u0629 \u0642\u0628\u0644 24 \u0633\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0645\u0624\u0643\u062f \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0627\u064b\u060c \u0648\u064a\u0645\u0643\u0646 \u062a\u063a\u064a\u064a\u0631 \u062a\u0648\u0642\u064a\u062a\u0647 \u0648\u0642\u0646\u0648\u0627\u062a\u0647 \u0645\u0646 notification_preferences."
  }
}