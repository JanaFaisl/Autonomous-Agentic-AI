    },
    {
      "severity": "Medium",
      "item": "\u0645\u0648\u0638\u0641 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644",
      "message": "\u064a\u062f\u0639\u0645 \u062c\u062f\u0648\u0644 appointments \u062d\u062c\u0632 \u0645\u0648\u0638\u0641 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0646\u064a\u0627\u0628\u0629 \u0639\u0646 \u0627\u0644\u0645\u0631\u064a\u0636 \u0639\u0628\u0631 booked_by_user_id\u060c \u0628\u064a\u0646\u0645\u0627 \u0644\u0627 \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0645\u0633\u0627\u0631 \u062d\u062c\u0632 \u0623\u0648 \u062a\u0639\u062f\u064a\u0644 \u0644\u0644\u0645\u0648\u0638\u0641\u060c \u0648\u064a\u0642\u062a\u0635\u0631 \u062f\u0648\u0631\u0647 \u0639\u0644\u0649 \u0639\u0631\u0636 \u0627\u0644\u062c\u062f\u0627\u0648\u0644."
