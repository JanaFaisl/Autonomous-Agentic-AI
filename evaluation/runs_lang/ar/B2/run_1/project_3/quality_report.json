  "issues": [
    {
      "severity": "Medium",
      "item": "\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a",
      "message": "\u064a\u0639\u0631\u0636 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u062a\u0628\u0648\u064a\u0628 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0639 \u0646\u0642\u0637\u0629 \u0648\u0634\u0627\u0631\u0629 \u0644\u063a\u064a\u0631 \u0627\u0644\u0645\u0642\u0631\u0648\u0621 \u0648\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0643\u0645\u0642\u0631\u0648\u0621\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u062e\u0644\u0648 \u062c\u062f\u0648\u0644 notifications \u0645\u0646 \u0623\u0639\u0645\u062f\u0629 \u0645\u062b\u0644 is_read \u0623\u0648 read_at\u060c \u0648\u062a\u0642\u062a\u0635\u0631 \u0642\u064a\u0645\u0629 channel \u0639\u0644\u0649 email \u0648sms."
    },
    {
      "severity": "Medium",
      "item": "\u0646\u0633\u064a\u062a \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631\u061f",
      "message": "\u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0631\u0627\u0628\u0637 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f\u060c \u0644\u0643\u0646 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0644\u0627 \u062a\u0630\u0643\u0631 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629\u060c \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062c\u062f\u0648\u0644 \u0623\u0648 \u0623\u0639\u0645\u062f\u0629 \u0644\u062a\u062e\u0632\u064a\u0646 \u0631\u0645\u0648\u0632 \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0648\u0635\u0644\u0627\u062d\u064a\u062a\u0647\u0627."
    },
    {
      "severity": "Medium",
      "item": "\u062d\u0641\u0638 \u0641\u064a \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0648\u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u0648\u0627\u0644\u062a\u0642\u064a\u064a\u0645",
      "message": "\u064a\u0639\u062a\u0645\u062f \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0639\u0644\u0649 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0648\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u062d\u0633\u0628 \u0627\u0644\u062c\u0646\u0633 \u0648\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u062e\u0628\u0631\u0629 \u0648\u0635\u0648\u0631 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0627\u0644\u0645\u0631\u0636\u0649\u060c \u0628\u064a\u0646\u0645\u0627 \u0644\u0627 \u062a\u0648\u062c\u062f \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0639\u0645\u062f\u0629 \u0623\u0648 \u062c\u062f\u0627\u0648\u0644 \u0645\u0642\u0627\u0628\u0644\u0629 (\u0645\u062b\u0644 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0648\u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0648\u062c\u0646\u0633 \u0627\u0644\u0637\u0628\u064a\u0628 \u0648\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u062e\u0628\u0631\u0629 \u0648\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0644\u0641) \u0648\u0644\u0627 \u062a\u0631\u062f \u0647\u0630\u0647 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a."
    },
    {
      "severity": "Medium",
      "item": "\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645",
