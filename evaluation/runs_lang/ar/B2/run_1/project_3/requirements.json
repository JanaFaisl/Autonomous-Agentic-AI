    {
      "id": "F5",
      "name": "\u0625\u062f\u0627\u0631\u0629 \u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u0623\u0637\u0628\u0627\u0621",
      "description": "\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0627\u0644\u0625\u062f\u0627\u0631\u064a\u064a\u0646 \u0645\u0646 \u062a\u062d\u062f\u064a\u062f \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062f\u0648\u0627\u0645 \u0648\u0639\u0631\u0636 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u0645\u062d\u062c\u0648\u0632\u0629.",
      "priority": "Medium",
      "user_stories": [
