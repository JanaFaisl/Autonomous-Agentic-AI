{
  "project_name": "\u0646\u0638\u0627\u0645 \u062d\u062c\u0632 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0641\u064a \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u0649",
  "features": [
    {
      "id": "F1",
      "name": "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u0631\u0636\u0649 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a",
      "description": "\u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u0644\u0644\u0645\u0631\u064a\u0636 \u0648\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u0625\u062f\u0627\u0631\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0647 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0628\u0623\u0645\u0627\u0646.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0631\u064a\u0636\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u062c\u062f\u064a\u062f \u062d\u062a\u0649 \u0623\u062a\u0645\u0643\u0646 \u0645\u0646 \u062d\u062c\u0632 \u0645\u0648\u0627\u0639\u064a\u062f\u064a \u0628\u0646\u0641\u0633\u064a.",
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0631\u064a\u0636\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u062a\u062d\u062f\u064a\u062b \u0628\u064a\u0627\u0646\u0627\u062a\u064a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u062d\u062a\u0649 \u062a\u0628\u0642\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u064a \u062f\u0642\u064a\u0642\u0629 \u0644\u062f\u0649 \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u0649."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0645\u0631\u064a\u0636 \u0623\u062f\u062e\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0635\u062d\u064a\u062d\u0629\u060c \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u062a\u0633\u062c\u064a\u0644\u060c \u064a\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u0625\u0631\u0633\u0627\u0644 \u0631\u0633\u0627\u0644\u0629 \u062a\u0623\u0643\u064a\u062f.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0645\u0631\u064a\u0636 \u0633\u062c\u0651\u0644 \u0627\u0644\u062f\u062e\u0648\u0644\u060c \u0639\u0646\u062f \u062a\u0639\u062f\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a\u0647 \u0648\u062d\u0641\u0638\u0647\u0627\u060c \u062a\u0638\u0647\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0641\u064a \u0645\u0644\u0641\u0647 \u0627\u0644\u0634\u062e\u0635\u064a."
      ]
    },
    {
      "id": "F2",
      "name": "\u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0639\u0631\u0636 \u0627\u0644\u062c\u062f\u0627\u0648\u0644",
      "description": "\u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u062d\u0633\u0628 \u0627\u0644\u062a\u062e\u0635\u0635 \u0623\u0648 \u0627\u0644\u0627\u0633\u0645 \u0648\u0639\u0631\u0636 \u0623\u0648\u0642\u0627\u062a\u0647\u0645 \u0627\u0644\u0645\u062a\u0627\u062d\u0629.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0631\u064a\u0636\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0637\u0628\u064a\u0628 \u062d\u0633\u0628 \u0627\u0644\u062a\u062e\u0635\u0635 \u062d\u062a\u0649 \u0623\u062c\u062f \u0627\u0644\u0637\u0628\u064a\u0628 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u062d\u0627\u0644\u062a\u064a.",
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0631\u064a\u0636\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u0639\u0631\u0636 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0644\u0644\u0637\u0628\u064a\u0628 \u062d\u062a\u0649 \u0623\u062e\u062a\u0627\u0631 \u0645\u0648\u0639\u062f\u0627\u064b \u064a\u0646\u0627\u0633\u0628\u0646\u064a."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0648\u062c\u0648\u062f \u0623\u0637\u0628\u0627\u0621 \u0641\u064a \u062a\u062e\u0635\u0635 \u0645\u0639\u064a\u0646\u060c \u0639\u0646\u062f \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u062a\u062e\u0635\u0635\u060c \u062a\u0638\u0647\u0631 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0627\u0644\u0645\u062a\u0627\u062d\u064a\u0646 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u062a\u062e\u0635\u0635.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0645\u0631\u064a\u0636 \u0627\u062e\u062a\u0627\u0631 \u0637\u0628\u064a\u0628\u0627\u064b\u060c \u0639\u0646\u062f \u0641\u062a\u062d \u062c\u062f\u0648\u0644\u0647\u060c \u062a\u0638\u0647\u0631 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0641\u0642\u0637 \u062f\u0648\u0646 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0645\u062d\u062c\u0648\u0632\u0629."
      ]
    },
    {
      "id": "F3",
      "name": "\u062d\u062c\u0632 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0648\u0625\u062f\u0627\u0631\u062a\u0647\u0627",
      "description": "\u062d\u062c\u0632 \u0645\u0648\u0639\u062f \u0645\u0639 \u0637\u0628\u064a\u0628 \u0648\u062a\u0639\u062f\u064a\u0644\u0647 \u0623\u0648 \u0625\u0644\u063a\u0627\u0624\u0647 \u0645\u0639 \u0645\u0646\u0639 \u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u0645\u0632\u062f\u0648\u062c \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0648\u0642\u062a.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0631\u064a\u0636\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u062d\u062c\u0632 \u0645\u0648\u0639\u062f \u0645\u0639 \u0637\u0628\u064a\u0628 \u062d\u062a\u0649 \u0623\u0636\u0645\u0646 \u0632\u064a\u0627\u0631\u062a\u064a \u0641\u064a \u0648\u0642\u062a \u0645\u062d\u062f\u062f.",
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0631\u064a\u0636\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u062a\u0639\u062f\u064a\u0644 \u0645\u0648\u0639\u062f\u064a \u0623\u0648 \u0625\u0644\u063a\u0627\u0621\u0647 \u062d\u062a\u0649 \u0623\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0638\u0631\u0648\u0641 \u0627\u0644\u0637\u0627\u0631\u0626\u0629."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062e\u062a\u0627\u0631 \u0645\u062a\u0627\u062d\u060c \u0639\u0646\u062f \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062d\u062c\u0632\u060c \u064a\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0645\u0648\u0639\u062f \u0648\u0639\u0631\u0636 \u0631\u0642\u0645 \u062a\u0623\u0643\u064a\u062f \u0644\u0644\u0645\u0631\u064a\u0636.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0648\u0642\u062a \u0645\u062d\u062c\u0648\u0632 \u0645\u0633\u0628\u0642\u0627\u064b\u060c \u0639\u0646\u062f \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u062d\u062c\u0632\u060c \u064a\u0631\u0641\u0636 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0648\u064a\u0639\u0631\u0636 \u0623\u0648\u0642\u0627\u062a\u0627\u064b \u0628\u062f\u064a\u0644\u0629."
      ]
