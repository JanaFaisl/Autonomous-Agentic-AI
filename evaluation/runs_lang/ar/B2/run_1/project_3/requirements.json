    {
      "id": "F4",
      "name": "\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u062a\u0630\u0643\u064a\u0631\u0627\u062a",
      "description": "\u0625\u0631\u0633\u0627\u0644 \u062a\u0623\u0643\u064a\u062f\u0627\u062a \u0648\u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0628\u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0644\u0644\u0645\u0631\u0636\u0649 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0623\u0648 \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0646\u0635\u064a\u0629.",
      "priority": "Medium",
      "user_stories": [
