        "\u0628\u0635\u0641\u062a\u064a \u0645\u0631\u064a\u0636\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u0627\u0633\u062a\u0644\u0627\u0645 \u0625\u0634\u0639\u0627\u0631 \u0639\u0646\u062f \u062a\u063a\u064a\u064a\u0631 \u0645\u0648\u0639\u062f\u064a \u062d\u062a\u0649 \u0623\u0643\u0648\u0646 \u0639\u0644\u0649 \u0639\u0644\u0645 \u0628\u0627\u0644\u062a\u062d\u062f\u064a\u062b\u0627\u062a."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0648\u062c\u0648\u062f \u0645\u0648\u0639\u062f \u0645\u0624\u0643\u062f\u060c \u0639\u0646\u062f\u0645\u0627 \u064a\u062a\u0628\u0642\u0649 24 \u0633\u0627\u0639\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0639\u062f\u060c \u064a\u0631\u0633\u0644 \u0627\u0644\u0646\u0638\u0627\u0645 \u062a\u0630\u0643\u064a\u0631\u0627\u064b \u0644\u0644\u0645\u0631\u064a\u0636.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0637\u0628\u064a\u0628 \u0623\u0644\u063a\u0649 \u0645\u0648\u0639\u062f\u0627\u064b\u060c \u0639\u0646\u062f \u0627\u0644\u0625\u0644\u063a\u0627\u0621\u060c \u064a\u0635\u0644 \u0627\u0644\u0645\u0631\u064a\u0636 \u0625\u0634\u0639\u0627\u0631 \u0641\u0648\u0631\u064a \u064a\u062a\u0636\u0645\u0646 \u062e\u064a\u0627\u0631 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062d\u062c\u0632."
