{
  "project_name": "\u0645\u0646\u0635\u0629 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629",
  "features": [
    {
      "id": "F1",
      "name": "\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0637\u0644\u0627\u0628 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629",
      "description": "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0637\u0644\u0627\u0628 \u0628\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u062c\u0627\u0645\u0639\u064a \u0648\u0625\u0646\u0634\u0627\u0621 \u0645\u0644\u0641 \u0634\u062e\u0635\u064a \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0648\u0627\u0644\u062a\u062e\u0635\u0635.",
      "priority": "High",
      "user_stories": [
        "As a \u0637\u0627\u0644\u0628, I can \u0633\u062c\u0651\u0644 \u0628\u062d\u0633\u0627\u0628\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u064a so that \u0623\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0646\u0635\u0629 \u0628\u0647\u0648\u064a\u0629 \u0645\u0648\u062b\u0648\u0642\u0629.",
        "As a \u0637\u0627\u0644\u0628, I can \u0639\u062f\u0651\u0644 \u0645\u0644\u0641\u064a \u0627\u0644\u0634\u062e\u0635\u064a so that \u064a\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0651 \u0632\u0645\u0644\u0627\u0626\u064a \u062d\u0633\u0628 \u062a\u062e\u0635\u0635\u064a."
      ],
      "acceptance_criteria": [
        "Given \u0628\u0631\u064a\u062f \u062c\u0627\u0645\u0639\u064a \u0635\u0627\u0644\u062d, When \u0623\u0631\u0633\u0644 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062a\u0633\u062c\u064a\u0644, Then \u064a\u064f\u0646\u0634\u0623 \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u064a\u0635\u0644 \u0631\u0627\u0628\u0637 \u062a\u0641\u0639\u064a\u0644.",
        "Given \u0637\u0627\u0644\u0628 \u0645\u0633\u062c\u0651\u0644 \u0627\u0644\u062f\u062e\u0648\u0644, When \u0623\u062d\u0641\u0638 \u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u0644\u0641, Then \u062a\u0638\u0647\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0641\u0648\u0631\u0627\u064b."
      ]
    },
    {
      "id": "F2",
      "name": "\u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629",
      "description": "\u0631\u0641\u0639 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0628\u0635\u064a\u063a \u0645\u062e\u062a\u0644\u0641\u0629 \u0648\u0631\u0628\u0637\u0647\u0627 \u0628\u0627\u0644\u0645\u0642\u0631\u0631 \u0627\u0644\u062f\u0631\u0627\u0633\u064a \u0648\u062a\u062d\u062f\u064a\u062f \u062e\u0635\u0648\u0635\u064a\u062a\u0647\u0627.",
      "priority": "High",
      "user_stories": [
        "As a \u0637\u0627\u0644\u0628, I can \u0627\u0631\u0641\u0639 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0645\u062d\u0627\u0636\u0631\u0629 so that \u064a\u0633\u062a\u0641\u064a\u062f \u0645\u0646\u0647\u0627 \u0632\u0645\u0644\u0627\u0626\u064a \u0641\u064a \u0627\u0644\u0645\u0642\u0631\u0631.",
        "As a \u0637\u0627\u0644\u0628, I can \u0623\u062d\u0645\u0651\u0644 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u063a\u064a\u0631\u064a so that \u0623\u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0642\u0631\u0631 \u0628\u0633\u0647\u0648\u0644\u0629."
      ],
      "acceptance_criteria": [
        "Given \u0645\u0644\u0641 \u0628\u0635\u064a\u063a\u0629 PDF \u0623\u0648 \u0635\u0648\u0631\u0629, When \u0623\u0631\u0641\u0639\u0647 \u0645\u0639 \u0627\u0633\u0645 \u0627\u0644\u0645\u0642\u0631\u0631, Then \u064a\u0638\u0647\u0631 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0642\u0631\u0631.",
        "Given \u0645\u0644\u0627\u062d\u0638\u0629 \u0645\u0646\u0634\u0648\u0631\u0629, When \u0623\u0636\u063a\u0637 \u062a\u062d\u0645\u064a\u0644, Then \u064a\u0628\u062f\u0623 \u062a\u0646\u0632\u064a\u0644 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0623\u0635\u0644\u064a \u062f\u0648\u0646 \u0623\u062e\u0637\u0627\u0621."
      ]
    },
    {
      "id": "F3",
      "name": "\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629",
      "description": "\u0625\u0646\u0634\u0627\u0621 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u062f\u0631\u0627\u0633\u064a\u0629 \u0639\u0627\u0645\u0629 \u0623\u0648 \u062e\u0627\u0635\u0629 \u0648\u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0625\u0644\u064a\u0647\u0627 \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u062f\u0627\u062e\u0644\u0647\u0627.",
      "priority": "High",
      "user_stories": [
        "As a \u0637\u0627\u0644\u0628, I can \u0623\u0646\u0634\u0626 \u0645\u062c\u0645\u0648\u0639\u0629 \u0644\u0645\u0642\u0631\u0631 \u0645\u0639\u064a\u0651\u0646 so that \u0623\u062f\u0631\u0633 \u0645\u0639 \u0632\u0645\u0644\u0627\u0626\u064a \u0628\u0634\u0643\u0644 \u0645\u0646\u0638\u0645.",
        "As a \u0645\u0634\u0631\u0641 \u0645\u062c\u0645\u0648\u0639\u0629, I can \u0623\u062f\u064a\u0631 \u0627\u0644\u0623\u0639\u0636\u0627\u0621 \u0648\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 so that \u0623\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u062c\u0648\u062f\u0629 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629."
      ],
      "acceptance_criteria": [
