    "\u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0623\u0648 \u0636\u062e\u0627\u0645\u0629 \u0627\u0644\u0646\u0637\u0627\u0642: \u0639\u062f\u062f \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0643\u0628\u064a\u0631 \u0644\u0645\u0637\u0648\u0631 \u0648\u0627\u062d\u062f \u0623\u0648 \u0641\u0631\u064a\u0642 \u0635\u063a\u064a\u0631\u060c \u0644\u0630\u0627 \u062a\u064f\u0624\u062c\u064e\u0651\u0644 \u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0629 (F4 \u0648F5) \u0639\u0646\u062f \u0627\u0644\u062a\u0623\u062e\u0631.",
    "\u0639\u062f\u0645 \u062f\u0642\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u062c\u0627\u0645\u0639\u064a \u0628\u0633\u0628\u0628 \u0627\u062e\u062a\u0644\u0627\u0641 \u0646\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062c\u0627\u0645\u0639\u0627\u062a\u060c \u0648\u064a\u064f\u0639\u0627\u0644\u064e\u062c \u0628\u0642\u0627\u0626\u0645\u0629 \u0646\u0637\u0627\u0642\u0627\u062a \u0645\u0639\u062a\u0645\u062f\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u062d\u062f\u064a\u062b.",
    "\u062e\u0637\u0631 \u062a\u0633\u0631\u0628 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629 \u0623\u0648 \u062d\u0642\u0648\u0642 \u0627\u0644\u0646\u0634\u0631 \u0641\u064a \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0631\u0641\u0648\u0639\u0629\u060c \u0648\u064a\u064f\u0639\u0627\u0644\u064e\u062c \u0628\u0631\u0648\u0627\u0628\u0637 S3 \u0645\u0648\u0642\u0639\u0629 \u0645\u0624\u0642\u062a\u0629 \u0648\u0641\u062d\u0635 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0641\u064a \u0627\u0644\u062e\u0627\u062f\u0645 \u0648\u0646\u0638\u0627\u0645 \u0627\u0644\u0625\u0628\u0644\u0627\u063a.",
    "\u0636\u063a\u0637 \u0627\u0644\u0623\u062f\u0627\u0621 \u0639\u0646\u062f \u0631\u0641\u0639 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0648\u062a\u062d\u0645\u064a\u0644\u0647\u0627 \u0645\u0639 500 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062a\u0632\u0627\u0645\u0646\u060c \u0648\u064a\u064f\u0639\u0627\u0644\u064e\u062c \u0628\u062a\u062d\u062f\u064a\u062f \u062d\u062c\u0645 \u0627\u0644\u0645\u0644\u0641 \u0648\u0627\u0644\u0631\u0641\u0639 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0625\u0644\u0649 S3 \u0648\u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0645\u0624\u0642\u062a.",
    "\u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u062d\u0630\u0641 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628 \u062e\u0644\u0627\u0644 30 \u064a\u0648\u0645\u0627\u064b \u0642\u062f \u064a\u062a\u0623\u062e\u0631 \u062f\u0648\u0646 \u0645\u0647\u0645\u0629 \u0645\u062c\u062f\u0648\u0644\u0629\u060c \u0648\u062a\u064f\u0636\u0627\u0641 \u0645\u0647\u0645\u0629 \u062f\u0648\u0631\u064a\u0629 \u0644\u0644\u062d\u0630\u0641 \u0648\u062a\u064f\u062e\u062a\u0628\u0631."
  ]
}