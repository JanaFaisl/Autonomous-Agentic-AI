  "glossary": {
    "\u0627\u0644\u0628\u0627\u0642\u0629": "\u0645\u0646\u062a\u062c \u0645\u0646 \u0646\u0648\u0639 bundle \u064a\u062a\u0643\u0648\u0651\u0646 \u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0631\u0648\u062f \u0628\u0643\u0645\u064a\u0627\u062a \u0645\u062d\u062f\u062f\u0629\u060c \u0648\u062a\u064f\u062d\u062f\u064e\u0651\u062f \u0645\u0643\u0648\u0646\u0627\u062a\u0647\u0627 \u0641\u064a \u062c\u062f\u0648\u0644 bundle_items.",
    "\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u062a\u062c\u0631": "\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0630\u0648 \u0627\u0644\u062f\u0648\u0631 store_admin \u0627\u0644\u0630\u064a \u064a\u062f\u064a\u0631 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0648\u064a\u0639\u064a\u0651\u0646 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0644\u0645\u0646\u062f\u0648\u0628\u064a \u0627\u0644\u062a\u0648\u0635\u064a\u0644.",
    "\u0645\u0646\u062f\u0648\u0628 \u0627\u0644\u062a\u0648\u0635\u064a\u0644": "\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0630\u0648 \u0627\u0644\u062f\u0648\u0631 courier \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u0644\u0645 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0639\u064a\u0651\u0646\u0629 \u0644\u0647 \u0648\u064a\u062d\u062f\u0651\u062b \u062d\u0627\u0644\u062a\u0647\u0627\u060c \u0648\u064a\u064f\u0633\u0645\u062d \u0644\u0647 \u0648\u062d\u062f\u0647 \u0628\u0631\u0624\u064a\u0629 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0639\u0645\u064a\u0644 \u0648\u0631\u0642\u0645 \u062c\u0648\u0627\u0644\u0647 \u0644\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0639\u064a\u0651\u0646 \u0644\u0647.",
    "\u062a\u062a\u0628\u0639 \u0627\u0644\u0637\u0644\u0628": "\u0645\u062a\u0627\u0628\u0639\u0629 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u0644\u062d\u0638\u0629 \u0628\u0644\u062d\u0638\u0629 \u0639\u0628\u0631 \u0645\u0631\u0627\u062d\u0644\u0647 \u0648\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u062a\u0642\u0631\u064a\u0628\u064a \u0644\u0644\u0645\u0646\u062f\u0648\u0628\u060c \u0645\u0639 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062a\u0635\u0644 \u062e\u0644\u0627\u0644 10 \u062b\u0648\u0627\u0646\u064d \u0645\u0646 \u062a\u063a\u064a\u0651\u0631 \u0627\u0644\u062d\u0627\u0644\u0629.",
    "\u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u0641\u0648\u0631\u064a": "\u0631\u0633\u0627\u0644\u0629 \u062a\u064f\u0631\u0633\u0644 \u0625\u0644\u0649 \u062c\u0647\u0627\u0632 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0628\u0631 Firebase Cloud Messaging \u0644\u0625\u0639\u0644\u0627\u0645\u0647 \u0628\u062a\u063a\u064a\u0651\u0631 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u0623\u0648 \u0628\u062a\u0639\u064a\u064a\u0646 \u0637\u0644\u0628 \u062c\u062f\u064a\u062f.",
    "\u0644\u0642\u0637\u0629 \u0627\u0644\u0637\u0644\u0628": "\u0646\u0633\u062e\u0629 \u0645\u0646 \u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u062a\u062c \u0648\u0633\u0639\u0631\u0647 \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u062a\u064f\u062d\u0641\u0638 \u062f\u0627\u062e\u0644 \u0627\u0644\u0637\u0644\u0628 \u0648\u0642\u062a \u0627\u0644\u062a\u0623\u0643\u064a\u062f\u060c \u062d\u062a\u0649 \u0644\u0627 \u062a\u062a\u0623\u062b\u0631 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0628\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0623\u0648 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646 \u0644\u0627\u062d\u0642\u064b\u0627."
  }
}