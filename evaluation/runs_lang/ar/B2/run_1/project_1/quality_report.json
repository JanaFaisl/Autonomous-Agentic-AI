  "issues": [
    {
      "severity": "Medium",
      "item": "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u0627\u0644\u062a\u0633\u062c\u064a\u0644",
      "message": "\u064a\u0634\u062a\u0631\u0637 \u0645\u0639\u064a\u0627\u0631 F4 \u062a\u0633\u062c\u064a\u0644 \u062f\u062e\u0648\u0644 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0648\u064a\u062d\u062a\u0648\u064a \u062c\u062f\u0648\u0644 users \u0639\u0644\u0649 password_hash\u060c \u0644\u0643\u0646 \u0644\u0627 \u062a\u0648\u062c\u062f \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0623\u0648 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0634\u0627\u0634\u0629 \u0623\u0648 \u0645\u064a\u0632\u0629 \u0644\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0639\u0645\u064a\u0644 \u0648\u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0648\u0627\u0644\u0645\u0646\u062f\u0648\u0628."
    },
    {
      "severity": "Medium",
      "item": "\u0645\u0631\u0627\u062d\u0644 \u0627\u0644\u0637\u0644\u0628 \u0648\u062d\u0627\u0644\u0627\u062a orders.status",
      "message": "\u0645\u0631\u0627\u062d\u0644 \u0627\u0644\u062a\u062a\u0628\u0639 \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0623\u0631\u0628\u0639 (\u062a\u0645 \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645\u060c \u0642\u064a\u062f \u0627\u0644\u062a\u062c\u0647\u064a\u0632\u060c \u0641\u064a \u0627\u0644\u0637\u0631\u064a\u0642\u060c \u062a\u0645 \u0627\u0644\u062a\u0633\u0644\u064a\u0645) \u0628\u064a\u0646\u0645\u0627 \u062a\u0636\u0645 orders.status \u0633\u0628\u0639 \u0642\u064a\u0645 (pending \u0648confirmed \u0648assigned \u0648picked_up \u0648out_for_delivery \u0648delivered \u0648cancelled) \u0628\u0644\u0627 \u062c\u062f\u0648\u0644 \u0631\u0628\u0637\u060c \u0643\u0645\u0627 \u0623\u0646 \u0632\u0631 \"\u062a\u0645 \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u0645\u0646 \u0627\u0644\u0645\u062a\u062c\u0631\" \u064a\u0646\u0642\u0644 \u0627\u0644\u062d\u0627\u0644\u0629 \u0625\u0644\u0649 \"\u0641\u064a \u0627\u0644\u0637\u0631\u064a\u0642\" \u0641\u0644\u0627 \u064a\u062a\u0636\u062d \u0647\u0644 \u064a\u0642\u0627\u0628\u0644 picked_up \u0623\u0645 out_for_delivery."
    },
    {
      "severity": "Medium",
      "item": "\u0628\u0627\u0642\u0629 \u0627\u0644\u0623\u0633\u0628\u0648\u0639",
      "message": "\u062a\u0639\u0631\u0636 \u0628\u0637\u0627\u0642\u0629 \"\u0628\u0627\u0642\u0629 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\" \u0634\u0627\u0631\u0629 \u062e\u0635\u0645 '-20%' \u0648\u0633\u0639\u0631\u0627\u064b \u0645\u062e\u0641\u0636\u0627\u064b\u060c \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0648\u0644\u0627 \u0641\u064a \u062c\u062f\u0648\u0644 products \u0623\u064a \u062d\u0642\u0644 \u0644\u0644\u062e\u0635\u0645 \u0623\u0648 \u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0623\u0635\u0644\u064a \u0623\u0648 \u0627\u0644\u0639\u0631\u0648\u0636."
    },
    {
      "severity": "Medium",
      "item": "\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0646\u062f\u0648\u0628",
      "message": "\u062a\u0639\u0631\u0636 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0641\u064a \u062a\u062a\u0628\u0639 \u0627\u0644\u0637\u0644\u0628 \u0635\u0648\u0631\u062a\u0647 \u0648\u062a\u0642\u064a\u064a\u0645\u0647 \u0648\u0627\u0633\u0645\u0647\u060c \u0648\u0644\u0627 \u064a\u062d\u062a\u0648\u064a \u062c\u062f\u0648\u0644 users \u0639\u0644\u0649 \u0639\u0645\u0648\u062f \u0644\u0644\u0635\u0648\u0631\u0629 \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u062c\u062f\u0648\u0644 \u0623\u0648 \u0639\u0645\u0648\u062f \u0644\u0644\u062a\u0642\u064a\u064a\u0645."
    },
    {
      "severity": "Medium",
      "item": "\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u064a\u0648\u0645",
      "message": "\u062a\u0639\u0631\u0636 \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u062a\u062c\u0631 \u0645\u0624\u0634\u0631 \"\u0645\u062e\u0632\u0648\u0646 \u0645\u0646\u062e\u0641\u0636\" \u0648\u062a\u062a\u062d\u0648\u0644 \u0634\u0627\u0631\u0629 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0625\u0644\u0649 \u0627\u0644\u0628\u0631\u062a\u0642\u0627\u0644\u064a\u060c \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u0641\u064a products \u062d\u062f \u0623\u062f\u0646\u0649 \u0644\u0644\u0645\u062e\u0632\u0648\u0646 (low_stock_threshold) \u064a\u062d\u062f\u062f \u0645\u062a\u0649 \u062a\u0646\u062e\u0641\u0636 \u0627\u0644\u0643\u0645\u064a\u0629."
    },
    {
      "severity": "Medium",
      "item": "courier_locations",
      "message": "\u0644\u0627 \u062a\u062a\u0636\u0645\u0646 \u0634\u0627\u0634\u0629 \"\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0646\u062f\u0648\u0628\" \u0645\u0643\u0648\u0646\u0627\u064b \u0644\u0625\u0631\u0633\u0627\u0644 \u0645\u0648\u0642\u0639\u0647 \u0631\u063a\u0645 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u062a\u062a\u0628\u0639 \u0641\u064a F3 \u0639\u0644\u0649 courier_locations\u060c \u0643\u0645\u0627 \u0623\u0646 \u0639\u0645\u0648\u062f id \u0645\u0646 \u0646\u0648\u0639 bigint \u0628\u0644\u0627 \u0642\u064a\u0645\u0629 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0623\u0648 \u062a\u0639\u0631\u064a\u0641 identity \u0644\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u062a\u0633\u0644\u0633\u0644\u064a."
    }
  ],
  "required_fixes": [
    "\u0625\u0636\u0627\u0641\u0629 \u0645\u064a\u0632\u0629 \u0648\u0634\u0627\u0634\u0627\u062a \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0648\u0627\u0644\u062a\u0635\u0645\u064a\u0645\u060c \u0648\u062a\u062d\u062f\u064a\u062f \u0627\u0644\u062a\u0646\u0642\u0644 \u0627\u0644\u062e\u0627\u0635 \u0628\u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0648\u0627\u0644\u0645\u0646\u062f\u0648\u0628.",
    "\u062a\u0648\u062b\u064a\u0642 \u0627\u0644\u0631\u0628\u0637 \u0628\u064a\u0646 \u0645\u0631\u0627\u062d\u0644 \u0627\u0644\u062a\u062a\u0628\u0639 \u0627\u0644\u0623\u0631\u0628\u0639 \u0648\u0642\u064a\u0645 orders.status\u060c \u0648\u062a\u062d\u062f\u064a\u062f \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u064a \u064a\u0646\u062a\u062c\u0647\u0627 \u0632\u0631 \"\u062a\u0645 \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u0645\u0646 \u0627\u0644\u0645\u062a\u062c\u0631\".",
    "\u0625\u0636\u0627\u0641\u0629 \u062d\u0642\u0648\u0644 \u0627\u0644\u062e\u0635\u0645 \u0648\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0623\u0635\u0644\u064a \u0648\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0648\u062a\u0642\u064a\u064a\u0645\u0647 \u0648\u062d\u062f \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0627\u0644\u0645\u0646\u062e\u0641\u0636 \u0625\u0644\u0649 \u0627\u0644\u0645\u062e\u0637\u0637\u060c \u0623\u0648 \u0625\u0632\u0627\u0644\u0629 \u0647\u0630\u0647 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0645\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645.",
    "\u062a\u062d\u062f\u064a\u062f \u0622\u0644\u064a\u0629 \u0625\u0631\u0633\u0627\u0644 \u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0641\u064a \u062a\u0635\u0645\u064a\u0645 \"\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0646\u062f\u0648\u0628\"\u060c \u0648\u062a\u0639\u0631\u064a\u0641 id \u0641\u064a courier_locations \u0643\u0645\u0639\u0631\u0651\u0641 \u062a\u0633\u0644\u0633\u0644\u064a (identity \u0623\u0648 sequence)."
  ],
  "recommendations": [
