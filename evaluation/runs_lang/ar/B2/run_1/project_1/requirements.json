{
  "project_name": "\u062a\u0637\u0628\u064a\u0642 \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0648\u0631\u0648\u062f",
  "features": [
    {
      "id": "F1",
      "name": "\u062a\u0635\u0641\u062d \u0627\u0644\u0648\u0631\u0648\u062f",
      "description": "\u0639\u0631\u0636 \u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u0627\u0644\u0628\u0627\u0642\u0627\u062a \u0645\u0639 \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631.",
      "priority": "High",
      "user_stories": [
        "As a \u0639\u0645\u064a\u0644, I can \u062a\u0635\u0641\u062d \u0627\u0644\u0648\u0631\u0648\u062f \u062d\u0633\u0628 \u0627\u0644\u0646\u0648\u0639 \u0648\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 so that \u0623\u062c\u062f \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0628\u0633\u0631\u0639\u0629.",
        "As a \u0639\u0645\u064a\u0644, I can \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0648\u0631\u062f\u0629 \u0623\u0648 \u0628\u0627\u0642\u0629 \u0628\u0627\u0644\u0627\u0633\u0645 so that \u0623\u0635\u0644 \u0625\u0644\u0649 \u0645\u0627 \u0623\u0631\u064a\u062f\u0647 \u0645\u0628\u0627\u0634\u0631\u0629."
      ],
      "acceptance_criteria": [
        "Given \u0641\u062a\u062d \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642, When \u064a\u062e\u062a\u0627\u0631 \u062a\u0635\u0646\u064a\u0641\u064b\u0627, Then \u062a\u0638\u0647\u0631 \u0627\u0644\u0648\u0631\u0648\u062f \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0645\u0639 \u0627\u0644\u0635\u0648\u0631\u0629 \u0648\u0627\u0644\u0633\u0639\u0631.",
        "Given \u0648\u062c\u0648\u062f \u0643\u0644\u0645\u0629 \u0628\u062d\u062b, When \u064a\u0636\u063a\u0637 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u0628\u062d\u062b, Then \u062a\u064f\u0639\u0631\u0636 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u062e\u0644\u0627\u0644 \u062b\u0627\u0646\u064a\u062a\u064a\u0646."
      ]
    },
    {
      "id": "F2",
      "name": "\u0633\u0644\u0629 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0637\u0644\u0628",
      "description": "\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0648\u0625\u062f\u062e\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0648\u0645\u0648\u0639\u062f\u0647 \u062b\u0645 \u0627\u0644\u062f\u0641\u0639 \u0648\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0637\u0644\u0628.",
      "priority": "High",
      "user_stories": [
        "As a \u0639\u0645\u064a\u0644, I can \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0648\u0631\u0648\u062f \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0648\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0643\u0645\u064a\u0627\u062a so that \u0623\u062a\u062d\u0643\u0645 \u0641\u064a \u0637\u0644\u0628\u064a \u0642\u0628\u0644 \u0627\u0644\u062a\u0623\u0643\u064a\u062f.",
        "As a \u0639\u0645\u064a\u0644, I can \u0625\u062f\u062e\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0648\u0645\u0648\u0639\u062f\u0647 \u0648\u062f\u0641\u0639 \u0642\u064a\u0645\u0629 \u0627\u0644\u0637\u0644\u0628 so that \u064a\u0635\u0644\u0646\u064a \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0646\u0627\u0633\u0628."
      ],
      "acceptance_criteria": [
        "Given \u0648\u062c\u0648\u062f \u0645\u0646\u062a\u062c\u0627\u062a \u0641\u064a \u0627\u0644\u0633\u0644\u0629, When \u064a\u0624\u0643\u062f \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0637\u0644\u0628 \u0628\u0639\u062f \u0627\u0644\u062f\u0641\u0639, Then \u064a\u064f\u0646\u0634\u0623 \u0627\u0644\u0637\u0644\u0628 \u0648\u064a\u0638\u0647\u0631 \u0631\u0642\u0645\u0647 \u0644\u0644\u0639\u0645\u064a\u0644.",
        "Given \u0639\u0646\u0648\u0627\u0646 \u062a\u0648\u0635\u064a\u0644 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644, When \u064a\u062d\u0627\u0648\u0644 \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u062a\u0623\u0643\u064a\u062f, Then \u062a\u0638\u0647\u0631 \u0631\u0633\u0627\u0644\u0629 \u062a\u0637\u0644\u0628 \u0627\u0633\u062a\u0643\u0645\u0627\u0644 \u0627\u0644\u0639\u0646\u0648\u0627\u0646."
      ]
    },
    {
      "id": "F3",
      "name": "\u062a\u062a\u0628\u0639 \u0627\u0644\u0637\u0644\u0628 \u0648\u0627\u0644\u062a\u0648\u0635\u064a\u0644",
      "description": "\u0645\u062a\u0627\u0628\u0639\u0629 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u062d\u062a\u0649 \u0648\u0635\u0648\u0644\u0647 \u0625\u0644\u0649 \u0628\u0627\u0628 \u0627\u0644\u0639\u0645\u064a\u0644 \u0645\u0639 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0641\u0648\u0631\u064a\u0629.",
      "priority": "High",
      "user_stories": [
        "As a \u0639\u0645\u064a\u0644, I can \u0645\u062a\u0627\u0628\u0639\u0629 \u062d\u0627\u0644\u0629 \u0637\u0644\u0628\u064a \u0644\u062d\u0638\u0629 \u0628\u0644\u062d\u0638\u0629 so that \u0623\u0639\u0631\u0641 \u0645\u0648\u0639\u062f \u0648\u0635\u0648\u0644\u0647 \u0625\u0644\u0649 \u0628\u0627\u0628 \u0645\u0646\u0632\u0644\u064a.",
        "As a \u0645\u0646\u062f\u0648\u0628 \u062a\u0648\u0635\u064a\u0644, I can \u062a\u062d\u062f\u064a\u062b \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u0639\u0646\u062f \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u0648\u0627\u0644\u062a\u0633\u0644\u064a\u0645 so that \u064a\u0628\u0642\u0649 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0644\u0649 \u0627\u0637\u0644\u0627\u0639."
      ],
      "acceptance_criteria": [
        "Given \u0637\u0644\u0628 \u0642\u064a\u062f \u0627\u0644\u062a\u0648\u0635\u064a\u0644, When \u064a\u0641\u062a\u062d \u0627\u0644\u0639\u0645\u064a\u0644 \u0635\u0641\u062d\u0629 \u0627\u0644\u0637\u0644\u0628, Then \u062a\u0638\u0647\u0631 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0648\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u062a\u0642\u0631\u064a\u0628\u064a \u0644\u0644\u0645\u0646\u062f\u0648\u0628.",
        "Given \u062a\u063a\u064a\u0631\u062a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628, When \u064a\u062d\u062f\u0651\u062b\u0647\u0627 \u0627\u0644\u0645\u0646\u062f\u0648\u0628, Then \u064a\u0635\u0644 \u0627\u0644\u0639\u0645\u064a\u0644 \u0625\u0634\u0639\u0627\u0631 \u062e\u0644\u0627\u0644 10 \u062b\u0648\u0627\u0646\u064d."
      ]
