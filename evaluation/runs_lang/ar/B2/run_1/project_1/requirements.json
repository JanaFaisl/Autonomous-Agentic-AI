    {
      "id": "F4",
      "name": "\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u0637\u0644\u0628\u0627\u062a",
      "description": "\u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 \u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u062a\u062c\u0631 \u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0644\u0644\u0645\u0646\u062f\u0648\u0628\u064a\u0646.",
      "priority": "Medium",
      "user_stories": [
        "As a \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u062a\u062c\u0631, I can \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u062a\u0639\u062f\u064a\u0644 \u0623\u0633\u0639\u0627\u0631\u0647\u0627 \u0648\u0645\u062e\u0632\u0648\u0646\u0647\u0627 so that \u064a\u0628\u0642\u0649 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0645\u062d\u062f\u062b\u064b\u0627.",
        "As a \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u062a\u062c\u0631, I can \u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0644\u0645\u0646\u062f\u0648\u0628\u064a \u0627\u0644\u062a\u0648\u0635\u064a\u0644 so that \u062a\u064f\u0646\u0641\u0630 \u0641\u064a \u0645\u0648\u0639\u062f\u0647\u0627."
      ],
      "acceptance_criteria": [
        "Given \u062a\u0633\u062c\u064a\u0644 \u062f\u062e\u0648\u0644 \u0627\u0644\u0645\u0633\u0624\u0648\u0644, When \u064a\u0636\u064a\u0641 \u0645\u0646\u062a\u062c\u064b\u0627 \u062c\u062f\u064a\u062f\u064b\u0627, Then \u064a\u0638\u0647\u0631 \u0627\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0645\u0628\u0627\u0634\u0631\u0629.",
        "Given \u0648\u062c\u0648\u062f \u0637\u0644\u0628 \u062c\u062f\u064a\u062f, When \u064a\u0639\u064a\u0651\u0646\u0647 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0644\u0645\u0646\u062f\u0648\u0628, Then \u064a\u0638\u0647\u0631 \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0646\u062f\u0648\u0628."
