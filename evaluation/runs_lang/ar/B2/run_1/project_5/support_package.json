{
  "app_documentation": "\u0645\u062e\u0632\u0648\u0646 \u0644\u0627\u064a\u0641: \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0627\u0644\u0641\u0648\u0631\u064a \u0644\u0645\u062a\u0627\u062c\u0631 \u0627\u0644\u062a\u062c\u0632\u0626\u0629 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u0647\u0648 \u062a\u0637\u0628\u064a\u0642 \u0639\u0631\u0628\u064a \u0628\u062a\u062e\u0637\u064a\u0637 \u0645\u0646 \u0627\u0644\u064a\u0645\u064a\u0646 \u0625\u0644\u0649 \u0627\u0644\u064a\u0633\u0627\u0631 (RTL) \u0648\u0628\u062e\u0637 Cairo\u060c \u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628 \u0648\u0627\u0644\u062c\u0648\u0627\u0644\u060c \u0648\u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u062a\u0645\u0643\u064a\u0646 \u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0645\u062a\u0627\u062c\u0631 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u0645\u0646 \u0645\u0639\u0631\u0641\u0629 \u0643\u0645\u064a\u0627\u062a \u0645\u0646\u062a\u062c\u0627\u062a\u0647\u0645 \u0644\u062d\u0638\u0629 \u0628\u0644\u062d\u0638\u0629 \u0648\u062a\u0642\u0644\u064a\u0644 \u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u062c\u0631\u062f \u0648\u0627\u0644\u0646\u0642\u0635 \u0627\u0644\u0645\u0641\u0627\u062c\u0626 \u0641\u064a \u0627\u0644\u0628\u0636\u0627\u0639\u0629. \u064a\u0639\u062a\u0645\u062f \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u062d \u0627\u0644\u0633\u0631\u064a\u0639 \u0644\u0644\u0628\u0627\u0631\u0643\u0648\u062f \u0628\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u062c\u0648\u0627\u0644 \u0623\u0648 \u0628\u0642\u0627\u0631\u0626 \u062e\u0627\u0631\u062c\u064a \u0628\u0648\u0635\u0641\u0647 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0623\u0633\u0627\u0633\u064a \u0644\u0639\u0631\u0636 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062c \u0648\u0643\u0645\u064a\u062a\u0647 \u062e\u0644\u0627\u0644 \u062b\u0627\u0646\u064a\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0648\u062a\u0633\u062c\u064a\u0644 \u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u0628\u0636\u0627\u0639\u0629 \u062f\u0648\u0646 \u0625\u062f\u062e\u0627\u0644 \u064a\u062f\u0648\u064a\u060c \u0645\u0639 \u0639\u0631\u0636 \u062e\u064a\u0627\u0631 \u0625\u0636\u0627\u0641\u0629 \u0645\u0646\u062a\u062c \u062c\u062f\u064a\u062f \u0639\u0646\u062f \u0645\u0633\u062d \u0628\u0627\u0631\u0643\u0648\u062f \u063a\u064a\u0631 \u0645\u0633\u062c\u0644.\n\n\u064a\u0636\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0631\u0628\u0639 \u0645\u064a\u0632\u0627\u062a \u0631\u0626\u064a\u0633\u064a\u0629. \u0627\u0644\u0623\u0648\u0644\u0649 \u0645\u0633\u062d \u0627\u0644\u0628\u0627\u0631\u0643\u0648\u062f (F1\u060c \u0623\u0648\u0644\u0648\u064a\u0629 \u0639\u0627\u0644\u064a\u0629). \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u062a\u062a\u0628\u0639 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0627\u0644\u0641\u0648\u0631\u064a (F2\u060c \u0623\u0648\u0644\u0648\u064a\u0629 \u0639\u0627\u0644\u064a\u0629)\u060c \u0625\u0630 \u062a\u064f\u062e\u0635\u0645 \u0627\u0644\u0643\u0645\u064a\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u0627 \u0639\u0646\u062f \u0643\u0644 \u0639\u0645\u0644\u064a\u0629 \u0628\u064a\u0639 \u0648\u062a\u0632\u062f\u0627\u062f \u0639\u0646\u062f \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u0623\u0648 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u064a\u062f\u0648\u064a\u060c \u0648\u062a\u0646\u0639\u0643\u0633 \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u062e\u0644\u0627\u0644 3 \u062b\u0648\u0627\u0646 \u0639\u0646\u062f 50 \u0645\u0633\u062a\u062e\u062f\u0645\u0627 \u0645\u062a\u0632\u0627\u0645\u0646\u0627\u060c \u0648\u064a\u064f\u0645\u0646\u0639 \u0627\u0644\u0628\u064a\u0639 \u0639\u0646\u062f \u0639\u062f\u0645 \u0643\u0641\u0627\u064a\u0629 \u0627\u0644\u0643\u0645\u064a\u0629 \u0645\u0639 \u0639\u0631\u0636 \u062a\u062d\u0630\u064a\u0631. \u0627\u0644\u062b\u0627\u0644\u062b\u0629 \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 (F3\u060c \u0623\u0648\u0644\u0648\u064a\u0629 \u0645\u062a\u0648\u0633\u0637\u0629) \u0628\u062d\u062f \u0623\u062f\u0646\u0649 \u064a\u062d\u062f\u062f\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0643\u0644 \u0645\u0646\u062a\u062c\u060c \u0648\u064a\u0635\u0644 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u062e\u0644\u0627\u0644 \u062f\u0642\u064a\u0642\u0629 \u0648\u062a\u064f\u0639\u0631\u0636 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u0646\u062e\u0641\u0636\u0629 \u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u062d\u0633\u0628 \u0627\u0644\u0623\u0643\u062b\u0631 \u0646\u0642\u0635\u0627. \u0627\u0644\u0631\u0627\u0628\u0639\u0629 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0648\u0627\u0644\u062c\u0631\u062f (F4\u060c \u0623\u0648\u0644\u0648\u064a\u0629 \u0645\u062a\u0648\u0633\u0637\u0629)\u060c \u0648\u062a\u0634\u0645\u0644 \u062a\u0642\u0627\u0631\u064a\u0631 \u062d\u0631\u0643\u0629 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0648\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0644\u0641\u062a\u0631\u0629 \u0645\u062d\u062f\u062f\u0629 \u062a\u0638\u0647\u0631 \u062e\u0644\u0627\u0644 5 \u062b\u0648\u0627\u0646 \u0645\u0639 \u062a\u0635\u062f\u064a\u0631 PDF \u0648Excel\u060c \u0648\u062c\u0631\u062f\u0627 \u062f\u0648\u0631\u064a\u0627 \u0628\u0627\u0644\u0628\u0627\u0631\u0643\u0648\u062f \u0648\u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0643\u0645\u064a\u0627\u062a \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0628\u0627\u0644\u0645\u0633\u062c\u0644\u0629 \u0648\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u062a\u0633\u0648\u064a\u0629.\n\n\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0648\u0646 \u0623\u0631\u0628\u0639\u0629 \u0623\u062f\u0648\u0627\u0631: \u0645\u0627\u0644\u0643 \u0627\u0644\u0645\u062a\u062c\u0631\u060c \u0648\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u062e\u0632\u0648\u0646\u060c \u0648\u0627\u0644\u0643\u0627\u0634\u064a\u0631\u060c \u0648\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u062e\u0632\u0646\u060c \u0648\u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0648\u0635\u0648\u0644 \u0628\u062d\u0633\u0628 \u0627\u0644\u062f\u0648\u0631 \u0639\u0628\u0631 \u0627\u0644\u062c\u062f\u0627\u0648\u0644 roles \u0648permissions \u0648role_permissions. \u062a\u062a\u0636\u0645\u0646 \u0627\u0644\u0634\u0627\u0634\u0627\u062a: \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u062e\u0632\u0648\u0646\u060c \u0648\u0645\u0633\u062d \u0627\u0644\u0628\u0627\u0631\u0643\u0648\u062f\u060c \u0648\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0646\u062a\u062c\u060c \u0648\u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0628\u064a\u0639\u060c \u0648\u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a\u060c \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0648\u0627\u0644\u062c\u0631\u062f\u060c \u0645\u0639 \u062a\u0646\u0642\u0644 \u0633\u0641\u0644\u064a \u0645\u0646 \u0623\u0631\u0628\u0639\u0629 \u062a\u0628\u0648\u064a\u0628\u0627\u062a: \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0627\u0644\u0645\u0633\u062d\u060c \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a\u060c \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631. \u0648\u062a\u064f\u0639\u062a\u0645\u062f \u0623\u0644\u0648\u0627\u0646 \u062f\u0644\u0627\u0644\u064a\u0629 (\u0623\u062e\u0636\u0631 \u0644\u0644\u0645\u062a\u0648\u0641\u0631\u060c \u0628\u0631\u062a\u0642\u0627\u0644\u064a \u0644\u0644\u0645\u0646\u062e\u0641\u0636\u060c \u0623\u062d\u0645\u0631 \u0644\u0644\u0646\u0627\u0641\u062f) \u0645\u0639 \u0646\u0635 \u0645\u0631\u0627\u0641\u0642 \u0644\u0627 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0644\u0648\u0646 \u0648\u062d\u062f\u0647\u060c \u0648\u062a\u0628\u0627\u064a\u0646 \u0644\u0627 \u064a\u0642\u0644 \u0639\u0646 4.5:1.\n\n\u062a\u0642\u0646\u064a\u0627 \u064a\u064f\u0628\u0646\u0649 \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u0640 React \u0644\u0644\u0648\u064a\u0628 \u0648React Native \u0644\u0644\u062c\u0648\u0627\u0644 \u0648Node.js \u0645\u0639 REST API\u060c \u0648\u064a\u0633\u062a\u062e\u062f\u0645 WebSocket \u0648Redis \u0644\u0628\u062b \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0627\u0644\u0641\u0648\u0631\u064a\u0629\u060c \u0648\u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a PostgreSQL \u062a\u0636\u0645 \u062c\u062f\u0627\u0648\u0644 \u0645\u0646\u0647\u0627 stores \u0648users \u0648products \u0648inventory_stock \u0648stock_movements \u0648sales \u0648sale_items \u0648goods_receipts \u0648stocktakes \u0648low_stock_alerts \u0648notifications \u0648report_exports \u0648barcode_scans. \u0648\u0645\u0646 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0648\u0638\u064a\u0641\u064a\u0629: \u062a\u0648\u0641\u0631 99.5% \u0634\u0647\u0631\u064a\u0627 \u0645\u0639 \u0646\u0633\u062e \u0627\u062d\u062a\u064a\u0627\u0637\u064a \u064a\u0648\u0645\u064a\u060c \u0648\u062a\u0634\u0641\u064a\u0631 HTTPS\u060c \u0648\u062a\u0639\u0644\u0645 \u0645\u0648\u0638\u0641 \u062c\u062f\u064a\u062f \u0639\u0645\u0644\u064a\u0629 \u0645\u0633\u062d \u0648\u0628\u064a\u0639 \u0643\u0627\u0645\u0644\u0629 \u062e\u0644\u0627\u0644 15 \u062f\u0642\u064a\u0642\u0629 \u0645\u0646 \u0627\u0644\u062a\u062f\u0631\u064a\u0628. \u0648\u062a\u062a\u0636\u0645\u0646 \u062e\u0637\u0629 MVP \u0627\u062b\u0646\u062a\u064a \u0639\u0634\u0631\u0629 \u0645\u0647\u0645\u0629 (T1 \u0625\u0644\u0649 T12) \u0648\u0645\u062e\u0627\u0637\u0631 \u0623\u0628\u0631\u0632\u0647\u0627 \u062a\u0623\u062e\u0631 \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0627\u0644\u0641\u0648\u0631\u064a\u0629\u060c \u0648\u062a\u0641\u0627\u0648\u062a \u062f\u0642\u0629 \u0627\u0644\u0645\u0633\u062d\u060c \u0648\u062a\u0639\u0627\u0631\u0636 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0643\u0645\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u0632\u0627\u0645\u0646\u060c \u0648\u0627\u0646\u0642\u0637\u0627\u0639 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0641\u064a \u0627\u0644\u0645\u062a\u062c\u0631.",
