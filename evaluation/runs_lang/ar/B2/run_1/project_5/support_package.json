  "glossary": {
    "\u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0627\u0644\u0641\u0648\u0631\u064a": "\u0639\u0631\u0636 \u0643\u0645\u064a\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0648\u062a\u062d\u062f\u064a\u062b\u0647\u0627 \u0644\u062d\u0638\u064a\u0627 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u062e\u0644\u0627\u0644 3 \u062b\u0648\u0627\u0646 \u0645\u0646 \u0643\u0644 \u0639\u0645\u0644\u064a\u0629 \u0628\u064a\u0639 \u0623\u0648 \u0627\u0633\u062a\u0644\u0627\u0645 \u0623\u0648 \u062a\u0639\u062f\u064a\u0644.",
    "\u0627\u0644\u0628\u0627\u0631\u0643\u0648\u062f": "\u0631\u0645\u0632 \u0645\u0637\u0628\u0648\u0639 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u062a\u062c \u064a\u064f\u0645\u0633\u062d \u0628\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u062c\u0648\u0627\u0644 \u0623\u0648 \u0628\u0642\u0627\u0631\u0626 \u062e\u0627\u0631\u062c\u064a \u0644\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0647\u060c \u0648\u0647\u0648 \u0641\u0631\u064a\u062f \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062a\u062c\u0631 \u0641\u064a \u0627\u0644\u062d\u0642\u0644 barcode \u0628\u062c\u062f\u0648\u0644 products.",
    "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0644\u0644\u062a\u0646\u0628\u064a\u0647": "\u0643\u0645\u064a\u0629 \u064a\u062d\u062f\u062f\u0647\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0643\u0644 \u0645\u0646\u062a\u062c \u0641\u064a \u0627\u0644\u062d\u0642\u0644 min_quantity \u0628\u062c\u062f\u0648\u0644 inventory_stock\u060c \u0648\u064a\u064f\u0631\u0633\u0644 \u062a\u0646\u0628\u064a\u0647 \u0639\u0646\u062f \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0643\u0645\u064a\u0629 \u0639\u0646\u0647.",
    "\u0627\u0644\u062c\u0631\u062f": "\u0639\u0645\u0644\u064a\u0629 \u062f\u0648\u0631\u064a\u0629 \u0628\u0627\u0644\u0628\u0627\u0631\u0643\u0648\u062f \u0644\u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0628\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062c\u0644\u0629 \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645 \u0648\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0641\u0631\u0648\u0642\u0627\u062a \u0648\u0627\u0639\u062a\u0645\u0627\u062f\u0647\u0627 \u0648\u062a\u0633\u0648\u064a\u062a\u0647\u0627 \u0641\u064a \u062c\u062f\u0627\u0648\u0644 stocktakes \u0648stocktake_items.",
    "\u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u0628\u0636\u0627\u0639\u0629": "\u062a\u0633\u062c\u064a\u0644 \u062f\u062e\u0648\u0644 \u0628\u0636\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u0648\u0631\u062f \u0628\u0645\u0633\u062d \u0627\u0644\u0628\u0627\u0631\u0643\u0648\u062f \u062f\u0648\u0646 \u0625\u062f\u062e\u0627\u0644 \u064a\u062f\u0648\u064a\u060c \u0641\u062a\u0632\u062f\u0627\u062f \u0627\u0644\u0643\u0645\u064a\u0627\u062a \u0648\u062a\u064f\u0633\u062c\u0644 \u0641\u064a \u062c\u062f\u0627\u0648\u0644 goods_receipts \u0648goods_receipt_items.",
    "\u062d\u0631\u0643\u0629 \u0627\u0644\u0645\u062e\u0632\u0648\u0646": "\u0633\u062c\u0644 \u063a\u064a\u0631 \u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u0639\u062f\u064a\u0644 \u0644\u0643\u0644 \u062a\u063a\u064a\u064a\u0631 \u0641\u064a \u0627\u0644\u0643\u0645\u064a\u0629 (\u0628\u064a\u0639\u060c \u0627\u0633\u062a\u0644\u0627\u0645\u060c \u062a\u0639\u062f\u064a\u0644 \u064a\u062f\u0648\u064a\u060c \u062a\u0633\u0648\u064a\u0629 \u062c\u0631\u062f\u060c \u0625\u0644\u063a\u0627\u0621 \u0628\u064a\u0639) \u0641\u064a \u0627\u0644\u062c\u062f\u0648\u0644 stock_movements \u064a\u062f\u0639\u0645 \u0627\u0644\u062a\u062a\u0628\u0639 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631."
  }
}