  "glossary": {
    "\u0627\u0644\u0645\u0647\u0645\u0629": "\u0639\u0646\u0635\u0631 \u0639\u0645\u0644 \u064a\u0633\u062c\u0644\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u0639\u0646\u0648\u0627\u0646 \u0625\u0644\u0632\u0627\u0645\u064a \u0648\u0648\u0635\u0641 \u0627\u062e\u062a\u064a\u0627\u0631\u064a \u0648\u062d\u0627\u0644\u0629 \u0625\u0643\u0645\u0627\u0644\u060c \u0648\u064a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a \u0627\u0644\u062c\u062f\u0648\u0644 tasks \u0648\u064a\u062e\u0635 \u0645\u0633\u062a\u062e\u062f\u0645\u0627\u064b \u0648\u0627\u062d\u062f\u0627\u064b \u0641\u0642\u0637.",
    "\u0627\u0644\u0625\u0643\u0645\u0627\u0644": "\u062d\u0627\u0644\u0629 \u062b\u0646\u0627\u0626\u064a\u0629 \u0644\u0644\u0645\u0647\u0645\u0629 (\u0645\u0643\u062a\u0645\u0644\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629) \u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a \u0627\u0644\u062d\u0642\u0644 is_completed \u0645\u0639 \u0648\u0642\u062a \u0627\u0644\u0625\u0643\u0645\u0627\u0644 \u0641\u064a completed_at\u060c \u0648\u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646\u0647\u0627 \u0644\u062a\u0639\u0648\u062f \u0627\u0644\u0645\u0647\u0645\u0629 \u0625\u0644\u0649 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629.",
    "\u0627\u0644\u062a\u0635\u0641\u064a\u0629": "\u062e\u0627\u0635\u064a\u0629 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0647\u0627\u0645 \u062a\u062a\u064a\u062d \u0639\u0631\u0636 \u0627\u0644\u0643\u0644 \u0623\u0648 \u063a\u064a\u0631 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629 \u0623\u0648 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629 \u0639\u0628\u0631 \u0634\u0631\u0627\u0626\u062d \u0627\u0644\u062a\u0635\u0641\u064a\u0629\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0628\u062d\u062b \u0628\u0627\u0644\u0639\u0646\u0648\u0627\u0646.",
    "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645": "\u0633\u062c\u0644 \u0645\u062e\u0632\u064e\u0651\u0646 \u0641\u064a \u0627\u0644\u062c\u062f\u0648\u0644 users \u064a\u0636\u0645 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u0645\u0634\u0641\u0631\u0629\u060c \u0648\u064a\u062a\u064a\u062d \u0644\u0643\u0644 \u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0645\u0647\u0627\u0645\u0647 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0639\u062f \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644.",
    "bcrypt": "\u062e\u0648\u0627\u0631\u0632\u0645\u064a\u0629 \u062a\u0634\u0641\u064a\u0631 \u0623\u062d\u0627\u062f\u064a\u0629 \u0627\u0644\u0627\u062a\u062c\u0627\u0647 \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u062d\u0645\u0627\u064a\u0629 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631\u060c \u0648\u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0646\u062a\u064a\u062c\u062a\u0647\u0627 \u0641\u064a \u0627\u0644\u062d\u0642\u0644 password_hash \u0648\u0644\u0627 \u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0628\u0635\u064a\u063a\u0629 \u0646\u0635\u064a\u0629 \u0635\u0631\u064a\u062d\u0629.",
    "\u062e\u0637 \u0627\u0644\u0623\u0633\u0627\u0633 (Baseline)": "\u0646\u0633\u062e\u0629 \u0645\u0639\u062a\u0645\u062f\u0629 \u0648\u0645\u062c\u0645\u0651\u062f\u0629 \u0645\u0646 \u0623\u062d\u062f \u0645\u062e\u0631\u062c\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0645\u062b\u0644 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0623\u0648 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0623\u0648 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0645\u0631\u062c\u0639\u0627\u064b \u0644\u0636\u0628\u0637 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0627\u062a\u0633\u0627\u0642."
  }
}