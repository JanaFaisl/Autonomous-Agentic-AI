{
  "app_documentation": "\u062a\u0637\u0628\u064a\u0642 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0628\u0633\u064a\u0637 \u0647\u0648 \u062a\u0637\u0628\u064a\u0642 \u0648\u064a\u0628 \u0639\u0631\u0628\u064a \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u064a\u0639\u0645\u0644 \u0628\u0627\u0644\u0627\u062a\u062c\u0627\u0647 \u0645\u0646 \u0627\u0644\u064a\u0645\u064a\u0646 \u0625\u0644\u0649 \u0627\u0644\u064a\u0633\u0627\u0631\u060c \u0648\u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0649 \u062a\u0633\u062c\u064a\u0644 \u0645\u0627 \u064a\u062c\u0628 \u0625\u0646\u062c\u0627\u0632\u0647 \u0648\u0645\u062a\u0627\u0628\u0639\u062a\u0647 \u0628\u0633\u0647\u0648\u0644\u0629 \u0648\u0633\u0631\u0639\u0629. \u0635\u064f\u0645\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u064a\u062a\u0645\u0643\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062c\u062f\u064a\u062f \u0645\u0646 \u0625\u0646\u0634\u0627\u0621 \u0623\u0648\u0644 \u0645\u0647\u0645\u0629 \u062e\u0644\u0627\u0644 \u0623\u0642\u0644 \u0645\u0646 \u062f\u0642\u064a\u0642\u0629 \u062f\u0648\u0646 \u062a\u062f\u0631\u064a\u0628\u060c \u0648\u062a\u0639\u062a\u0645\u062f \u0648\u0627\u062c\u0647\u062a\u0647 \u0639\u0644\u0649 \u0628\u0637\u0627\u0642\u0627\u062a \u0648\u0627\u0636\u062d\u0629 \u0648\u0625\u062c\u0631\u0627\u0621 \u0631\u0626\u064a\u0633\u064a \u0628\u0627\u0631\u0632 \u0641\u064a \u0643\u0644 \u0634\u0627\u0634\u0629. \u0648\u064a\u0633\u062a\u0647\u062f\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0630\u064a\u0646 \u064a\u062d\u062a\u0627\u062c\u0648\u0646 \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0645\u0647\u0627\u0645 \u0634\u062e\u0635\u064a\u0629 \u062e\u0627\u0635\u0629 \u0628\u0647\u0645\u060c \u0648\u064a\u0648\u062c\u062f \u062f\u0648\u0631 \u0648\u0627\u062d\u062f \u0641\u0642\u0637 \u0647\u0648 \u00ab\u0645\u0633\u062a\u062e\u062f\u0645\u00bb.\n\n\u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062e\u0645\u0633 \u0645\u064a\u0632\u0627\u062a \u0631\u0626\u064a\u0633\u064a\u0629: \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0647\u0627\u0645 (F1) \u0628\u0639\u0646\u0648\u0627\u0646 \u0625\u0644\u0632\u0627\u0645\u064a \u0648\u0648\u0635\u0641 \u0627\u062e\u062a\u064a\u0627\u0631\u064a \u0628\u062d\u062f \u0623\u0642\u0635\u0649 500 \u062d\u0631\u0641\u060c \u0648\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0645\u0647\u0627\u0645 (F2) \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0627\u0644\u0625\u0643\u0645\u0627\u0644 \u0648\u062a\u0645\u064a\u064a\u0632 \u0628\u0635\u0631\u064a \u0641\u0648\u0631\u064a\u060c \u0648\u062d\u0630\u0641 \u0627\u0644\u0645\u0647\u0627\u0645 (F3) \u0628\u0639\u062f \u0646\u0627\u0641\u0630\u0629 \u062a\u0623\u0643\u064a\u062f \u062a\u062a\u064a\u062d \u0627\u0644\u0625\u0644\u063a\u0627\u0621 \u062f\u0648\u0646 \u0623\u064a \u062a\u063a\u064a\u064a\u0631\u060c \u0648\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 (F4) \u0644\u0644\u062a\u0633\u062c\u064a\u0644 \u0648\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0628\u062d\u064a\u062b \u064a\u0631\u0649 \u0643\u0644 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0647\u0627\u0645\u0647 \u0641\u0642\u0637\u060c \u0648\u0639\u0631\u0636 \u0627\u0644\u0645\u0647\u0627\u0645 \u0648\u062a\u0635\u0641\u064a\u062a\u0647\u0627 (F5) \u0645\u0631\u062a\u0628\u0629\u064b \u0645\u0646 \u0627\u0644\u0623\u062d\u062f\u062b \u0645\u0639 \u0634\u0631\u0627\u0626\u062d \u062a\u0635\u0641\u064a\u0629 (\u0627\u0644\u0643\u0644 / \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629 / \u0645\u0643\u062a\u0645\u0644\u0629) \u0648\u0627\u0644\u0628\u062d\u062b \u0628\u0627\u0644\u0639\u0646\u0648\u0627\u0646. \u0648\u064a\u0636\u0645 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0633\u0628\u0639 \u0634\u0627\u0634\u0627\u062a \u0647\u064a: \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644\u060c \u0648\u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628\u060c \u0648\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0647\u0627\u0645\u060c \u0648\u0625\u0636\u0627\u0641\u0629 \u0645\u0647\u0645\u0629\u060c \u0648\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0647\u0645\u0629\u060c \u0645\u0639 \u0646\u0627\u0641\u0630\u0629 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062d\u0630\u0641 \u0648\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0646\u062c\u0627\u062d.\n\n\u0645\u0646 \u0627\u0644\u0646\u0627\u062d\u064a\u0629 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u064a\u064f\u0628\u0646\u0649 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0644\u0649 \u0645\u0646\u0635\u0629 \u0627\u0644\u0648\u064a\u0628 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 React \u0644\u0644\u0648\u0627\u062c\u0647\u0629 \u0648Node.js \u0648Express \u0644\u0648\u0627\u062c\u0647\u0627\u062a REST API \u0645\u0639 \u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a PostgreSQL \u0627\u0644\u062a\u064a \u062a\u0636\u0645 \u062c\u062f\u0648\u0644\u064a\u0646: users \u0648tasks\u060c \u0648\u062a\u0631\u0628\u0637\u0647\u0645\u0627 \u0639\u0644\u0627\u0642\u0629 \u0648\u0627\u062d\u062f \u0625\u0644\u0649 \u0645\u062a\u0639\u062f\u062f \u0639\u0628\u0631 tasks.user_id \u0627\u0644\u0630\u064a \u064a\u0634\u064a\u0631 \u0625\u0644\u0649 users.id \u0645\u0639 \u062d\u0630\u0641 \u062a\u0633\u0644\u0633\u0644\u064a (ON DELETE CASCADE). \u0648\u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0645\u0634\u0641\u0631\u0629 \u0628\u062e\u0648\u0627\u0631\u0632\u0645\u064a\u0629 bcrypt \u0641\u064a password_hash \u0648\u062a\u064f\u0631\u0633\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0628\u0631 HTTPS \u0641\u0642\u0637\u060c \u0648\u062a\u064f\u062f\u0627\u0631 \u0627\u0644\u062c\u0644\u0633\u0627\u062a \u0628\u0631\u0645\u0648\u0632 \u0645\u0635\u0627\u062f\u0642\u0629 \u0641\u064a \u0637\u0628\u0642\u0629 \u0627\u0644\u062e\u0627\u062f\u0645\u060c \u0648\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062d\u0642\u0644 \u0627\u0644\u0645\u0646\u0637\u0642\u064a is_completed \u0645\u0639 completed_at \u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0625\u0643\u0645\u0627\u0644\u060c \u0648\u0627\u0644\u062d\u0630\u0641 \u0646\u0647\u0627\u0626\u064a. \u0648\u062a\u0639\u062a\u0645\u062f \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u062e\u0637\u064a Cairo \u0648Tajawal\u060c \u0648\u062a\u062a\u0628\u0639 \u062a\u0635\u0645\u064a\u0645\u0627\u064b \u064a\u0628\u062f\u0623 \u0628\u0627\u0644\u062c\u0648\u0627\u0644 \u0628\u0639\u0645\u0648\u062f \u0648\u0627\u062d\u062f \u062d\u062a\u0649 480px \u0645\u0639 \u0645\u062d\u062a\u0648\u0649 \u0645\u062a\u0645\u0631\u0643\u0632 \u0628\u0639\u0631\u0636 720px \u0639\u0644\u0649 \u0627\u0644\u062d\u0627\u0633\u0648\u0628\u060c \u0648\u062a\u0631\u0627\u0639\u064a \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u0628\u062a\u0628\u0627\u064a\u0646 \u0644\u0648\u0646\u064a \u0644\u0627 \u064a\u0642\u0644 \u0639\u0646 4.5:1 \u0648\u0645\u0633\u0627\u062d\u0627\u062a \u0644\u0645\u0633 44px \u0648\u062a\u0646\u0642\u0644 \u0643\u0627\u0645\u0644 \u0628\u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d.\n\n\u062a\u062a\u0645\u062b\u0644 \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062c\u0648\u062f\u0629 \u0641\u064a \u062a\u062d\u0645\u064a\u0644 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0647\u0627\u0645 \u062e\u0644\u0627\u0644 \u0623\u0642\u0644 \u0645\u0646 \u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0639\u0646\u062f 100 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062a\u0632\u0627\u0645\u0646 \u0628\u062f\u0639\u0645 \u0627\u0644\u0641\u0647\u0627\u0631\u0633 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 (user_id, created_at) \u0648(user_id, is_completed)\u060c \u0648\u062a\u0648\u0641\u0631 \u062e\u062f\u0645\u0629 \u0628\u0646\u0633\u0628\u0629 99.5% \u0634\u0647\u0631\u064a\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\u060c \u0648\u0633\u0647\u0648\u0644\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u062a\u064a\u062d \u0625\u0646\u0634\u0627\u0621 \u0623\u0648\u0644 \u0645\u0647\u0645\u0629 \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062f\u0642\u064a\u0642\u0629. \u0648\u062a\u0646\u0642\u0633\u0645 \u062e\u0637\u0629 \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0623\u062f\u0646\u0649 \u0627\u0644\u0642\u0627\u0628\u0644 \u0644\u0644\u0625\u0637\u0644\u0627\u0642 \u0625\u0644\u0649 13 \u0645\u0647\u0645\u0629 (T1 \u0625\u0644\u0649 T13) \u062a\u0628\u062f\u0623 \u0628\u0645\u062e\u0637\u0637 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u062a\u0631\u062d\u064a\u0644\u0627\u062a \u0648\u062a\u0646\u062a\u0647\u064a \u0628\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0642\u0628\u0648\u0644 \u0627\u0644\u0634\u0627\u0645\u0644 \u0648\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0623\u062f\u0627\u0621 \u0648\u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0646\u0634\u0631 \u0639\u0628\u0631 HTTPS \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u062a\u0648\u0641\u0631. \u0648\u062a\u0634\u0645\u0644 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0636\u064a\u0642 \u0627\u0644\u0648\u0642\u062a \u0648\u062a\u0623\u062c\u064a\u0644 \u0634\u0627\u0634\u0629 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\u060c \u0648\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0633\u062a\u0636\u0627\u0641\u0629 \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u062a\u0648\u0641\u0631\u060c \u0648\u0636\u0639\u0641 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0644\u0643\u064a\u0629 \u0627\u0644\u0645\u0647\u0627\u0645\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0623\u062f\u0627\u0621 \u062f\u0648\u0646 \u0641\u0647\u0627\u0631\u0633 \u0645\u0646\u0627\u0633\u0628\u0629\u060c \u0648\u0627\u062e\u062a\u0644\u0627\u0641 \u0639\u0631\u0636 \u0627\u0644\u0646\u0635\u0648\u0635 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u0635\u0641\u062d\u0627\u062a.",
