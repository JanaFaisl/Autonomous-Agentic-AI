    {
      "severity": "Medium",
      "item": "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644",
      "message": "\u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0631\u0627\u0628\u0637 \u00ab\u0646\u0633\u064a\u062a \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631\u061f\u00bb \u0627\u0644\u0630\u064a \u064a\u0641\u062a\u062d \u0646\u0627\u0641\u0630\u0629 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f\u060c \u0628\u064a\u0646\u0645\u0627 \u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u064a\u0632\u0629 \u0623\u0648 \u0645\u0639\u064a\u0627\u0631 \u0642\u0628\u0648\u0644 \u0644\u0630\u0644\u0643 \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0648\u0644\u0627 \u062c\u062f\u0648\u0644 \u0623\u0648 \u062d\u0642\u0644 \u0644\u0631\u0645\u0632 \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a."
    },
    {
      "severity": "Medium",
      "item": "\u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628",
      "message": "\u0627\u0644\u0645\u064a\u0632\u0629 F4 \u062a\u062a\u0636\u0645\u0646 \u0642\u0635\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u0644\u0643\u0646 \u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u0642\u0628\u0648\u0644 \u062a\u063a\u0637\u064a \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0641\u0642\u0637\u060c \u0641\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0639\u0627\u064a\u064a\u0631 \u0644\u0644\u062a\u0633\u062c\u064a\u0644 \u0645\u062b\u0644 \u0631\u0641\u0636 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0643\u0631\u0631 (\u0627\u0644\u0642\u064a\u062f unique \u0639\u0644\u0649 users.email) \u0648\u062d\u062f \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u0623\u062f\u0646\u0649 (8 \u0623\u062d\u0631\u0641) \u0627\u0644\u0638\u0627\u0647\u0631 \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645."
    },
    {
      "severity": "Medium",
      "item": "\u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0627\u062a",
      "message": "\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629 settings \u0641\u064a \u062d\u0642\u0648\u0644 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0648\u0628\u0637\u0627\u0642\u0629 \u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0628\u064a\u0646\u0645\u0627 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u0644\u0645\u0648\u062d\u062f\u0629 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 (home \u0648search \u0648user \u0648bell \u0648bookmark \u0648filter \u0648plus \u0648edit \u0648trash) \u0644\u0627 \u062a\u062a\u0636\u0645\u0646\u0647\u0627."
    },
    {
      "severity": "Medium",
      "item": "\u0625\u0636\u0627\u0641\u0629 \u0645\u0647\u0645\u0629",
      "message": "\u0639\u062f\u0627\u062f \u0627\u0644\u0623\u062d\u0631\u0641 \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u064a\u062d\u062f\u062f \u062d\u062f\u0627\u064b \u0623\u0642\u0635\u0649 500 \u062d\u0631\u0641 \u0644\u0644\u0648\u0635\u0641\u060c \u0628\u064a\u0646\u0645\u0627 \u0644\u0627 \u064a\u0631\u062f \u0647\u0630\u0627 \u0627\u0644\u062d\u062f \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0648\u0644\u0627 \u0641\u064a \u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u0648\u062f tasks.description (text \u0628\u0644\u0627 \u062d\u062f)."
    }
  ],
  "required_fixes": [
    "\u0625\u0636\u0627\u0641\u0629 \u0645\u0639\u0627\u064a\u064a\u0631 \u0642\u0628\u0648\u0644 \u0644\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u0641\u064a \u0627\u0644\u0645\u064a\u0632\u0629 F4 (\u0628\u0631\u064a\u062f \u0645\u0643\u0631\u0631\u060c \u062d\u062f \u0623\u062f\u0646\u0649 \u0644\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631\u060c \u062a\u0637\u0627\u0628\u0642 \u0627\u0644\u062a\u0623\u0643\u064a\u062f).",
    "\u0625\u0645\u0627 \u0625\u0632\u0627\u0644\u0629 \u0631\u0627\u0628\u0637 \u00ab\u0646\u0633\u064a\u062a \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631\u061f\u00bb \u0645\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645\u060c \u0623\u0648 \u0625\u0636\u0627\u0641\u0629 \u0645\u064a\u0632\u0629 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0645\u0639 \u062f\u0639\u0645\u0647\u0627 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a.",
    "\u062a\u0648\u062d\u064a\u062f \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0628\u0625\u0636\u0627\u0641\u0629 settings \u0625\u0644\u0649 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0648\u062d\u062f\u0629 \u0623\u0648 \u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627 \u0628\u0623\u064a\u0642\u0648\u0646\u0629 \u0645\u0646 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629.",
    "\u062a\u0648\u062d\u064a\u062f \u062d\u062f \u0637\u0648\u0644 \u0627\u0644\u0648\u0635\u0641 (500 \u062d\u0631\u0641) \u0628\u064a\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0623\u0648 \u062d\u0630\u0641\u0647 \u0645\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645."
  ],
  "recommendations": [
