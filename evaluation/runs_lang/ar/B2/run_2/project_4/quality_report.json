    {
      "severity": "Medium",
      "item": "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0628\u0631\u064a\u062f",
      "message": "\u0634\u0627\u0634\u0629 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u062a\u0641\u062a\u062d \u0646\u0645\u0648\u0630\u062c \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644\u060c \u0648\u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u0641\u0639\u064a\u0644 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0631\u0627\u0628\u0637 \u0627\u0644\u0628\u0631\u064a\u062f\u060c \u0644\u0643\u0646 \u0644\u0627 \u062a\u0648\u062c\u062f \u0634\u0627\u0634\u0629 \u0645\u0635\u0645\u0645\u0629 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u0644\u0627 \u0644\u0635\u0641\u062d\u0629 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062a\u0641\u0639\u064a\u0644."
    },
    {
      "severity": "Medium",
      "item": "\u0627\u0644\u0634\u0627\u0634\u0627\u062a \u0627\u0644\u0646\u0627\u0642\u0635\u0629",
      "message": "\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u064a\u062d\u064a\u0644 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0642\u0631\u0631 \u0648\u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0634\u0627\u0634\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062f\u0648\u0646 \u062a\u0639\u0631\u064a\u0641\u0647\u0627\u060c \u0641\u0644\u0627 \u064a\u0638\u0647\u0631 \u0645\u0633\u0627\u0631 \u0639\u0631\u0636 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629 \u0628\u0639\u062f \u0627\u0644\u0646\u0634\u0631 \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0642\u0631\u0631\u060c \u0648\u0644\u0627 \u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0644\u0627\u062d\u0638\u0629 \u062f\u0627\u062e\u0644 \u0645\u062c\u0645\u0648\u0639\u0629 (group_notes)\u060c \u0648\u0644\u0627 \u0639\u0631\u0636 \u0625\u0634\u0639\u0627\u0631\u0627\u062a (notifications)."
    },
    {
      "severity": "Medium",
      "item": "\u0632\u0631 \u062d\u0641\u0638 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629",
      "message": "\u0634\u0627\u0634\u0629 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629 \u062a\u062a\u0636\u0645\u0646 \u062d\u0641\u0638 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0627\u062a\u060c \u0648\u0647\u0648 \u063a\u064a\u0631 \u0648\u0627\u0631\u062f \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u0644\u0647 \u062c\u062f\u0648\u0644 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a."
    },
    {
      "severity": "Medium",
      "item": "\u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0627\u062d\u064a\u0629 (tags \u0648 note_tags)",
      "message": "\u0627\u0644\u0645\u062a\u0637\u0644\u0628 F4 \u0648\u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u064a\u062f\u0639\u0645\u0627\u0646 \u0627\u0644\u0628\u062d\u062b \u0628\u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0627\u062d\u064a\u0629 \u0639\u0628\u0631 tags \u0648note_tags\u060c \u0644\u0643\u0646 \u0634\u0627\u0634\u0629 \u0631\u0641\u0639 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629 \u0644\u0627 \u062a\u062a\u064a\u062d \u0625\u062f\u062e\u0627\u0644 \u0623\u064a \u0643\u0644\u0645\u0627\u062a \u0645\u0641\u062a\u0627\u062d\u064a\u0629."
    },
    {
      "severity": "Medium",
      "item": "\u0627\u0644\u0628\u0644\u0627\u063a\u0627\u062a (content_reports)",
      "message": "\u0627\u0644\u0645\u062a\u0637\u0644\u0628 F5 \u064a\u0642\u0636\u064a \u0628\u0638\u0647\u0648\u0631 \u0627\u0644\u0628\u0644\u0627\u063a \u0644\u0644\u0645\u0634\u0631\u0641\u064a\u0646\u060c \u0644\u0643\u0646 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0639\u0627\u0645\u0629 \u0648\u062c\u062f\u0648\u0644 content_reports \u0644\u0627 \u064a\u0631\u062a\u0628\u0637 \u0628\u0645\u062c\u0645\u0648\u0639\u0629\u060c \u0641\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0645\u0634\u0631\u0641\u064a\u0646 \u0627\u0644\u0645\u0639\u0646\u064a\u064a\u0646 \u0628\u0643\u0644 \u0628\u0644\u0627\u063a."
    }
  ],
  "required_fixes": [
    "\u0625\u0636\u0627\u0641\u0629 \u0634\u0627\u0634\u062a\u064a \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u062a\u0623\u0643\u064a\u062f \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0628\u0631\u064a\u062f \u0625\u0644\u0649 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0645\u0639 \u0645\u0633\u0627\u0631\u0627\u062a\u0647\u0645\u0627.",
    "\u0625\u0636\u0627\u0641\u0629 \u0634\u0627\u0634\u0627\u062a \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0642\u0631\u0631 \u0648\u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 (\u0627\u0644\u0623\u0639\u0636\u0627\u0621 \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a) \u0648\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0625\u0644\u0649 \u0627\u0644\u062a\u0635\u0645\u064a\u0645.",
    "\u0625\u0636\u0627\u0641\u0629 \u062d\u0642\u0644 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0627\u062d\u064a\u0629 \u0641\u064a \u0634\u0627\u0634\u0629 \u0631\u0641\u0639 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629\u060c \u0648\u0625\u0645\u0627 \u062d\u0630\u0641 \u0632\u0631 \u062d\u0641\u0638 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0648 \u0625\u0636\u0627\u0641\u0629 \u062c\u062f\u0648\u0644 saved_notes \u0648\u062a\u0648\u062b\u064a\u0642\u0647 \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a.",
    "\u062a\u062d\u062f\u064a\u062f \u0645\u0646 \u064a\u0631\u0627\u062c\u0639 \u0627\u0644\u0628\u0644\u0627\u063a\u0627\u062a: \u0625\u0645\u0627 \u0631\u0628\u0637 content_reports \u0628\u0645\u062c\u0645\u0648\u0639\u0629 \u0623\u0648 \u062f\u0648\u0631 \u0645\u0631\u0627\u062c\u0639 \u0648\u0627\u0636\u062d\u060c \u0648\u0625\u0645\u0627 \u062d\u0635\u0631 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0641\u064a \u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0648\u062a\u0639\u062f\u064a\u0644 F5 \u0648\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u0641\u0642 \u0630\u0644\u0643."
  ],
