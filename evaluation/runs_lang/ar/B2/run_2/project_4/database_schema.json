  "assumptions": [
    "\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0647\u064a PostgreSQL\u060c \u0648\u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0645\u0646 \u0646\u0648\u0639 uuid \u0648\u062a\u064f\u0648\u0644\u064e\u0651\u062f \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0628\u0627\u0644\u062f\u0627\u0644\u0629 gen_random_uuid().",
    "\u062f\u0648\u0631 \u0645\u0634\u0631\u0641 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u062e\u0627\u0635 \u0628\u0643\u0644 \u0645\u062c\u0645\u0648\u0639\u0629\u060c \u0644\u0630\u0644\u0643 \u064a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a group_members.role. \u0623\u0645\u0627 users.role \u0641\u064a\u062d\u0645\u0644 \u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u0639\u0627\u0645 \u0641\u0642\u0637 (student \u0623\u0648 system_admin).",
    "\u064a\u064f\u0646\u0634\u0626 \u0627\u0644\u0646\u0638\u0627\u0645 \u0635\u0641 group_members \u0628\u062f\u0648\u0631 supervisor \u0644\u0645\u0646\u0634\u0626 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0626\u0647\u0627.",
    "\u0644\u0627 \u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0628\u0644 \u0641\u064a Amazon S3\u060c \u0648\u064a\u064f\u062d\u0641\u0638 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0645\u0644\u0641 \u0641\u0642\u0637 \u0641\u064a notes.file_key.",
    "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u062d\u062c\u0645 \u0627\u0644\u0645\u0644\u0641 20 \u0645\u064a\u062c\u0627\u0628\u0627\u064a\u062a \u0648\u064a\u064f\u062a\u062d\u0642\u0642 \u0645\u0646\u0647 \u0641\u064a \u0637\u0628\u0642\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0642\u064a\u062f CHECK \u0639\u0644\u0649 notes.file_size_bytes.",
    "\u0627\u0644\u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u0648\u0633\u064a\u0637\u0629 (note_tags \u0648group_members \u0648group_notes) \u0644\u0647\u0627 \u0645\u0641\u062a\u0627\u062d \u0623\u0633\u0627\u0633\u064a \u0645\u0633\u062a\u0642\u0644 id\u060c \u0645\u0639 \u0642\u064a\u062f \u0641\u0631\u064a\u062f \u0639\u0644\u0649 \u0632\u0648\u062c \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u0623\u062c\u0646\u0628\u064a\u0629 \u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u0643\u0631\u0627\u0631.",
    "\u0627\u0644\u062d\u0630\u0641 \u0645\u0646 \u0642\u0628\u0644 \u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u062d\u0630\u0641 \u0645\u0646\u0637\u0642\u064a (status = removed \u0645\u0639 removed_at) \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0633\u062c\u0644 \u0627\u0644\u0628\u0644\u0627\u063a\u0627\u062a \u0648\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a.",
    "\u0627\u0644\u0628\u062d\u062b \u0627\u0644\u0646\u0635\u064a \u0641\u064a \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0648\u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0641\u0647\u0631\u0633 Full-Text Search \u0641\u064a PostgreSQL (GIN) \u0639\u0644\u0649 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0648\u0627\u0644\u0648\u0635\u0641 \u0648\u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0627\u062d\u064a\u0629\u060c \u0648\u062a\u064f\u0631\u062a\u064e\u0651\u0628 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u062d\u0633\u0628 \u0627\u0644\u0635\u0644\u0629. \u0623\u0645\u0627 \u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u0641\u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u062e\u0635\u0635 \u0639\u0628\u0631 courses.major_id.",
    "\u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0641\u064a \u0637\u0628\u0642\u0629 \u0627\u0644\u062e\u062f\u0645\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 student_profiles.profile_visibility \u0648\u0639\u0636\u0648\u064a\u0629 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a\u060c \u0641\u0644\u0627 \u062a\u064f\u0639\u0631\u0636 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0637\u0627\u0644\u0628 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0625\u0644\u0627 \u0644\u0623\u0639\u0636\u0627\u0621 \u0645\u062c\u0645\u0648\u0639\u0627\u062a\u0647.",
    "\u062c\u0644\u0633\u0627\u062a JWT \u0639\u062f\u064a\u0645\u0629 \u0627\u0644\u062d\u0627\u0644\u0629\u060c \u0644\u0630\u0644\u0643 \u0644\u0627 \u064a\u0648\u062c\u062f \u062c\u062f\u0648\u0644 \u0644\u0644\u062c\u0644\u0633\u0627\u062a. \u0623\u0645\u0627 \u0631\u0645\u0648\u0632 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0628\u0631\u064a\u062f \u0641\u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a email_verifications.",
    "\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0629 \u062a\u0638\u0647\u0631 \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0642\u0631\u0631 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0637\u0644\u0627\u0628\u060c \u0648\u062a\u064f\u0634\u0627\u0631\u064e\u0643 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0639\u0628\u0631 group_notes.",
    "\u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0647\u064a \u0635\u064a\u063a\u0629 \u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a\u060c \u0648\u064a\u0645\u0643\u0646 \u062a\u0648\u0633\u064a\u0639\u0647\u0627 \u0644\u0627\u062d\u0642\u0627\u064b \u0628\u062c\u062f\u0648\u0644 \u0631\u0633\u0627\u0626\u0644 \u0644\u0644\u0645\u062c\u0645\u0648\u0639\u0629."
  ]
