{
  "app_documentation": "\u0645\u0646\u0635\u0629 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u062c\u0627\u0645\u0639\u064a\u0629 \u0647\u064a \u062a\u0637\u0628\u064a\u0642 \u0648\u064a\u0628 \u0628\u0648\u0627\u062c\u0647\u0629 \u0639\u0631\u0628\u064a\u0629 (RTL) \u0645\u062a\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 \u0627\u0644\u062c\u0648\u0627\u0644\u060c \u064a\u062a\u064a\u062d \u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0648\u062a\u0635\u0646\u064a\u0641\u0647\u0627 \u062d\u0633\u0628 \u0627\u0644\u0645\u0642\u0631\u0631 \u0648\u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0645\u0646 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0632\u0645\u0644\u0627\u0626\u0647\u0645. \u0627\u0644\u063a\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0644\u0644\u0645\u0646\u0635\u0629 \u0647\u0648 \u062a\u0633\u0647\u064a\u0644 \u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a \u0628\u064a\u0646 \u0627\u0644\u0637\u0644\u0627\u0628 \u0641\u064a \u0628\u064a\u0626\u0629 \u0645\u0642\u062a\u0635\u0631\u0629 \u0639\u0644\u0649 \u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u062c\u0627\u0645\u0639\u064a\u060c \u0645\u0639 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u062c\u0648\u062f\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0648\u062e\u0635\u0648\u0635\u064a\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0637\u0644\u0627\u0628.\n\n\u062a\u0634\u0645\u0644 \u0627\u0644\u0645\u0646\u0635\u0629 \u062e\u0645\u0633 \u0645\u064a\u0632\u0627\u062a \u0631\u0626\u064a\u0633\u064a\u0629: (F1) \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a\u060c \u062d\u064a\u062b \u064a\u0646\u0634\u0626 \u0627\u0644\u0637\u0627\u0644\u0628 \u062d\u0633\u0627\u0628\u0647 \u0628\u0628\u0631\u064a\u062f\u0647 \u0627\u0644\u062c\u0627\u0645\u0639\u064a \u0648\u064a\u0633\u062a\u0644\u0645 \u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062a\u0641\u0639\u064a\u0644 \u062e\u0644\u0627\u0644 \u062f\u0642\u064a\u0642\u0629\u060c \u062b\u0645 \u064a\u0639\u062f\u0651\u0644 \u062a\u062e\u0635\u0635\u0647 \u0648\u0633\u0646\u062a\u0647 \u0627\u0644\u062f\u0631\u0627\u0633\u064a\u0629 \u0648\u062a\u0638\u0647\u0631 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0641\u0648\u0631\u0627\u064b\u061b (F2) \u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0628\u0631\u0641\u0639 \u0645\u0644\u0641\u0627\u062a PDF \u0623\u0648 \u0635\u0648\u0631 \u0628\u062d\u062c\u0645 \u0623\u0642\u0644 \u0645\u0646 20 \u0645\u064a\u062c\u0627\u0628\u0627\u064a\u062a \u0648\u062a\u0635\u0646\u064a\u0641\u0647\u0627 \u062d\u0633\u0628 \u0627\u0644\u0645\u0642\u0631\u0631 \u062b\u0645 \u0639\u0631\u0636\u0647\u0627 \u0648\u062a\u0646\u0632\u064a\u0644\u0647\u0627 \u0645\u0646 \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0622\u062e\u0631\u064a\u0646\u061b (F3) \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0623\u0648 \u0627\u0644\u062e\u0627\u0635\u0629\u060c \u062d\u064a\u062b \u064a\u0646\u0634\u0626 \u0627\u0644\u0637\u0627\u0644\u0628 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u064a\u0635\u0628\u062d \u0645\u0634\u0631\u0641\u0647\u0627 \u0648\u064a\u0642\u0628\u0644 \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0623\u0648 \u064a\u0631\u0641\u0636\u0647\u0627 \u0645\u0639 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a\u061b (F4) \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0639\u0646 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0648\u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u062d\u0633\u0628 \u0627\u0644\u0645\u0642\u0631\u0631 \u0623\u0648 \u0627\u0644\u062a\u062e\u0635\u0635 \u0623\u0648 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0627\u062d\u064a\u0629 \u0645\u0639 \u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u062d\u0633\u0628 \u0627\u0644\u0635\u0644\u0629\u061b (F5) \u0627\u0644\u0625\u0634\u0631\u0627\u0641 \u0648\u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u060c \u062d\u064a\u062b \u064a\u0628\u0644\u0651\u063a \u0627\u0644\u0637\u0627\u0644\u0628 \u0639\u0646 \u0645\u0644\u0627\u062d\u0638\u0629 \u0645\u062e\u0627\u0644\u0641\u0629 \u0648\u064a\u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0634\u0631\u0641\u0648\u0646 \u0648\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0628\u0644\u0627\u063a\u0627\u062a \u0648\u064a\u062d\u0630\u0641\u0648\u0646 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0639 \u0625\u0634\u0639\u0627\u0631 \u0635\u0627\u062d\u0628\u0647.\n\n\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0648\u0646 \u062b\u0644\u0627\u062b\u0629 \u0623\u062f\u0648\u0627\u0631: \u0627\u0644\u0637\u0627\u0644\u0628 (\u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0623\u0633\u0627\u0633\u064a)\u060c \u0648\u0645\u0634\u0631\u0641 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 (\u062f\u0648\u0631 \u062e\u0627\u0635 \u0628\u0643\u0644 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u064a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a group_members.role)\u060c \u0648\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 (system_admin) \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0646 \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0628\u0644\u0627\u063a\u0627\u062a \u0648\u062d\u0630\u0641 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u062e\u0627\u0644\u0641. \u0648\u062a\u064f\u0639\u0631\u0636 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0637\u0627\u0644\u0628 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0641\u0642\u0637 \u0644\u0623\u0639\u0636\u0627\u0621 \u0645\u062c\u0645\u0648\u0639\u0627\u062a\u0647 \u0648\u0641\u0642 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629.\n\n\u062a\u0642\u0646\u064a\u0627\u064b\u060c \u062a\u064f\u0628\u0646\u0649 \u0627\u0644\u0645\u0646\u0635\u0629 \u0628\u0648\u0627\u062c\u0647\u0629 React \u0648\u062e\u0627\u062f\u0645 Node.js \u0648\u0648\u0627\u062c\u0647\u0627\u062a REST API\u060c \u0648\u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0641\u064a Amazon S3 \u0648\u062a\u064f\u062d\u0641\u0638 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0641\u064a \u0642\u0627\u0639\u062f\u0629 PostgreSQL\u060c \u0648\u062a\u064f\u062f\u0627\u0631 \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0639\u0628\u0631 JWT \u0645\u0639 \u062a\u0634\u0641\u064a\u0631 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0628\u062e\u0648\u0627\u0631\u0632\u0645\u064a\u0629 bcrypt \u0648\u0646\u0642\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0628\u0631 HTTPS \u0641\u0642\u0637. \u0648\u062a\u0633\u062a\u0647\u062f\u0641 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0648\u0638\u064a\u0641\u064a\u0629 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0645\u0639 500 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062a\u0632\u0627\u0645\u0646\u060c \u0648\u062a\u0648\u0641\u0631\u0627\u064b \u0634\u0647\u0631\u064a\u0627\u064b \u0644\u0627 \u064a\u0642\u0644 \u0639\u0646 99.5%\u060c \u0648\u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0637\u0627\u0644\u0628 \u0627\u0644\u062c\u062f\u064a\u062f \u0631\u0641\u0639 \u0623\u0648\u0644 \u0645\u0644\u0627\u062d\u0638\u0629 \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062b\u0644\u0627\u062b \u062f\u0642\u0627\u0626\u0642 \u062f\u0648\u0646 \u0645\u0633\u0627\u0639\u062f\u0629. \u0648\u062a\u062a\u0636\u0645\u0646 \u062e\u0637\u0629 \u0627\u0644\u0645\u0646\u062a\u062c \u0627\u0644\u0623\u062f\u0646\u0649 \u0627\u0644\u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u062b\u0646\u062a\u064a \u0639\u0634\u0631\u0629 \u0645\u0647\u0645\u0629 (T1 \u0625\u0644\u0649 T12) \u062a\u0628\u062f\u0623 \u0628\u062a\u0635\u0645\u064a\u0645 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u062a\u0646\u062a\u0647\u064a \u0628\u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0634\u0627\u0645\u0644 \u0648\u0646\u0634\u0631 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629.",
