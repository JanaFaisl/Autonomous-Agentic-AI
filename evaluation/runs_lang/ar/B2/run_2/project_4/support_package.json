  "glossary": {
    "\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629": "\u0645\u0644\u0641 \u062f\u0631\u0627\u0633\u064a \u0628\u0635\u064a\u063a\u0629 PDF \u0623\u0648 \u0635\u0648\u0631\u0629 \u0644\u0627 \u064a\u062a\u062c\u0627\u0648\u0632 \u062d\u062c\u0645\u0647 20 \u0645\u064a\u062c\u0627\u0628\u0627\u064a\u062a\u060c \u064a\u0631\u0641\u0639\u0647 \u0627\u0644\u0637\u0627\u0644\u0628 \u0648\u064a\u0635\u0646\u0651\u0641\u0647 \u062d\u0633\u0628 \u0627\u0644\u0645\u0642\u0631\u0631 \u0648\u064a\u0634\u0627\u0631\u0643\u0647 \u0645\u0639 \u0632\u0645\u0644\u0627\u0626\u0647\u060c \u0648\u064a\u064f\u062d\u0641\u0638 \u0645\u0641\u062a\u0627\u062d\u0647 \u0641\u064a \u0627\u0644\u062d\u0642\u0644 notes.file_key \u0628\u064a\u0646\u0645\u0627 \u064a\u064f\u062e\u0632\u064e\u0651\u0646 \u0627\u0644\u0645\u0644\u0641 \u0646\u0641\u0633\u0647 \u0641\u064a Amazon S3.",
    "\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0631\u0627\u0633\u0629": "\u0645\u062c\u0645\u0648\u0639\u0629 \u0639\u0627\u0645\u0629 \u0623\u0648 \u062e\u0627\u0635\u0629 \u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0645\u0642\u0631\u0631 \u0645\u0639\u064a\u0646 (\u062c\u062f\u0648\u0644 study_groups)\u060c \u064a\u0646\u0634\u0626\u0647\u0627 \u0637\u0627\u0644\u0628 \u0648\u064a\u0635\u0628\u062d \u0645\u0634\u0631\u0641\u0647\u0627\u060c \u0648\u064a\u062a\u0641\u0627\u0639\u0644 \u0623\u0639\u0636\u0627\u0624\u0647\u0627 \u0648\u064a\u0634\u0627\u0631\u0643\u0648\u0646 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u062f\u0627\u062e\u0644\u0647\u0627.",
    "\u0645\u0634\u0631\u0641 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629": "\u0627\u0644\u0637\u0627\u0644\u0628 \u0627\u0644\u0630\u064a \u0623\u0646\u0634\u0623 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u064a\u0645\u0644\u0643 \u0635\u0644\u0627\u062d\u064a\u0629 \u0642\u0628\u0648\u0644 \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0623\u0648 \u0631\u0641\u0636\u0647\u0627 \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629\u060c \u0648\u064a\u064f\u062d\u062f\u064e\u0651\u062f \u062f\u0648\u0631\u0647 \u0628\u0627\u0644\u0642\u064a\u0645\u0629 supervisor \u0641\u064a \u0627\u0644\u062d\u0642\u0644 group_members.role.",
    "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u062c\u0627\u0645\u0639\u064a": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0627\u0644\u0631\u0633\u0645\u064a \u0644\u0644\u0637\u0627\u0644\u0628 \u0636\u0645\u0646 \u0646\u0637\u0627\u0642 \u0627\u0644\u062c\u0627\u0645\u0639\u0629\u060c \u0648\u0647\u0648 \u0634\u0631\u0637 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0641\u064a \u0627\u0644\u0645\u0646\u0635\u0629 \u0648\u064a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a \u0627\u0644\u062d\u0642\u0644 users.university_email \u0648\u064a\u064f\u0641\u0639\u064e\u0651\u0644 \u0639\u0628\u0631 \u0631\u0633\u0627\u0644\u0629 \u062a\u0641\u0639\u064a\u0644.",
    "\u0627\u0644\u0628\u0644\u0627\u063a": "\u0637\u0644\u0628 \u064a\u0642\u062f\u0645\u0647 \u0627\u0644\u0637\u0627\u0644\u0628 \u0644\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0645\u0644\u0627\u062d\u0638\u0629 \u0645\u062e\u0627\u0644\u0641\u0629 \u0645\u0639 \u0630\u0643\u0631 \u0627\u0644\u0633\u0628\u0628 (\u062c\u062f\u0648\u0644 content_reports)\u060c \u0648\u064a\u0631\u0627\u062c\u0639\u0647 \u0627\u0644\u0645\u0634\u0631\u0641\u0648\u0646 \u0648\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u062b\u0645 \u064a\u064f\u062a\u062c\u0627\u0647\u0644 \u0623\u0648 \u064a\u064f\u062d\u0630\u0641 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0639 \u0625\u0634\u0639\u0627\u0631 \u0635\u0627\u062d\u0628\u0647.",
    "\u0627\u0644\u062d\u0630\u0641 \u0627\u0644\u0645\u0646\u0637\u0642\u064a": "\u062d\u0630\u0641 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629 \u0628\u062a\u063a\u064a\u064a\u0631 \u062d\u0627\u0644\u062a\u0647\u0627 \u0625\u0644\u0649 removed \u0648\u062a\u0633\u062c\u064a\u0644 \u0648\u0642\u062a \u0627\u0644\u062d\u0630\u0641 \u0641\u064a removed_at \u062f\u0648\u0646 \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0633\u062c\u0644 \u0641\u0639\u0644\u064a\u0627\u064b\u060c \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0633\u062c\u0644 \u0627\u0644\u0628\u0644\u0627\u063a\u0627\u062a \u0648\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a."
  }
}