  "features": [
    {
      "id": "F1",
      "name": "\u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a",
      "description": "\u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u0644\u0644\u0637\u0627\u0644\u0628 \u0628\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u062c\u0627\u0645\u0639\u064a \u0648\u0625\u062f\u0627\u0631\u0629 \u0645\u0644\u0641\u0647 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0637\u0627\u0644\u0628\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0628\u0628\u0631\u064a\u062f\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u064a \u062d\u062a\u0649 \u0623\u0636\u0645\u0646 \u0623\u0646 \u0627\u0644\u0645\u0646\u0635\u0629 \u0645\u0642\u062a\u0635\u0631\u0629 \u0639\u0644\u0649 \u0637\u0644\u0627\u0628 \u0627\u0644\u062c\u0627\u0645\u0639\u0629.",
        "\u0628\u0635\u0641\u062a\u064a \u0637\u0627\u0644\u0628\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u062a\u0639\u062f\u064a\u0644 \u062a\u062e\u0635\u0635\u064a \u0648\u0633\u0646\u062a\u064a \u0627\u0644\u062f\u0631\u0627\u0633\u064a\u0629 \u062d\u062a\u0649 \u064a\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0651 \u0632\u0645\u0644\u0627\u0626\u064a \u0628\u0633\u0647\u0648\u0644\u0629."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0625\u062f\u062e\u0627\u0644 \u0628\u0631\u064a\u062f \u062c\u0627\u0645\u0639\u064a \u0635\u0627\u0644\u062d\u060c \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u062a\u0633\u062c\u064a\u0644 \u062d\u0633\u0627\u0628\u060c \u0641\u0633\u064a\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0631\u0633\u0627\u0644\u0629 \u062a\u0641\u0639\u064a\u0644 \u062e\u0644\u0627\u0644 \u062f\u0642\u064a\u0642\u0629.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644\u060c \u0639\u0646\u062f \u062d\u0641\u0638 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a\u060c \u0641\u0633\u062a\u0638\u0647\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0641\u0648\u0631\u0627\u064b."
      ]
    },
    {
      "id": "F2",
      "name": "\u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629",
      "description": "\u0631\u0641\u0639 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0648\u0645\u0634\u0627\u0631\u0643\u062a\u0647\u0627 \u0645\u0639 \u0627\u0644\u0632\u0645\u0644\u0627\u0621 \u0648\u062a\u0635\u0646\u064a\u0641\u0647\u0627 \u062d\u0633\u0628 \u0627\u0644\u0645\u0642\u0631\u0631.",
      "priority": "High",
      "user_stories": [
