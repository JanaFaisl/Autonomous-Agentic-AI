{
  "project_name": "\u062a\u0637\u0628\u064a\u0642 \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0648\u0631\u0648\u062f",
  "features": [
    {
      "id": "F1",
      "name": "\u062a\u0635\u0641\u062d \u0627\u0644\u0648\u0631\u0648\u062f",
      "description": "\u0639\u0631\u0636 \u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u0627\u0644\u0628\u0627\u0642\u0627\u062a \u0645\u0639 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u062a\u0635\u0641\u064a\u0629.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0639\u0645\u064a\u0644\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u062a\u0635\u0641\u062d \u0627\u0644\u0648\u0631\u0648\u062f \u062d\u0633\u0628 \u0627\u0644\u0646\u0648\u0639 \u0648\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0643\u064a \u0623\u062c\u062f \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0628\u0633\u0631\u0639\u0629.",
        "\u0628\u0635\u0641\u062a\u064a \u0639\u0645\u064a\u0644\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0644\u0628\u062d\u062b \u0648\u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u062d\u0633\u0628 \u0627\u0644\u0633\u0639\u0631 \u0648\u0627\u0644\u0644\u0648\u0646 \u0644\u0643\u064a \u0623\u0635\u0644 \u0625\u0644\u0649 \u0645\u0627 \u064a\u0646\u0627\u0633\u0628 \u0645\u064a\u0632\u0627\u0646\u064a\u062a\u064a."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0639\u0645\u064a\u0644 \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c\u060c \u0639\u0646\u062f\u0645\u0627 \u064a\u062e\u062a\u0627\u0631 \u062a\u0635\u0646\u064a\u0641\u0627\u064b\u060c \u0641\u0625\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u0639\u0631\u0636 \u0627\u0644\u0648\u0631\u0648\u062f \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0645\u0639 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0639\u0645\u064a\u0644 \u0623\u062f\u062e\u0644 \u0643\u0644\u0645\u0629 \u0628\u062d\u062b\u060c \u0639\u0646\u062f\u0645\u0627 \u064a\u0636\u063a\u0637 \u0639\u0644\u0649 \u0628\u062d\u062b\u060c \u0641\u0625\u0646 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0641\u0642\u0637 \u062a\u0638\u0647\u0631 \u062e\u0644\u0627\u0644 \u062b\u0627\u0646\u064a\u062a\u064a\u0646."
      ]
    },
    {
      "id": "F2",
      "name": "\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0648\u0627\u0644\u062f\u0641\u0639",
      "description": "\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0648\u0631\u0648\u062f \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0648\u062a\u062d\u062f\u064a\u062f \u0639\u0646\u0648\u0627\u0646 \u0648\u0645\u0648\u0639\u062f \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0648\u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u062f\u0641\u0639 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0627\u064b.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0639\u0645\u064a\u0644\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0648\u0631\u0648\u062f \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0637\u0644\u0628 \u0644\u0643\u064a \u0623\u0634\u062a\u0631\u064a \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u062a\u064a \u0627\u062e\u062a\u0631\u062a\u0647\u0627.",
        "\u0628\u0635\u0641\u062a\u064a \u0639\u0645\u064a\u0644\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0648\u0645\u0648\u0639\u062f \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0648\u0625\u0636\u0627\u0641\u0629 \u0628\u0637\u0627\u0642\u0629 \u0625\u0647\u062f\u0627\u0621 \u0644\u0643\u064a \u062a\u0635\u0644 \u0627\u0644\u0647\u062f\u064a\u0629 \u0641\u064a \u0648\u0642\u062a\u0647\u0627."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0633\u0644\u0629 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u0646\u062a\u062c\u0627\u062a\u060c \u0639\u0646\u062f\u0645\u0627 \u064a\u0624\u0643\u062f \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0637\u0644\u0628 \u0648\u0627\u0644\u062f\u0641\u0639\u060c \u0641\u0625\u0646 \u0627\u0644\u0646\u0638\u0627\u0645 \u064a\u0646\u0634\u0626 \u0627\u0644\u0637\u0644\u0628 \u0648\u064a\u0631\u0633\u0644 \u0625\u0634\u0639\u0627\u0631 \u062a\u0623\u0643\u064a\u062f.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0639\u0645\u064a\u0644 \u0644\u0645 \u064a\u062d\u062f\u062f \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0648\u0635\u064a\u0644\u060c \u0639\u0646\u062f\u0645\u0627 \u064a\u062d\u0627\u0648\u0644 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0637\u0644\u0628\u060c \u0641\u0625\u0646 \u0627\u0644\u0646\u0638\u0627\u0645 \u064a\u0645\u0646\u0639\u0647 \u0648\u064a\u0637\u0644\u0628 \u0625\u062f\u062e\u0627\u0644 \u0627\u0644\u0639\u0646\u0648\u0627\u0646."
      ]
    },
    {
      "id": "F3",
      "name": "\u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0648\u062a\u062a\u0628\u0639 \u0627\u0644\u0637\u0644\u0628",
      "description": "\u062a\u062a\u0628\u0639 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u0644\u062d\u0638\u064a\u0627\u064b \u062d\u062a\u0649 \u0648\u0635\u0648\u0644\u0647 \u0625\u0644\u0649 \u0628\u0627\u0628 \u0645\u0646\u0632\u0644 \u0627\u0644\u0639\u0645\u064a\u0644 \u0648\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0639\u0645\u064a\u0644\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u062a\u062a\u0628\u0639 \u062d\u0627\u0644\u0629 \u0637\u0644\u0628\u064a \u0648\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0644\u0643\u064a \u0623\u0639\u0631\u0641 \u0645\u0648\u0639\u062f \u0648\u0635\u0648\u0644 \u0627\u0644\u0648\u0631\u0648\u062f.",
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0646\u062f\u0648\u0628 \u062a\u0648\u0635\u064a\u0644\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u062a\u062d\u062f\u064a\u062b \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u0648\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0644\u0643\u064a \u064a\u064f\u063a\u0644\u0642 \u0627\u0644\u0637\u0644\u0628 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0637\u0644\u0628 \u0642\u064a\u062f \u0627\u0644\u062a\u0648\u0635\u064a\u0644\u060c \u0639\u0646\u062f\u0645\u0627 \u064a\u0641\u062a\u062d \u0627\u0644\u0639\u0645\u064a\u0644 \u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u062a\u0628\u0639\u060c \u0641\u0625\u0646 \u0627\u0644\u062d\u0627\u0644\u0629 \u0648\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u064a\u062a\u062d\u062f\u062b\u0627\u0646 \u0643\u0644 30 \u062b\u0627\u0646\u064a\u0629.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0648\u0635\u0644 \u0625\u0644\u0649 \u0627\u0644\u0639\u0646\u0648\u0627\u0646\u060c \u0639\u0646\u062f\u0645\u0627 \u064a\u0624\u0643\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645\u060c \u0641\u0625\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u062a\u062a\u063a\u064a\u0631 \u0625\u0644\u0649 \u062a\u0645 \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0648\u064a\u0635\u0644 \u0625\u0634\u0639\u0627\u0631 \u0644\u0644\u0639\u0645\u064a\u0644."
