    {
      "id": "F4",
      "name": "\u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u0633\u062c\u0644 \u0627\u0644\u0637\u0644\u0628\u0627\u062a",
      "description": "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646 \u0648\u0639\u0631\u0636 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0645\u0639 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0637\u0644\u0628.",
      "priority": "Medium",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0639\u0645\u064a\u0644\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u0648\u062d\u0641\u0638 \u0639\u0646\u0627\u0648\u064a\u0646\u064a \u0644\u0643\u064a \u0623\u0633\u0631\u0651\u0639 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u0627\u0644\u0645\u0631\u0627\u062a \u0627\u0644\u0642\u0627\u062f\u0645\u0629.",
        "\u0628\u0635\u0641\u062a\u064a \u0639\u0645\u064a\u0644\u0627\u064b\u060c \u064a\u0645\u0643\u0646\u0646\u064a \u0639\u0631\u0636 \u0637\u0644\u0628\u0627\u062a\u064a \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0648\u0625\u0639\u0627\u062f\u0629 \u0637\u0644\u0628\u0647\u0627 \u0644\u0643\u064a \u0623\u0643\u0631\u0631 \u0634\u0631\u0627\u0621 \u0628\u0627\u0642\u062a\u064a \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0628\u0633\u0647\u0648\u0644\u0629."
