  "required_fixes": [
    "\u0625\u0636\u0627\u0641\u0629 \u062d\u0642\u0644\u064a \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0625\u0644\u0649 \u0634\u0627\u0634\u0629 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628\u060c \u0623\u0648 \u062c\u0639\u0644 email \u0648password_hash \u0627\u062e\u062a\u064a\u0627\u0631\u064a\u064a\u0646 \u0648\u0627\u0639\u062a\u0645\u0627\u062f \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0628\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644 \u0641\u064a \u062c\u062f\u0648\u0644 users.",
