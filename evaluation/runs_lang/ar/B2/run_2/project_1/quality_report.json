      "severity": "High",
      "item": "\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 (F4)",
      "message": "\u0634\u0627\u0634\u0629 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u062a\u062c\u0645\u0639 \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644 \u0648\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644 \u0641\u0642\u0637\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u0634\u062a\u0631\u0637 \u062c\u062f\u0648\u0644 users \u0627\u0644\u0642\u064a\u0645\u062a\u064a\u0646 email \u0648password_hash (not null) \u0641\u0644\u0627 \u064a\u0645\u0643\u0646 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u0623\u0648 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0643\u0645\u0627 \u0635\u064f\u0645\u0651\u0645."
    },
    {
      "severity": "Medium",
      "item": "\u0627\u0644\u062a\u0646\u0642\u0644 \u0627\u0644\u0633\u0641\u0644\u064a: \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0648\u0637\u0644\u0628\u0627\u062a\u064a",
      "message": "\u0634\u0631\u064a\u0637 \u0627\u0644\u062a\u0646\u0642\u0644 \u064a\u062a\u0636\u0645\u0646 \u00ab\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a\u00bb \u0648\u00ab\u0637\u0644\u0628\u0627\u062a\u064a\u00bb \u0644\u0643\u0646 \u0644\u0627 \u062a\u0648\u062c\u062f \u0634\u0627\u0634\u0629 \u0645\u0639\u0631\u0651\u0641\u0629 \u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0631\u063a\u0645 \u0627\u0639\u062a\u0645\u0627\u062f F2 \u0648F3 \u0648F5 \u0639\u0644\u064a\u0647\u0627 (\u062c\u062f\u0648\u0644 notifications)\u060c \u0648\u0644\u0627 \u0634\u0627\u0634\u0629 \u0645\u0633\u062a\u0642\u0644\u0629 \u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0637\u0644\u0628\u0627\u062a."
    },
    {
      "severity": "Medium",
      "item": "\u0645\u0631\u0627\u062d\u0644 \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u062a\u062a\u0628\u0639 \u0627\u0644\u0637\u0644\u0628",
      "message": "\u0627\u0644\u062e\u0637 \u0627\u0644\u0632\u0645\u0646\u064a \u064a\u0639\u0631\u0636 \u00ab\u0642\u064a\u062f \u0627\u0644\u062a\u062d\u0636\u064a\u0631\u00bb \u0628\u064a\u0646\u0645\u0627 \u0642\u064a\u0645 orders.status \u0647\u064a pending_payment \u0648paid \u0648assigned \u0648out_for_delivery \u0648delivered \u0648cancelled \u062f\u0648\u0646 \u062d\u0627\u0644\u0629 \u0645\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u062d\u0636\u064a\u0631."
    },
    {
      "severity": "Medium",
      "item": "\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0644\u0648\u062d\u0629 \u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u062a\u062c\u0631 (F5)",
      "message": "\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u0646\u062a\u062c \u064a\u0636\u0645 \u0627\u0644\u0627\u0633\u0645 \u0648\u0627\u0644\u0633\u0639\u0631 \u0648\u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0648\u0627\u0644\u0644\u0648\u0646 \u0648\u0627\u0644\u0635\u0648\u0631\u0629 \u0641\u0642\u0637\u060c \u0628\u064a\u0646\u0645\u0627 products.category_id \u0625\u0644\u0632\u0627\u0645\u064a \u0648\u0644\u0627 \u062a\u0648\u062c\u062f \u062d\u0642\u0648\u0644 \u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0623\u0648 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0623\u0648 \u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u062a\u062c (product_type) \u0627\u0644\u062a\u064a \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u064a\u0647\u0627 \u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u0641\u064a F1."
    },
    {
      "severity": "Medium",
      "item": "\u0639\u0646\u0627\u0635\u0631 \u062a\u0635\u0645\u064a\u0645 \u0628\u0644\u0627 \u0633\u0646\u062f \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0623\u0648 \u0627\u0644\u0642\u0627\u0639\u062f\u0629",
      "message": "\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u064a\u062a\u0636\u0645\u0646 \u00ab\u0625\u0636\u0627\u0641\u0629 \u0644\u0644\u0645\u0641\u0636\u0644\u0629\u00bb \u0648\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u062a\u0628\u0639 \u0648\u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u062e\u0644\u0627\u0644 15 \u062f\u0642\u064a\u0642\u0629 \u0648\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0644\u063a\u0629 \u0648\u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629\u060c \u0648\u0647\u064a \u063a\u064a\u0631 \u0648\u0627\u0631\u062f\u0629 \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u0644\u0647\u0627 \u062c\u062f\u0648\u0644 \u0623\u0648 \u0639\u0645\u0648\u062f \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a."
    }
