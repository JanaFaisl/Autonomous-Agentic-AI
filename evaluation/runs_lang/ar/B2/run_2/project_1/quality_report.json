    "\u062a\u0648\u062d\u064a\u062f \u0645\u0631\u0627\u062d\u0644 \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0645\u0639 \u0642\u064a\u0645 orders.status\u060c \u0625\u0645\u0627 \u0628\u062d\u0630\u0641 \u00ab\u0642\u064a\u062f \u0627\u0644\u062a\u062d\u0636\u064a\u0631\u00bb \u0623\u0648 \u0628\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0642\u0627\u0628\u0644\u0629 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a.",
    "\u0625\u0636\u0627\u0641\u0629 \u062d\u0642\u0648\u0644 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0648\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0627\u062a \u0648\u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u062a\u062c \u0648\u0627\u0644\u0648\u0635\u0641 \u0625\u0644\u0649 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u062f\u064a\u0631\u060c \u0648\u062d\u0630\u0641 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u063a\u064a\u0631 \u0627\u0644\u0645\u0633\u0646\u0648\u062f\u0629 (\u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0648\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0631\u0627\u0628\u0637) \u0623\u0648 \u0625\u0636\u0627\u0641\u062a\u0647\u0627 \u0625\u0644\u0649 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0648\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a."
