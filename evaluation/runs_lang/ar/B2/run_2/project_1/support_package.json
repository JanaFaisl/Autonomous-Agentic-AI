{
  "app_documentation": "\u062a\u0637\u0628\u064a\u0642 \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0648\u0631\u0648\u062f \u0647\u0648 \u0645\u0646\u0635\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u0644\u0644\u062c\u0648\u0627\u0644 (React Native) \u0648\u0627\u0644\u0648\u064a\u0628 (React) \u062a\u062a\u064a\u062d \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0637\u0644\u0628 \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u0627\u0644\u0628\u0627\u0642\u0627\u062a \u0648\u062a\u0648\u0635\u064a\u0644\u0647\u0627 \u0625\u0644\u0649 \u0639\u0646\u0627\u0648\u064a\u0646\u0647\u0645 \u0641\u064a \u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0645\u062d\u062f\u062f. \u062a\u0639\u062a\u0645\u062f \u0627\u0644\u0645\u0646\u0635\u0629 \u0639\u0644\u0649 \u0648\u0627\u062c\u0647\u0629 \u0639\u0631\u0628\u064a\u0629 \u0643\u0627\u0645\u0644\u0629 \u0628\u0627\u062a\u062c\u0627\u0647 RTL \u0648\u062e\u0637 Cairo \u0648\u0623\u0644\u0648\u0627\u0646 \u062f\u0627\u0641\u0626\u0629\u060c \u0648\u064a\u0645\u0643\u0646 \u0644\u0644\u0639\u0645\u064a\u0644 \u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 5 \u062e\u0637\u0648\u0627\u062a. \u064a\u0647\u062f\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0625\u0644\u0649 \u062a\u0628\u0633\u064a\u0637 \u062a\u062c\u0631\u0628\u0629 \u0634\u0631\u0627\u0621 \u0627\u0644\u0647\u062f\u0627\u064a\u0627 \u0627\u0644\u0632\u0647\u0631\u064a\u0629 \u0648\u062a\u062a\u0628\u0639\u0647\u0627 \u062d\u062a\u0649 \u062a\u0633\u0644\u064a\u0645\u0647\u0627\u060c \u0645\u0639 \u062a\u0642\u062f\u064a\u0645 \u0644\u0648\u062d\u0627\u062a \u0645\u0646\u0641\u0635\u0644\u0629 \u0644\u0644\u0645\u0646\u062f\u0648\u0628 \u0648\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u062a\u062c\u0631.\n\n\u062a\u0634\u0645\u0644 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u062e\u0645\u0633 \u0645\u064a\u0632\u0627\u062a. \u0627\u0644\u0645\u064a\u0632\u0629 F1 \u0647\u064a \u062a\u0635\u0641\u062d \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u0627\u0644\u0628\u0627\u0642\u0627\u062a \u062d\u0633\u0628 \u0627\u0644\u0646\u0648\u0639 \u0648\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0645\u0639 \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u062d\u0633\u0628 \u0627\u0644\u0633\u0639\u0631 \u0648\u0627\u0644\u0644\u0648\u0646\u060c \u0648\u062a\u0638\u0647\u0631 \u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0628\u062d\u062b \u062e\u0644\u0627\u0644 \u062b\u0627\u0646\u064a\u062a\u064a\u0646. \u0627\u0644\u0645\u064a\u0632\u0629 F2 \u0647\u064a \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0648\u062a\u062d\u062f\u064a\u062f \u0639\u0646\u0648\u0627\u0646 \u0648\u0645\u0648\u0639\u062f \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0648\u0625\u0636\u0627\u0641\u0629 \u0628\u0637\u0627\u0642\u0629 \u0625\u0647\u062f\u0627\u0621 \u062b\u0645 \u0627\u0644\u062f\u0641\u0639 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0627\u064b\u060c \u0645\u0639 \u0645\u0646\u0639 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0637\u0644\u0628 \u0625\u0630\u0627 \u0644\u0645 \u064a\u064f\u062d\u062f\u062f \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0648\u0625\u0631\u0633\u0627\u0644 \u0625\u0634\u0639\u0627\u0631 \u062a\u0623\u0643\u064a\u062f \u0628\u0639\u062f \u0646\u062c\u0627\u062d \u0627\u0644\u062f\u0641\u0639. \u0627\u0644\u0645\u064a\u0632\u0629 F3 \u0647\u064a \u062a\u062a\u0628\u0639 \u0627\u0644\u0637\u0644\u0628 \u0644\u062d\u0638\u064a\u0627\u064b \u0639\u0644\u0649 \u062e\u0631\u064a\u0637\u0629 Google Maps \u0645\u0639 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u062d\u0627\u0644\u0629 \u0648\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0643\u0644 30 \u062b\u0627\u0646\u064a\u0629 \u0648\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0645\u0646 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0645\u0639 \u0625\u0634\u0639\u0627\u0631 \u0644\u0644\u0639\u0645\u064a\u0644. \u0627\u0644\u0645\u064a\u0632\u0629 F4 \u0647\u064a \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u0633\u062c\u0644 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u0648\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0637\u0644\u0628\u060c \u0645\u0639 \u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0645\u0646 \u0627\u0644\u0623\u062d\u062f\u062b \u0625\u0644\u0649 \u0627\u0644\u0623\u0642\u062f\u0645. \u0627\u0644\u0645\u064a\u0632\u0629 F5 \u0647\u064a \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0648\u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0644\u0644\u0645\u062f\u064a\u0631: \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u062a\u0639\u062f\u064a\u0644 \u0623\u0633\u0639\u0627\u0631\u0647\u0627 \u0648\u0645\u062e\u0632\u0648\u0646\u0647\u0627\u060c \u0648\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629 \u0648\u0625\u0633\u0646\u0627\u062f\u0647\u0627 \u0625\u0644\u0649 \u0627\u0644\u0645\u0646\u062f\u0648\u0628\u064a\u0646 \u0645\u0639 \u0625\u0634\u0639\u0627\u0631\u0647\u0645.\n\n\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0648\u0646 \u062b\u0644\u0627\u062b\u0629 \u0623\u062f\u0648\u0627\u0631: \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0630\u064a \u064a\u062a\u0635\u0641\u062d \u0648\u064a\u0637\u0644\u0628 \u0648\u064a\u062a\u062a\u0628\u0639\u060c \u0648\u0645\u0646\u062f\u0648\u0628 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u0644\u0645 \u0627\u0644\u0645\u0647\u0627\u0645 \u0648\u064a\u062d\u062f\u0651\u062b \u062d\u0627\u0644\u062a\u0647\u0627 \u0648\u064a\u0624\u0643\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645\u060c \u0648\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u062a\u062c\u0631 \u0627\u0644\u0630\u064a \u064a\u062f\u064a\u0631 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0648\u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0648\u0627\u0631\u062f\u0629. \u062a\u064f\u0628\u0646\u0649 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0639\u0644\u0649 Node.js \u0648\u0648\u0627\u062c\u0647\u0627\u062a REST API \u0648\u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a PostgreSQL\u060c \u0648\u062a\u064f\u0631\u0633\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0639\u0628\u0631 Firebase Cloud Messaging\u060c \u0648\u064a\u062a\u0645 \u0627\u0644\u062f\u0641\u0639 \u0639\u0628\u0631 \u0628\u0648\u0627\u0628\u0629 \u062f\u0641\u0639 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u062f\u0648\u0646 \u062a\u062e\u0632\u064a\u0646 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u0635\u0631\u0641\u064a\u0629 \u0639\u0644\u0649 \u062e\u0648\u0627\u062f\u0645 \u0627\u0644\u0646\u0638\u0627\u0645.\n\n\u062a\u0644\u062a\u0632\u0645 \u0627\u0644\u0645\u0646\u0635\u0629 \u0628\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u063a\u064a\u0631 \u0648\u0638\u064a\u0641\u064a\u0629 \u0648\u0627\u0636\u062d\u0629: \u062a\u062d\u0645\u064a\u0644 \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0639\u0646\u062f 200 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062a\u0632\u0627\u0645\u0646\u060c \u0648\u062a\u0634\u0641\u064a\u0631 \u062c\u0645\u064a\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u0639\u0628\u0631 HTTPS\u060c \u0648\u062a\u0648\u0641\u0631 \u0627\u0644\u062e\u062f\u0645\u0629 \u0628\u0646\u0633\u0628\u0629 99.5% \u0634\u0647\u0631\u064a\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\u060c \u0648\u062d\u0645\u0627\u064a\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646 \u0648\u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0644\u0623\u063a\u0631\u0627\u0636 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0641\u0642\u0637 \u0628\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644. \u0648\u062a\u062a\u0636\u0645\u0646 \u062e\u0637\u0629 MVP \u062e\u0645\u0633 \u0639\u0634\u0631\u0629 \u0645\u0647\u0645\u0629 (T1 \u0625\u0644\u0649 T15) \u062a\u0628\u062f\u0623 \u0628\u062a\u0635\u0645\u064a\u0645 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a \u0648\u062a\u0646\u062a\u0647\u064a \u0628\u0627\u062e\u062a\u0628\u0627\u0631 \u0634\u0627\u0645\u0644 \u0648\u0646\u0634\u0631 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629.",
