  "glossary": {
    "\u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u0627\u0644\u0628\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u0639\u0631\u0648\u0636\u0629 \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0645\u0639 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631\u060c \u0648\u064a\u0645\u0643\u0646 \u0627\u0644\u0628\u062d\u062b \u0641\u064a\u0647\u0627 \u0648\u062a\u0635\u0641\u064a\u062a\u0647\u0627 \u062d\u0633\u0628 \u0627\u0644\u0641\u0626\u0629 \u0648\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0648\u0627\u0644\u0633\u0639\u0631 \u0648\u0627\u0644\u0644\u0648\u0646 (\u062c\u062f\u0627\u0648\u0644 products \u0648categories \u0648occasions \u0648colors).",
    "\u0627\u0644\u0645\u0646\u062f\u0648\u0628": "\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u062f\u0648\u0631 courier \u0645\u0633\u0624\u0648\u0644 \u0639\u0646 \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0633\u0646\u062f\u0629 \u0625\u0644\u064a\u0647 \u0648\u062a\u062d\u062f\u064a\u062b \u062d\u0627\u0644\u062a\u0647\u0627 \u0648\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645\u060c \u0648\u064a\u064f\u0633\u062c\u064e\u0651\u0644 \u0645\u0648\u0642\u0639\u0647 \u0643\u0644 30 \u062b\u0627\u0646\u064a\u0629 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0641\u064a \u062c\u062f\u0648\u0644 courier_locations.",
    "\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u062a\u062c\u0631": "\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u062f\u0648\u0631 store_manager \u064a\u062f\u064a\u0631 \u0627\u0644\u0648\u0631\u0648\u062f \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0648\u064a\u062a\u0627\u0628\u0639 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629 \u0648\u064a\u0633\u0646\u062f\u0647\u0627 \u0625\u0644\u0649 \u0627\u0644\u0645\u0646\u062f\u0648\u0628\u064a\u0646.",
    "\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0625\u0647\u062f\u0627\u0621": "\u0631\u0633\u0627\u0644\u0629 \u0646\u0635\u064a\u0629 \u0627\u062e\u062a\u064a\u0627\u0631\u064a\u0629 \u064a\u0643\u062a\u0628\u0647\u0627 \u0627\u0644\u0639\u0645\u064a\u0644 \u0644\u0644\u0645\u064f\u0647\u062f\u0649 \u0625\u0644\u064a\u0647 \u0648\u062a\u064f\u062d\u0641\u0638 \u0636\u0645\u0646 \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u0627\u0644\u0639\u0645\u0648\u062f orders.gift_card_message \u0648\u0644\u0627 \u062a\u064f\u0639\u0627\u0645\u0644 \u0643\u0645\u0646\u062a\u062c \u0645\u0646\u0641\u0635\u0644.",
    "\u062a\u062a\u0628\u0639 \u0627\u0644\u0637\u0644\u0628": "\u0634\u0627\u0634\u0629 \u062a\u0639\u0631\u0636 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 (pending_payment \u0648paid \u0648assigned \u0648out_for_delivery \u0648delivered \u0648cancelled) \u0648\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0646\u062f\u0648\u0628 \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0645\u0639 \u062a\u062d\u062f\u064a\u062b \u0643\u0644 30 \u062b\u0627\u0646\u064a\u0629.",
    "\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0637\u0644\u0628": "\u0625\u062c\u0631\u0627\u0621 \u064a\u062a\u064a\u062d \u0644\u0644\u0639\u0645\u064a\u0644 \u062a\u0643\u0631\u0627\u0631 \u0637\u0644\u0628 \u0633\u0627\u0628\u0642 \u0628\u0625\u0636\u0627\u0641\u0629 \u0645\u0646\u062a\u062c\u0627\u062a\u0647 \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0645\u062c\u062f\u062f\u0627\u064b\u060c \u0648\u064a\u064f\u0631\u0628\u0637 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u062c\u062f\u064a\u062f \u0628\u0627\u0644\u0633\u0627\u0628\u0642 \u0639\u0628\u0631 \u0627\u0644\u0639\u0645\u0648\u062f orders.reorder_of_order_id."
  }
}