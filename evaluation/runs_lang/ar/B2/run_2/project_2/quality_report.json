  "issues": [
    {
      "severity": "Medium",
      "item": "F5 - \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628",
      "message": "\u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u0642\u0628\u0648\u0644 \u0641\u064a F5 \u062a\u063a\u0637\u064a \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0641\u0642\u0637\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0634\u0627\u0634\u0629 \u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u0628\u0642\u0648\u0627\u0639\u062f \u063a\u064a\u0631 \u0645\u0648\u062b\u0642\u0629 \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a (\u062b\u0645\u0627\u0646\u064a\u0629 \u0623\u062d\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\u060c \u062a\u0637\u0627\u0628\u0642 \u0643\u0644\u0645\u062a\u064a \u0627\u0644\u0645\u0631\u0648\u0631\u060c \u0635\u064a\u063a\u0629 \u0627\u0644\u0628\u0631\u064a\u062f\u060c \u0648\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0643\u0631\u0631)."
    },
    {
      "severity": "Medium",
      "item": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0647\u0645\u0629",
      "message": "\u064a\u0639\u0631\u0636 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0623\u064a\u0642\u0648\u0646\u0629 \u062a\u0639\u062f\u064a\u0644 \u0641\u064a \u0634\u0631\u064a\u0637 \u0634\u0627\u0634\u0629 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0647\u0645\u0629 \u062f\u0648\u0646 \u0623\u064a \u0645\u064a\u0632\u0629 \u062a\u0639\u062f\u064a\u0644 \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0648\u062f\u0648\u0646 \u0633\u0644\u0648\u0643 \u062a\u0641\u0627\u0639\u0644\u064a \u0645\u062d\u062f\u062f \u0644\u0647\u0627."
    }
  ],
  "required_fixes": [
    "\u0625\u0636\u0627\u0641\u0629 \u0645\u0639\u0627\u064a\u064a\u0631 \u0642\u0628\u0648\u0644 \u0644\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628 \u0641\u064a F5 \u062a\u0634\u0645\u0644 \u0635\u064a\u063a\u0629 \u0627\u0644\u0628\u0631\u064a\u062f \u0648\u0637\u0648\u0644 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0648\u062a\u0637\u0627\u0628\u0642\u0647\u0627 \u0648\u0631\u0641\u0636 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0643\u0631\u0631.",
    "\u062d\u0630\u0641 \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0645\u0646 \u0634\u0627\u0634\u0629 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0647\u0645\u0629 \u0623\u0648 \u0625\u0636\u0627\u0641\u0629 \u0645\u064a\u0632\u0629 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0647\u0645\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0645\u0639 \u062a\u062d\u062f\u064a\u062f \u0633\u0644\u0648\u0643\u0647\u0627."
