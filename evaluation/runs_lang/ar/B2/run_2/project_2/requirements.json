    {
      "id": "F4",
      "name": "\u0639\u0631\u0636 \u0627\u0644\u0645\u0647\u0627\u0645 \u0648\u062a\u0635\u0641\u064a\u062a\u0647\u0627",
      "description": "\u064a\u0639\u0631\u0636 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0647\u0627\u0645 \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u062d\u0633\u0628 \u0627\u0644\u062d\u0627\u0644\u0629: \u0627\u0644\u0643\u0644 \u0623\u0648 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629.",
