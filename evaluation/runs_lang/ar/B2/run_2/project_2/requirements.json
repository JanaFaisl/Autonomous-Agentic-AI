    {
      "id": "F3",
      "name": "\u062d\u0630\u0641 \u0627\u0644\u0645\u0647\u0627\u0645",
      "description": "\u064a\u062a\u064a\u062d \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u062d\u0630\u0641 \u0645\u0647\u0645\u0629 \u0646\u0647\u0627\u0626\u064a\u0627\u064b \u0628\u0639\u062f \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0639\u0645\u0644\u064a\u0629.",
      "priority": "High",
      "user_stories": [
