{
  "project_name": "\u062a\u0637\u0628\u064a\u0642 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0628\u0633\u064a\u0637",
  "features": [
    {
      "id": "F1",
      "name": "\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0647\u0627\u0645",
      "description": "\u064a\u062a\u064a\u062d \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0625\u0636\u0627\u0641\u0629 \u0645\u0647\u0645\u0629 \u062c\u062f\u064a\u062f\u0629 \u0628\u0639\u0646\u0648\u0627\u0646 \u0648\u0648\u0635\u0641 \u0627\u062e\u062a\u064a\u0627\u0631\u064a \u0648\u062a\u0627\u0631\u064a\u062e \u0627\u0633\u062a\u062d\u0642\u0627\u0642 \u0627\u062e\u062a\u064a\u0627\u0631\u064a.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0633\u062a\u062e\u062f\u0645\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u0625\u0646\u0634\u0627\u0621 \u0645\u0647\u0645\u0629 \u062c\u062f\u064a\u062f\u0629 \u0644\u0643\u064a \u0623\u0633\u062c\u0644 \u0645\u0627 \u0623\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0646\u062c\u0627\u0632\u0647.",
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0633\u062a\u062e\u062f\u0645\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u0625\u0636\u0627\u0641\u0629 \u0648\u0635\u0641 \u0648\u062a\u0627\u0631\u064a\u062e \u0627\u0633\u062a\u062d\u0642\u0627\u0642 \u0644\u0644\u0645\u0647\u0645\u0629 \u0644\u0643\u064a \u0623\u0646\u0638\u0645 \u0623\u0648\u0644\u0648\u064a\u0627\u062a\u064a."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0623\u062f\u062e\u0644 \u0639\u0646\u0648\u0627\u0646\u0627\u064b \u0635\u0627\u0644\u062d\u0627\u064b\u060c \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u062d\u0641\u0638\u060c \u062a\u064f\u0636\u0627\u0641 \u0627\u0644\u0645\u0647\u0645\u0629 \u0625\u0644\u0649 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0628\u062d\u0627\u0644\u0629 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u062d\u0642\u0644 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0641\u0627\u0631\u063a\u060c \u0639\u0646\u062f \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u062d\u0641\u0638\u060c \u062a\u0638\u0647\u0631 \u0631\u0633\u0627\u0644\u0629 \u062e\u0637\u0623 \u0648\u0644\u0627 \u062a\u064f\u0646\u0634\u0623 \u0627\u0644\u0645\u0647\u0645\u0629."
      ]
    },
    {
      "id": "F2",
      "name": "\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0645\u0647\u0627\u0645",
      "description": "\u064a\u062a\u064a\u062d \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u0645\u0647\u0645\u0629 \u0643\u0645\u0643\u062a\u0645\u0644\u0629 \u0623\u0648 \u0625\u0639\u0627\u062f\u062a\u0647\u0627 \u0625\u0644\u0649 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629.",
      "priority": "High",
      "user_stories": [
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0633\u062a\u062e\u062f\u0645\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u0645\u0647\u0645\u0629 \u0643\u0645\u0643\u062a\u0645\u0644\u0629 \u0644\u0643\u064a \u0623\u062a\u0627\u0628\u0639 \u062a\u0642\u062f\u0645\u064a \u0641\u064a \u0627\u0644\u0625\u0646\u062c\u0627\u0632.",
        "\u0628\u0635\u0641\u062a\u064a \u0645\u0633\u062a\u062e\u062f\u0645\u0627\u064b\u060c \u0623\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0645\u0647\u0645\u0629 \u0644\u0643\u064a \u0623\u0635\u062d\u062d \u0623\u064a \u062a\u0639\u0644\u064a\u0645 \u062e\u0627\u0637\u0626."
      ],
      "acceptance_criteria": [
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0648\u062c\u0648\u062f \u0645\u0647\u0645\u0629 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629\u060c \u0639\u0646\u062f \u062a\u0639\u0644\u064a\u0645\u0647\u0627 \u0643\u0645\u0643\u062a\u0645\u0644\u0629\u060c \u062a\u062a\u063a\u064a\u0631 \u062d\u0627\u0644\u062a\u0647\u0627 \u0648\u064a\u0638\u0647\u0631 \u0639\u0644\u064a\u0647\u0627 \u0645\u0624\u0634\u0631 \u0627\u0644\u0625\u0643\u0645\u0627\u0644 \u0641\u0648\u0631\u0627\u064b.",
        "\u0628\u0627\u0641\u062a\u0631\u0627\u0636 \u0648\u062c\u0648\u062f \u0645\u0647\u0645\u0629 \u0645\u0643\u062a\u0645\u0644\u0629\u060c \u0639\u0646\u062f \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u060c \u062a\u0639\u0648\u062f \u0627\u0644\u0645\u0647\u0645\u0629 \u0625\u0644\u0649 \u062d\u0627\u0644\u0629 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629."
      ]
