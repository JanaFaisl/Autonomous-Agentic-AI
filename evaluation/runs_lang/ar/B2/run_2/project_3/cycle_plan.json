    "\u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629 \u0642\u062f \u062a\u0633\u0628\u0628 \u062b\u063a\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629\u060c \u0648\u064a\u064f\u0639\u0627\u0644\u062c \u0628\u0636\u0628\u0637 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0648\u0627\u062e\u062a\u0628\u0627\u0631\u0647\u0627 \u0645\u0628\u0643\u0631\u0627\u064b.",
    "\u0636\u064a\u0642 \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0644\u0645\u0637\u0648\u0631 \u0648\u0627\u062d\u062f \u0645\u0639 \u0643\u062b\u0631\u0629 \u0627\u0644\u0634\u0627\u0634\u0627\u062a\u060c \u0648\u064a\u064f\u0639\u0627\u0644\u062c \u0628\u062a\u0623\u062c\u064a\u0644 \u0645\u0647\u0627\u0645 \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0627\u0644\u0645\u0646\u062e\u0641\u0636\u0629 (\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0648\u0644\u0648\u062d\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629) \u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629.",
    "\u062a\u062d\u0642\u064a\u0642 \u0632\u0645\u0646 \u062a\u062d\u0645\u064a\u0644 \u0623\u0642\u0644 \u0645\u0646 \u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0639\u0646\u062f 200 \u0645\u0633\u062a\u062e\u062f\u0645 \u0642\u062f \u064a\u062a\u0637\u0644\u0628 \u0641\u0647\u0631\u0633\u0629 \u0648\u062a\u062e\u0632\u064a\u0646\u0627\u064b \u0645\u0624\u0642\u062a\u0627\u064b \u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u0623\u0648\u0642\u0627\u062a."
  ]
}