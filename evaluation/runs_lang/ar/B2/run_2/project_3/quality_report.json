      "item": "F4 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0648\u0639\u062f \u0645\u0646 \u0627\u0644\u0625\u062f\u0627\u0631\u0629",
      "message": "\u0645\u0639\u064a\u0627\u0631 \u0627\u0644\u0642\u0628\u0648\u0644 \u0641\u064a F4 \u064a\u0641\u062a\u0631\u0636 \u0623\u0646 \u062a\u0639\u062f\u0651\u0644 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0648\u0639\u062f \u0648\u0623\u0646 \u064a\u064f\u0631\u0633\u0644 \u0625\u0634\u0639\u0627\u0631 \u0644\u0644\u0645\u0631\u064a\u0636\u060c \u0644\u0643\u0646 \u0644\u0627 \u062a\u0648\u062c\u062f \u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0634\u0627\u0634\u0629 \u0623\u0648 \u0645\u0643\u0648\u0651\u0646 \u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f."
