      "item": "\u062f\u0648\u0631 \u0645\u0648\u0638\u0641 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644",
      "message": "\u062f\u0648\u0631 \u0645\u0648\u0638\u0641 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0645\u0630\u0643\u0648\u0631 \u0641\u064a \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0648\u0641\u064a \u062d\u0642\u0644 booked_by_user_id\u060c \u0644\u0643\u0646 \u0644\u0627 \u062a\u0648\u062c\u062f \u0644\u0647 \u0645\u064a\u0632\u0629 \u0648\u0644\u0627 \u0634\u0627\u0634\u0629 \u0648\u0644\u0627 \u0645\u062f\u062e\u0644 \u062f\u062e\u0648\u0644 \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645."
