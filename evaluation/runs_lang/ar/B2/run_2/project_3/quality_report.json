    {
      "severity": "Medium",
      "item": "\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 (notifications)",
      "message": "\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u064a\u0639\u0631\u0636 \u0642\u0627\u0626\u0645\u0629 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0639 \u0646\u0642\u0637\u0629 \u0644\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u0642\u0631\u0648\u0621\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u062e\u0644\u0648 \u062c\u062f\u0648\u0644 notifications \u0645\u0646 \u0639\u0645\u0648\u062f \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0645\u062b\u0644 is_read \u0623\u0648 read_at\u060c \u0648\u0642\u064a\u0645 channel \u062a\u0642\u062a\u0635\u0631 \u0639\u0644\u0649 sms \u0648email."
    },
    {
      "severity": "Medium",
      "item": "\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 (doctors)",
      "message": "\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u064a\u0639\u0631\u0636 \u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0637\u0628\u064a\u0628 \u0648\u0633\u0639\u0631 \u0627\u0644\u0643\u0634\u0641 \u0648\u0635\u0648\u0631\u062a\u0647 \u0648\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0641\u0636\u0644\u0629\u060c \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u0641\u064a \u062c\u062f\u0648\u0644\u064a doctors \u0648users \u0639\u0645\u0648\u062f \u0644\u0623\u064a \u0645\u0646\u0647\u0627 \u0648\u0644\u0627 \u062c\u062f\u0648\u0644 \u0644\u0644\u0645\u0641\u0636\u0644\u0629\u060c \u0643\u0645\u0627 \u0644\u0627 \u062a\u063a\u0637\u064a\u0647\u0627 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a."
    },
    {
      "severity": "Medium",
      "item": "\u0645\u0646\u0639 \u062a\u0639\u0627\u0631\u0636 \u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a (doctor_time_slots \u0648appointments)",
      "message": "\u0627\u0644\u0642\u064a\u062f \u0627\u0644\u0641\u0631\u064a\u062f \u0627\u0644\u0645\u0631\u0643\u0651\u0628 \u0639\u0644\u0649 (doctor_id, start_at) \u0648\u0627\u0644\u0641\u0647\u0631\u0633 \u0627\u0644\u0641\u0631\u064a\u062f \u0627\u0644\u062c\u0632\u0626\u064a \u0639\u0644\u0649 appointments(time_slot_id) \u0645\u0630\u0643\u0648\u0631\u0627\u0646 \u0641\u064a \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u0627\u062a \u0641\u0642\u0637\u060c \u0648\u0644\u0645 \u064a\u064f\u0639\u0631\u064e\u0651\u0641\u0627 \u0636\u0645\u0646 indexes\u060c \u0648\u0647\u0630\u0627 \u064a\u0647\u062f\u062f \u0645\u062a\u0637\u0644\u0628 F3 \u0628\u0645\u0646\u0639 \u0627\u0644\u062a\u0639\u0627\u0631\u0636."
    }
