  "assumptions": [
    "\u0643\u0644 \u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0647 \u062f\u0648\u0631 \u0648\u0627\u062d\u062f \u0641\u0642\u0637 \u0639\u0628\u0631 role_id \u0641\u064a \u062c\u062f\u0648\u0644 users\u060c \u0644\u0630\u0644\u0643 \u0644\u0627 \u062d\u0627\u062c\u0629 \u0644\u062c\u062f\u0648\u0644 \u0648\u0633\u064a\u0637 \u0628\u064a\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u0627\u0644\u0623\u062f\u0648\u0627\u0631.",
    "\u0644\u0643\u0644 \u0637\u0628\u064a\u0628 \u062a\u062e\u0635\u0635 \u0631\u0626\u064a\u0633\u064a \u0648\u0627\u062d\u062f (\u0639\u0644\u0627\u0642\u0629 \u0645\u062a\u0639\u062f\u062f \u0644\u0648\u0627\u062d\u062f)\u060c \u0648\u0644\u0627 \u062a\u0648\u062c\u062f \u0639\u0644\u0627\u0642\u0627\u062a \u0645\u062a\u0639\u062f\u062f \u0644\u0645\u062a\u0639\u062f\u062f \u0641\u064a \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a\u060c \u0644\u0630\u0627 \u0644\u0645 \u062a\u064f\u0636\u064e\u0641 \u062c\u062f\u0627\u0648\u0644 \u0648\u0633\u064a\u0637\u0629.",
    "\u062a\u064f\u0648\u0644\u064e\u0651\u062f \u0627\u0644\u0641\u062a\u0631\u0627\u062a \u0627\u0644\u0632\u0645\u0646\u064a\u0629 \u0641\u064a doctor_time_slots \u0645\u0646 \u062c\u062f\u0648\u0644 doctor_work_schedules\u060c \u0648\u064a\u0645\u0646\u0639 \u0627\u0644\u0642\u064a\u062f \u0627\u0644\u0641\u0631\u064a\u062f \u0627\u0644\u0645\u0631\u0643\u0651\u0628 \u0639\u0644\u0649 (doctor_id, start_at) \u062a\u0639\u0627\u0631\u0636 \u0627\u0644\u0623\u0648\u0642\u0627\u062a\u060c \u0648\u062a\u062a\u062d\u0648\u0644 \u062d\u0627\u0644\u0629 \u0627\u0644\u0641\u062a\u0631\u0629 \u0625\u0644\u0649 booked \u0639\u0646\u062f \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062d\u062c\u0632 \u0648\u0625\u0644\u0649 available \u0639\u0646\u062f \u0627\u0644\u0625\u0644\u063a\u0627\u0621.",
    "\u064a\u064f\u0646\u0635\u062d \u0628\u0625\u0646\u0634\u0627\u0621 \u0641\u0647\u0631\u0633 \u0641\u0631\u064a\u062f \u062c\u0632\u0626\u064a \u0639\u0644\u0649 appointments(time_slot_id) \u062d\u064a\u062b status = 'confirmed' \u0644\u0645\u0646\u0639 \u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u0645\u0632\u062f\u0648\u062c \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a.",
    "\u064a\u064f\u062a\u062d\u0642\u0642 \u0645\u0646 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0625\u0644\u063a\u0627\u0621 \u0642\u0628\u0644 24 \u0633\u0627\u0639\u0629 \u0641\u064a \u0637\u0628\u0642\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0645\u0642\u0627\u0631\u0646\u0629 \u0648\u0642\u062a \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u062d\u062c\u0648\u0632\u0629 \u0628\u0627\u0644\u0648\u0642\u062a \u0627\u0644\u062d\u0627\u0644\u064a\u060c \u0648\u0644\u0627 \u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0643\u0639\u0645\u0648\u062f.",
    "\u0639\u0631\u0636 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0644\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0628\u0639\u0629 \u0627\u0644\u0642\u0627\u062f\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u064a\u062a\u0637\u0644\u0628 \u062a\u0648\u0644\u064a\u062f \u0641\u062a\u0631\u0627\u062a \u0632\u0645\u0646\u064a\u0629 \u0645\u0633\u0628\u0642\u0627\u064b \u0644\u0647\u0630\u0647 \u0627\u0644\u0645\u062f\u0629 \u0641\u064a doctor_time_slots.",
    "\u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0641\u064a password_hash \u0628\u062e\u0648\u0627\u0631\u0632\u0645\u064a\u0629 \u062a\u062c\u0632\u0626\u0629 \u0642\u0648\u064a\u0629\u060c \u0648\u0644\u0627 \u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0631\u0645\u0648\u0632 JWT \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a.",
    "\u0641\u064f\u0635\u0644\u062a \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0641\u064a patient_medical_profiles \u0644\u062a\u0642\u064a\u064a\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064a\u0647\u0627 \u0628\u0627\u0644\u0645\u0631\u064a\u0636 \u0648\u0627\u0644\u0637\u0628\u064a\u0628 \u0627\u0644\u0645\u0639\u0627\u0644\u062c \u0648\u0627\u0644\u0645\u062e\u0648\u0651\u0644\u064a\u0646 \u0641\u0642\u0637\u060c \u0648\u064a\u064f\u0633\u062c\u064e\u0651\u0644 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u064a\u0647\u0627 \u0641\u064a audit_logs.",
    "\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0644\u0643\u0644 \u0639\u064a\u0627\u062f\u0629 \u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u062a\u064f\u062d\u0633\u0628 \u0628\u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645 \u0645\u0646 appointments \u0648doctors \u0648specialties\u060c \u062f\u0648\u0646 \u062c\u062f\u0627\u0648\u0644 \u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u062a\u0642\u0627\u0631\u064a\u0631.",
    "\u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0645\u062d\u0635\u0648\u0631\u0629 \u0645\u062b\u0644 status \u0648channel \u0648gender \u0648type \u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0641\u064a \u0623\u0639\u0645\u062f\u0629 varchar \u0648\u064a\u0645\u0643\u0646 \u0641\u0631\u0636\u0647\u0627 \u0628\u0642\u064a\u0648\u062f CHECK \u0623\u0648 \u0623\u0646\u0648\u0627\u0639 enum \u0641\u064a PostgreSQL.",
    "\u0627\u0644\u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0645\u0646 \u0646\u0648\u0639 uuid \u0648\u062a\u064f\u0648\u0644\u064e\u0651\u062f \u0628\u0627\u0644\u062f\u0627\u0644\u0629 gen_random_uuid() \u0641\u064a PostgreSQL\u060c \u0648\u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0628\u0635\u064a\u063a\u0629 timestamp \u0648\u062a\u064f\u0641\u0633\u064e\u0651\u0631 \u0628\u0627\u0644\u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0645\u062d\u0644\u064a \u0644\u0644\u0645\u0633\u062a\u0634\u0641\u0649 \u0623\u0648 UTC \u0648\u0641\u0642 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642.",
    "\u0639\u0645\u0648\u062f appointments.doctor_id \u0645\u0643\u0631\u0631 \u0645\u0639 doctor_time_slots.doctor_id \u0644\u062a\u0633\u0631\u064a\u0639 \u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631\u060c \u0648\u064a\u062c\u0628 \u0623\u0646 \u064a\u062a\u0637\u0627\u0628\u0642 \u0645\u0639 \u0637\u0628\u064a\u0628 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u062d\u062c\u0648\u0632\u0629."
  ]
