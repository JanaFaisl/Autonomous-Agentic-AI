    "\u062a\u0639\u0627\u0631\u0636 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0623\u0648 \u062a\u0643\u0631\u0627\u0631\u0647\u0627 \u0639\u0646\u062f \u0627\u0646\u0642\u0637\u0627\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0648\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629\u060c \u0648\u064a\u064f\u0639\u0627\u0644\u062c \u0628\u0645\u0639\u0631\u0651\u0641 \u0641\u0631\u064a\u062f \u0644\u0643\u0644 \u0639\u0645\u0644\u064a\u0629 \u0648\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0622\u0645\u0646\u0629",
    "\u0636\u064a\u0642 \u0627\u0644\u0648\u0642\u062a \u0644\u0625\u0646\u062c\u0627\u0632 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0641\u064a \u0641\u062a\u0631\u0629 \u0642\u0635\u064a\u0631\u0629\u060c \u0648\u064a\u064f\u0639\u0627\u0644\u062c \u0628\u062a\u0623\u062c\u064a\u0644 \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0625\u0644\u0649 \u0645\u0627 \u0628\u0639\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0627\u0644\u0645\u0633\u062d \u0648\u0627\u0644\u062a\u062a\u0628\u0639 \u0627\u0644\u0641\u0648\u0631\u064a",
    "\u062a\u0639\u0642\u064a\u062f \u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0648\u0628\u0637\u0624\u0647\u0627 \u0645\u0639 \u0643\u062b\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a\u060c \u0648\u064a\u064f\u0639\u0627\u0644\u062c \u0628\u062a\u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0641\u064a \u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0645\u0641\u0647\u0631\u0633\u0629 \u0648\u0627\u0644\u0627\u0643\u062a\u0641\u0627\u0621 \u0628\u062a\u0635\u062f\u064a\u0631 \u0648\u0627\u062d\u062f \u0641\u064a \u0627\u0644\u0628\u062f\u0627\u064a\u0629"
  ]
